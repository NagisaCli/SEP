<UserControl x:Class="SEP.PluginPanel.UI.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:SEP.PluginPanel.Model"
             xmlns:ui="clr-namespace:SEP.PluginPanel.UI"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
             Background="{DynamicResource Page}" Foreground="{DynamicResource Text}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!--
        The docked panel. Colours come from Theme.cs (SEP's semantic tokens: Page, Surface, Surface2, Border, Text,
        Text2, Text3, Accent*, Success/Warning/Danger*, SubtleHover...), merged in by code. Visual trees per card are
        kept small and effect-free: E3D's UI thread paints them. Hover and press feedback are trigger-only.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:InverseBoolToVisibility x:Key="NotBoolToVis" />
        <ui:HexToSoftBrush x:Key="HexToSoftBrush" />
        <ui:CountToVisibility x:Key="CountToVis" />
        <ui:AvatarInk x:Key="AvatarInk" />
        <ui:TileColumns x:Key="TileColumns" />
        <!-- Windows 11 fonts first; Windows 10 falls back to Segoe UI and MDL2 (same code points) -->
        <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- ── text ────────────────────────────────────────────────────────────── -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- counts: tabular figures so they do not jitter as they change -->
        <Style x:Key="Count" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── icon buttons (header, card chrome): quiet until hovered ─────────────── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource SubtleHover}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtlePressed}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource SubtleHover}" Opacity="0" />
                            <Border x:Name="On" CornerRadius="6" Background="{DynamicResource AccentSoft}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── text buttons ────────────────────────────────────────────────────── -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" />
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource SubtleHover}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- an inline accent action ("Add your own command") -->
        <Style x:Key="LinkButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- a quiet neutral action ("More", "Commands"): text until hovered -->
        <Style x:Key="SubtleButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtlePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── command tile (a plug-in's button): glyph and caption inline ─────────── -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
                            <Border CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" Opacity="0" />
                            <ContentPresenter Margin="10,6,8,6" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a row in "More" and in the search results; Tag="selected" is the keyboard selection -->
        <Style x:Key="ActionRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource SubtleHover}" Opacity="0" />
                            <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource AccentSoft}" Opacity="0" />
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="0,9" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Opacity="0" />
                            <ContentPresenter Margin="8,5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtlePressed}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Sel" Property="Opacity" Value="1" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- quick-access chip: pinned ones are filled, recent ones outlined (Background set by the template) -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
                            <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" Opacity="0" />
                            <ContentPresenter Margin="10,0,11,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- keyboard shortcut keycap -->
        <Style x:Key="KeyLabel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NeutralSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        </Style>

        <!-- command glyph in a soft square (search results) -->
        <Style x:Key="ActionIcon" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── search box: magnifier, placeholder, shortcut keycap, clear; Fluent focus underline ── -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Height="36">
                            <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Border x:Name="Focus" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Opacity="0" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Text3}" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search plug-ins and commands" Foreground="{DynamicResource Text3}" VerticalAlignment="Center"
                                           Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                                <Border x:Name="Hint" Grid.Column="2" Style="{StaticResource KeyLabel}" Margin="6,0,10,0" ToolTip="Find a command from anywhere in E3D"
                                        Visibility="{Binding HasPanelShortcut, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PanelShortcut}" Style="{StaticResource KeyText}" />
                                </Border>
                                <Button x:Name="Clear" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,4,0" FontSize="10"
                                        Content="&#xE711;" ToolTip="Clear (Esc)" Click="OnClearSearch" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                <Setter TargetName="Focus" Property="Opacity" Value="1" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter TargetName="Clear" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- inline text field (customize mode) -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid MinHeight="28">
                            <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Border x:Name="Focus" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Opacity="0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,3" VerticalAlignment="Center" Focusable="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- check box: a small rounded square -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource Input}" />
                            <Border x:Name="Fill" CornerRadius="4" Background="{DynamicResource Accent}" Opacity="0" />
                            <TextBlock x:Name="Mark" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource OnAccent}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented choice: Buttons | Status only | Hidden -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="On" CornerRadius="5" Background="{DynamicResource Segment}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Opacity="0" />
                            <ContentPresenter Margin="11,4,11,5" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shortcut recorder button: "+ Shortcut" / "Ctrl+K" / "Press keys…" (the only pulse: while recording) -->
        <Style x:Key="ShortcutButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Border x:Name="Rec" CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" />
                            <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="recording">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Rec" Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.6" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── plug-in state: Running/Ready = success, Enabled = accent, Not loaded = warning, Missing = danger ── -->
        <Style x:Key="StateStripe" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.Ready}">
                    <Setter Property="Background" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.NotLoaded}">
                    <Setter Property="Background" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.Missing}">
                    <Setter Property="Background" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <!-- customize mode lists hidden plug-ins too: no status colour for those -->
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,1,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.Ready}">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.NotLoaded}">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.Missing}">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- calm when fine, coloured when something needs you -->
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.NotLoaded}">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PluginState.Missing}">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── card ────────────────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a plug-in's initials on its own tinted tile (the same tile as on the floating bar) -->
        <Style x:Key="AvatarText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource AvatarInk}">
                        <Binding Path="AvatarColor" />
                        <Binding Path="DataContext.Theme" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- chevron that turns when its card collapses -->
        <Style x:Key="Chevron" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- chevron of "More": points up while the list is open -->
        <Style x:Key="ChevronFlip" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── menus (built in code, see PanelView.NewMenu) ────────────────────── -->
        <Style x:Key="PanelMenu" TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="2,2,12,12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
                            </Border.Effect>
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent" MinHeight="32">
                            <Border x:Name="Hover" CornerRadius="5" Background="{DynamicResource SubtleHover}" Opacity="0" />
                            <Grid Margin="8,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" ContentSource="Icon" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="13"
                                                  TextElement.Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" Margin="10,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Text3}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource Divider}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── templates ───────────────────────────────────────────────────────── -->

        <!-- a plug-in's button: glyph, caption (and its shortcut), a pin when pinned -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type m:PanelAction}">
            <Button Style="{StaticResource ActionTile}" Click="OnRunAction" MouseRightButtonUp="OnActionMenu" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" Width="18" Foreground="{DynamicResource Accent}" />
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Shortcut}" FontSize="10" Foreground="{DynamicResource Text3}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Text3}" Margin="6,0,0,0"
                               ToolTip="Pinned to Quick access" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- a row under "More" -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type m:PanelAction}">
            <Button Style="{StaticResource ActionRow}" Click="OnRunAction" MouseRightButtonUp="OnActionMenu" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Text2}" />
                    <TextBlock Grid.Column="1" Text="{Binding Caption}" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Style="{StaticResource KeyLabel}" Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Shortcut}" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Column="3" Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Text3}" Margin="8,0,2,0"
                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- quick-access chip -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type m:PanelAction}">
            <Button x:Name="ChipButton" Style="{StaticResource Chip}" Click="OnRunAction" MouseRightButtonUp="OnActionMenu" ToolTip="{Binding ToolTipText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChipGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Text2}" />
                    <TextBlock Text="{Binding Caption}" Margin="7,0,0,0" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource KeyLabel}" Margin="8,0,0,0" Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Shortcut}" Style="{StaticResource KeyText}" />
                    </Border>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="False">
                    <Setter TargetName="ChipButton" Property="Background" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- search result (the root must stay a Button: PanelView.MarkSelected tags it) -->
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type m:PanelAction}">
            <Button Style="{StaticResource ActionRow}" Click="OnRunAction" MouseRightButtonUp="OnActionMenu" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionIcon}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Plugin.DisplayName}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource KeyLabel}" Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Shortcut}" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Column="3" Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Text3}" Margin="8,0,2,0"
                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- one plug-in, normal use -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type m:PluginCard}">
            <Border Style="{StaticResource Card}" ui:Motion.Enter="True" MouseRightButtonUp="OnCardMenu">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                <Grid>
                    <Border Style="{StaticResource StateStripe}" />
                    <StackPanel Margin="14,12,10,12">
                        <!-- header: avatar, name, state; menu and collapse -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center" Background="{Binding AvatarColor, Converter={StaticResource HexToSoftBrush}}">
                                <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Background="Transparent" ToolTip="{Binding StateDetail}">
                                    <Ellipse Style="{StaticResource StateDot}" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource StateText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-4,0">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE712;" ToolTip="Commands and options" Click="OnCardMenuButton" />
                                <ToggleButton Style="{StaticResource IconToggle}" Width="28" Height="28" IsChecked="{Binding IsCollapsed}" ToolTip="Collapse or expand">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Chevron}">
                                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsCollapsed, Converter={StaticResource NotBoolToVis}}" ui:Motion.Reveal="True">
                            <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>

                            <!-- what it does: one line over buttons, two on a status-only card -->
                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Text2}"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="WordEllipsis"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <!-- set here, not on the element: a local value would beat the trigger -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="MaxHeight" Value="16" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusOnly}" Value="True">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="MaxHeight" Value="32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- status only: no buttons, its commands one click away -->
                            <Border Visibility="{Binding IsStatusOnly, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="-6,6,0,0" Click="OnCardMenuButton"
                                        Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Commands" />
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="6,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- buttons: equal tiles, as many columns as the width allows. Items.Count and HasItems, not
                                 ButtonActions.Count: the list can be an empty array, which has no Count to bind -->
                            <ItemsControl ItemsSource="{Binding ButtonActions}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,12,-6,-6" Focusable="False">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource TileColumns}">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ToggleButton Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="-6,6,0,0" IsChecked="{Binding ShowMore}"
                                          Visibility="{Binding MoreCount, Converter={StaticResource CountToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="More" />
                                    <Border Margin="6,0,0,0" Padding="5,0,5,1" CornerRadius="7" Background="{DynamicResource NeutralSoft}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MoreCount}" FontSize="10" Foreground="{DynamicResource Text2}" Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource ChevronFlip}" Margin="7,1,0,0">
                                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding MoreActions}" ItemTemplate="{StaticResource RowTemplate}" Margin="-8,2,-4,0" Focusable="False"
                                          Visibility="{Binding ShowMore, Converter={StaticResource BoolToVis}}" ui:Motion.Reveal="True">
                                <ItemsControl.RenderTransform><TranslateTransform /></ItemsControl.RenderTransform>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one command, customize mode -->
        <DataTemplate x:Key="EditRowTemplate" DataType="{x:Type m:PanelAction}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,8,0"
                          IsEnabled="{Binding Plugin.IsButtons}" ToolTip="Show as a button (otherwise under More)" />
                <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Caption}" ToolTip="{Binding ToolTipText}" />
                <Button Grid.Column="2" Margin="6,0,0,0" Click="OnRecordShortcut" MouseRightButtonUp="OnClearShortcut"
                        ToolTip="Click, then press the keys (Ctrl or Alt with a key, or F1–F12; not keys E3D or Windows already use). Backspace removes it, Esc cancels. Right-click removes it.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ShortcutButton}">
                            <Setter Property="Content" Value="{Binding Shortcut}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasShortcut}" Value="False">
                                    <Setter Property="Content" Value="+ Shortcut" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Content" Value="Press keys…" />
                                    <Setter Property="Tag" Value="recording" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ToggleButton Grid.Column="3" Style="{StaticResource IconToggle}" Width="26" Height="28" FontSize="12" Margin="4,0,0,0" IsChecked="{Binding IsPinned}"
                              ToolTip="Pin to Quick access" Content="&#xE718;" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,-4,0">
                    <Button Style="{StaticResource IconButton}" Width="22" Height="28" FontSize="10" Content="&#xE70E;" ToolTip="Move up" Click="OnMoveActionUp" />
                    <Button Style="{StaticResource IconButton}" Width="22" Height="28" FontSize="10" Content="&#xE70D;" ToolTip="Move down" Click="OnMoveActionDown" />
                    <Button Style="{StaticResource IconButton}" Width="26" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="Delete this command" Click="OnDeleteCustom"
                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource FieldBox}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                         Text="{Binding Command}" ToolTip="PML command line"
                         Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- one plug-in, customize mode: the same card frame, so switching modes barely moves anything -->
        <DataTemplate x:Key="EditCardTemplate" DataType="{x:Type m:PluginCard}">
            <Border Style="{StaticResource Card}" ui:Motion.Enter="True">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                <Grid>
                    <Border Style="{StaticResource StateStripe}" />
                    <StackPanel Margin="14,12,10,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- hidden plug-ins: the identity dims, the controls stay full strength -->
                            <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center" Background="{Binding AvatarColor, Converter={StaticResource HexToSoftBrush}}">
                                <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Title" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="HiddenBadge" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                                    <TextBlock Text="&#xED1A;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Text3}" Margin="0,1,5,0" />
                                    <TextBlock Text="Hidden from the panel" FontSize="11" Foreground="{DynamicResource Text3}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-4,0">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70E;" ToolTip="Move plug-in up" Click="OnMovePluginUp" />
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE70D;" ToolTip="Move plug-in down" Click="OnMovePluginDown" />
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE777;" ToolTip="Back to SEP's defaults for this plug-in" Click="OnResetPlugin" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource Track}" CornerRadius="7" Padding="2" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Name}" IsChecked="{Binding IsButtons}" Content="Buttons" ToolTip="Its commands as buttons on the card" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Name}" IsChecked="{Binding IsStatusOnly}" Content="Status only" ToolTip="No buttons: just whether it is running (commands stay in the menu and search)" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Name}" IsChecked="{Binding IsHidden}" Content="Hidden" ToolTip="Not on the panel (still found by search and shortcuts)" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,8" Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Commands" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="Button · Name · Shortcut · Pin" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource EditRowTemplate}" Focusable="False" />

                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,2,0,0" Click="OnStartAdd"
                                Visibility="{Binding IsAdding, Converter={StaticResource NotBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,1,7,0" />
                                <TextBlock Text="Add your own command" />
                            </StackPanel>
                        </Button>
                        <Border Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" ui:Motion.Reveal="True" Margin="0,6,0,0"
                                Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            <!-- the two fields and the Add button share this panel: OnConfirmAdd finds the fields by Tag from the button -->
                            <StackPanel>
                                <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="0,0,0,4" />
                                <TextBox Tag="caption" Style="{StaticResource FieldBox}" />
                                <TextBlock Text="PML command" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="0,10,0,4" />
                                <TextBox Tag="command" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" FontSize="11" ToolTip="For example: show !!myForm   or   $m /D:/macros/run.mac" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Style="{StaticResource TextButton}" Content="Cancel" Click="OnCancelAdd" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Add" Click="OnConfirmAdd" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="Avatar" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Text3}" />
                    <Setter TargetName="HiddenBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header: app tile, title and summary; reload, customize, more -->
        <Grid Margin="12,14,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" VerticalAlignment="Center">
                <Border CornerRadius="9" Background="{DynamicResource BrandGradient}" />
                <!-- a faint top sheen gives the tile some depth without an effect -->
                <Border CornerRadius="9,9,0,0" Height="16" VerticalAlignment="Top" Opacity="0.18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="&#xEA86;" Style="{StaticResource Glyph}" FontSize="16" Foreground="White" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                <TextBlock Text="Plug-ins" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Ellipse Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center" Visibility="{Binding Cards.Count, Converter={StaticResource CountToVis}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Count}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload the list and check status" Click="OnReload" />
                <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE70F;" ToolTip="Customize: buttons, names, shortcuts, order" IsChecked="{Binding IsCustomizing}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More" Click="OnPanelMenu" />
            </StackPanel>
        </Grid>

        <!-- search; customize mode puts its own strip in the same place, so the list below does not jump -->
        <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="12,12,12,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKey"
                 Visibility="{Binding IsNormal, Converter={StaticResource BoolToVis}}" />
        <Border Grid.Row="1" Margin="12,12,12,0" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Accent}" />
                <TextBlock Grid.Column="1" Text="Customizing the panel" FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Done" Height="26" Padding="14,0" Click="OnDone" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
            <ScrollViewer.Resources>
                <!-- slim scroll bar: a thin rounded thumb that thickens under the pointer -->
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="MinWidth" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <!-- the whole column takes the drag, not just the visible 4 px -->
                                                        <Grid Background="Transparent">
                                                            <Border x:Name="T" Width="4" CornerRadius="2" Background="{DynamicResource BorderStrong}" HorizontalAlignment="Center" Margin="0,4" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="T" Property="Width" Value="6" />
                                                                <Setter TargetName="T" Property="CornerRadius" Value="3" />
                                                                <Setter TargetName="T" Property="Background" Value="{DynamicResource Text3}" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="T" Property="Width" Value="6" />
                                                                <Setter TargetName="T" Property="CornerRadius" Value="3" />
                                                                <Setter TargetName="T" Property="Background" Value="{DynamicResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel Margin="12,14,12,16">

                <!-- empty and error states: a glyph tile, what happened, what to do -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" ui:Motion.Enter="True" Margin="12,28,12,0" MaxWidth="300" HorizontalAlignment="Center">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmptyTitle}" Value="The plug-in list could not be read">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Text" Value="&#xEA86;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmptyTitle}" Value="The plug-in list could not be read">
                                            <Setter Property="Text" Value="&#xE783;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,6,0,16" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="17" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnOpenSep" Padding="14,0" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,8,0" />
                            <TextBlock Text="Open SEP" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- customize intro: what this mode does, and the one panel-wide setting -->
                <Border Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}" ui:Motion.Reveal="True" Margin="0,0,0,12"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Pick what each plug-in shows, rename its buttons, give them shortcuts. Saved as you go." Style="{StaticResource Muted}" LineHeight="17" />
                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Text2}" />
                            <TextBlock Grid.Column="1" Text="Shortcut to open this panel and search" VerticalAlignment="Center" Margin="10,0,8,0" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Click="OnRecordPanelShortcut" MouseRightButtonUp="OnClearPanelShortcut"
                                    ToolTip="Click, then press the keys. Backspace removes it, Esc cancels.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ShortcutButton}">
                                        <Setter Property="Content" Value="{Binding PanelShortcut}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPanelShortcut}" Value="False">
                                                <Setter Property="Content" Value="+ Shortcut" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRecordingPanel}" Value="True">
                                                <Setter Property="Content" Value="Press keys…" />
                                                <Setter Property="Tag" Value="recording" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- quick access -->
                <StackPanel Visibility="{Binding ShowQuickAccess, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                    <StackPanel Visibility="{Binding HasPinned, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                            <TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Text3}" Margin="0,1,6,0" />
                            <TextBlock Text="Pinned" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Pinned}" ItemTemplate="{StaticResource ChipTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource Text3}" Margin="0,1,6,0" />
                            <TextBlock Text="Recent" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource ChipTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
                        <TextBlock Text="Plug-ins" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Items.Count, ElementName=CardList}" Style="{StaticResource Count}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- search results -->
                <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6" Visibility="{Binding HasNoResults, Converter={StaticResource NotBoolToVis}}">
                        <TextBlock Text="Commands" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Items.Count, ElementName=Results}" Style="{StaticResource Count}" Margin="6,0,0,0" />
                        <TextBlock Text="↑↓ to choose, Enter to run" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                    </StackPanel>
                    <ItemsControl x:Name="Results" ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource ResultTemplate}" Margin="-4,0,-4,0" Focusable="False" />
                    <StackPanel Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" Margin="0,28,0,0" HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource NeutralSoft}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource Text3}" />
                        </Border>
                        <TextBlock Text="No command matches" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Try part of a command or a plug-in name" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- plug-ins -->
                <ItemsControl x:Name="CardList" ItemsSource="{Binding ShownCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsCustomizing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ShownCards}" ItemTemplate="{StaticResource EditCardTemplate}" Focusable="False"
                              Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- toast -->
        <Border x:Name="ToastHost" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="14,0,14,14" MaxWidth="360"
                Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource ToastBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastSlide" Y="12" /></Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,9,0" VerticalAlignment="Top" Padding="0,2,0,0" Foreground="{DynamicResource ToastOk}" />
                <TextBlock x:Name="ToastText" Grid.Column="1" Foreground="{DynamicResource ToastText}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="17" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
