<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        Title="{loc:Tr Create_Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Background="{DynamicResource SepPageBrush}" Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Create_Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SepAccentSoftBrush}" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="FolderAdd24" Foreground="{DynamicResource SepAccentBrush}" FontSize="18" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Create_Header}" Style="{StaticResource SepSectionTitle}" />
                    <TextBlock Text="{loc:Tr Create_Hint}" Style="{StaticResource SepCaption}" TextWrapping="Wrap" MaxWidth="440" />
                </StackPanel>
            </StackPanel>

            <!-- error -->
            <Border Background="{DynamicResource SepDangerSoftBrush}" BorderBrush="{DynamicResource SepDangerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SepDangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Create_CodeLabel}" Style="{StaticResource SepLabel}" />
                    <ui:TextBox x:Name="CodeField" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontFamily="{StaticResource SepMonoFont}" FontWeight="Bold"
                                HorizontalContentAlignment="Center" PlaceholderText="{loc:Tr Create_CodePlaceholder}" FontSize="15" CharacterCasing="Upper" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Tr Create_NameLabel}" Style="{StaticResource SepLabel}" />
                    <ui:TextBox x:Name="NameField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Create_NamePlaceholder}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Tr Create_RootDirLabel}" Style="{StaticResource SepLabel}" Margin="0,12,0,6" />
            <ui:TextBox x:Name="RootDirField" Text="{Binding RootDir, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource SepMonoFont}" Icon="{ui:SymbolIcon Symbol=Folder24}" />

            <CheckBox x:Name="CloneBox" Content="{loc:Tr Create_CloneCheckbox}" IsChecked="{Binding IsCloneMode}" Margin="0,12,0,0" />
            <ComboBox x:Name="TemplateBox" ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedTemplate}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Appearance="Secondary" Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" Margin="0,0,10,0" MinWidth="90" />
                <ui:Button x:Name="CreateButton" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="{loc:Tr Create_Button}" Click="OnCreateClick" MinWidth="120" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
