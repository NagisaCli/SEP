<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.CategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sepsvc="clr-namespace:SEP.App.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        xmlns:local="clr-namespace:SEP.App.Views.Dialogs"
        Title="{loc:Tr Category_Manage}"
        Width="560" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="{x:Static sepsvc:ThemeService.Backdrop}"
        FontFamily="{StaticResource SepTextFont}"
        Background="{DynamicResource SepSheetBrush}" Foreground="{DynamicResource SepTextBrush}">

    <ui:FluentWindow.Resources>
        <!-- grouped list on the sheet: a rounded container, rows with inset hairlines -->
        <Style x:Key="SheetGroup" TargetType="Border" BasedOn="{StaticResource SepGroup}">
            <Setter Property="Background" Value="{DynamicResource SepSheetGroupBrush}" />
        </Style>
        <!-- the name of a category reads as text in its row and becomes a field on hover / focus -->
        <Style x:Key="InlineNameBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Apple sheet: opaque sheet colour (whatever the backdrop), centred header, the add row and the list as grouped
         lists, the status line and Close at the bottom. -->
    <Grid Background="{DynamicResource SepSheetBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" />

        <!-- header -->
        <StackPanel Grid.Row="1" Margin="28,0,28,20">
            <controls:IconTile Size="Large" Symbol="Tag20" Tone="Accent" HorizontalAlignment="Center" Margin="0,0,0,14" />
            <TextBlock Text="{loc:Tr Category_Manage}" Style="{StaticResource SepSheetTitle}" />
            <TextBlock Text="{loc:Tr Category_Subtitle}" Style="{StaticResource SepSheetSubtitle}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- add: a one-row group with the name field and the button -->
        <Border Grid.Row="2" Style="{StaticResource SheetGroup}" Margin="24,0,24,16">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="NewName" PlaceholderText="{loc:Tr Category_NewPlaceholder}" MaxLength="30" KeyDown="OnNewNameKeyDown" Icon="{ui:SymbolIcon Symbol=Tag20}"
                            VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Style="{StaticResource SepCapsuleButton}" Icon="{ui:SymbolIcon Symbol=Add20}" Content="{loc:Tr Category_Add}" Margin="8,0,0,0" Padding="16,7"
                           MinHeight="32" VerticalAlignment="Center" Click="OnAdd" />
            </Grid>
        </Border>

        <!-- the categories: swatch (click cycles the colour), name (edit in place), usage, delete -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,0,24,16">
                <!-- hidden while empty, or its hairline rim would show as a sliver -->
                <Border Style="{StaticResource SheetGroup}" Visibility="{Binding Items.Count, ElementName=List, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <ItemsControl x:Name="List" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="52" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CategoryRow}">
                                <Grid Margin="8,6,10,6" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Appearance="Transparent" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="17" Click="OnCycleColor" Tag="{Binding}"
                                               VerticalAlignment="Center" ToolTip="{loc:Tr Category_ColorTooltip}" AutomationProperties.Name="{loc:Tr Category_ColorTooltip}">
                                        <Ellipse Width="18" Height="18" Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}" Stroke="{DynamicResource SepBorderBrush}" StrokeThickness="1" />
                                    </ui:Button>
                                    <ui:TextBox Grid.Column="1" Style="{StaticResource InlineNameBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,8,0" MaxLength="30"
                                                LostFocus="OnNameLostFocus" Tag="{Binding}" />
                                    <TextBlock Grid.Column="2" Text="{Binding UsageText}" Style="{StaticResource SepNumber}" Foreground="{DynamicResource SepText3Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ui:Button Grid.Column="3" Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr Category_Delete}"
                                               AutomationProperties.Name="{loc:Tr Category_Delete}" Click="OnDelete" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <!-- nothing filed yet -->
                <TextBlock Text="{loc:Tr Category_Empty}" Style="{StaticResource SepGroupFooter}" HorizontalAlignment="Center" TextAlignment="Center" Margin="14,4,14,0"
                           Visibility="{Binding Items.Count, ElementName=List, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- status line left, Close right -->
        <Grid Grid.Row="4" Margin="24,4,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Style="{StaticResource SepStatusText}" Margin="2,0,12,0" />
            <ui:Button Grid.Column="1" Content="{loc:Tr Common_Close}" Style="{StaticResource SepCapsuleSecondaryButton}" Click="OnClose" MinWidth="96" IsCancel="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
