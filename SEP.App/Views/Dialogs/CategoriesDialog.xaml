<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.CategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sepsvc="clr-namespace:SEP.App.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        xmlns:local="clr-namespace:SEP.App.Views.Dialogs"
        Title="{loc:Tr Category_Manage}"
        Width="560" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="{x:Static sepsvc:ThemeService.Backdrop}"
        FontFamily="{StaticResource SepTextFont}"
        Background="{DynamicResource SepPageBrush}" Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" />

        <!-- dialog header -->
        <Grid Grid.Row="1" Margin="24,0,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:IconTile Symbol="Tag20" Tone="Accent" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Category_Manage}" Style="{StaticResource SepTitle}" FontSize="18" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Tr Category_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- add -->
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="NewName" PlaceholderText="{loc:Tr Category_NewPlaceholder}" MaxLength="30" KeyDown="OnNewNameKeyDown" Icon="{ui:SymbolIcon Symbol=Tag20}" />
            <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Content="{loc:Tr Category_Add}" Margin="8,0,0,0" Click="OnAdd" />
        </Grid>

        <!-- list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" Margin="24,0,24,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CategoryRow}">
                        <Border Style="{StaticResource SepRow}" Padding="8,6,8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- colour swatch: click cycles through the palette -->
                                <ui:Button Appearance="Transparent" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" Click="OnCycleColor" Tag="{Binding}"
                                           ToolTip="{loc:Tr Category_ColorTooltip}" AutomationProperties.Name="{loc:Tr Category_ColorTooltip}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Color}" BorderBrush="{DynamicResource SepBorderStrongBrush}" BorderThickness="1" />
                                </ui:Button>
                                <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" MaxLength="30" LostFocus="OnNameLostFocus" Tag="{Binding}" />
                                <TextBlock Grid.Column="2" Text="{Binding UsageText}" Style="{StaticResource SepNumber}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="3" Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr Category_Delete}"
                                           AutomationProperties.Name="{loc:Tr Category_Delete}" Click="OnDelete" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="4" Background="{DynamicResource SepSurfaceBrush}" BorderBrush="{DynamicResource SepDividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Style="{StaticResource SepStatusText}" Margin="0,0,12,0" />
                <ui:Button Grid.Column="1" Content="{loc:Tr Common_Close}" Appearance="Secondary" Click="OnClose" MinWidth="96" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
