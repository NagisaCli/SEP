<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.DecommissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sepsvc="clr-namespace:SEP.App.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        Title="{loc:Tr Decommission_Title}"
        Width="560" SizeToContent="Height" MaxHeight="{x:Static SystemParameters.FullPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="{x:Static sepsvc:ThemeService.Backdrop}"
        FontFamily="{StaticResource SepTextFont}"
        Background="{DynamicResource SepSheetBrush}" Foreground="{DynamicResource SepTextBrush}">

    <ui:FluentWindow.Resources>
        <!-- grouped form on the sheet: a rounded container per group, 48 px rows, hairlines inset to the text -->
        <Style x:Key="SheetGroup" TargetType="Border" BasedOn="{StaticResource SepGroup}">
            <Setter Property="Background" Value="{DynamicResource SepSheetGroupBrush}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SheetRow" TargetType="Grid">
            <Setter Property="Margin" Value="16,8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="SheetRowLabel" TargetType="TextBlock" BasedOn="{StaticResource SepBody}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Apple sheet: opaque sheet colour (whatever the backdrop), centred header, grouped form, buttons bottom-right.
         The form scrolls when the screen is too short for it; header and buttons stay put. -->
    <Grid Background="{DynamicResource SepSheetBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" />

        <!-- header: a warning tile, this takes a project out of service -->
        <StackPanel Grid.Row="1" Margin="28,0,28,20">
            <controls:IconTile Size="Large" Symbol="ArchiveArrowBack20" Tone="Warning" HorizontalAlignment="Center" Margin="0,0,0,14" />
            <TextBlock Text="{loc:Tr Decommission_Header}" Style="{StaticResource SepSheetTitle}" />
            <TextBlock Text="{loc:Tr Decommission_Hint}" Style="{StaticResource SepSheetSubtitle}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,0,24,0">
                <!-- error: a soft danger row (shown by code) -->
                <Border x:Name="ErrorBorder" Background="{DynamicResource SepDangerSoftBrush}" CornerRadius="12" Padding="12,9" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ErrorCircle16" Filled="True" FontSize="15" Foreground="{DynamicResource SepDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="{DynamicResource SepDangerBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- the project: glossy monogram (its colour is set in code), name and folder -->
                <Border Style="{StaticResource SheetGroup}">
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Avatar" Style="{StaticResource SepAvatar}" Width="44" Height="44" CornerRadius="12">
                            <Grid>
                                <Border Style="{StaticResource SepAvatarGloss}" />
                                <TextBlock x:Name="TxtCode" Style="{StaticResource SepAvatarText}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtName" Style="{StaticResource SepBodyStrong}" FontSize="15" />
                            <TextBlock x:Name="TxtPath" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepText2Brush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- what happens: archive (optional), unregister (always), delete (optional, in a danger tint) -->
                <Border Style="{StaticResource SheetGroup}">
                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStackPlain}">
                        <Grid Style="{StaticResource SheetRow}">
                            <CheckBox x:Name="ChkArchive" Content="{loc:Tr Decommission_ArchiveCheckbox}" IsChecked="True" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource SheetRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="19" Foreground="{DynamicResource SepSuccessBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{loc:Tr Decommission_UnregisterCheckbox}" Style="{StaticResource SheetRowLabel}" />
                        </Grid>
                        <Border Background="{DynamicResource SepDangerSoftBrush}">
                            <Grid Style="{StaticResource SheetRow}">
                                <CheckBox x:Name="ChkDelete" Content="{loc:Tr Decommission_DeleteCheckbox}" IsChecked="False" Foreground="{DynamicResource SepDangerBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </controls:SeparatedStackPanel>
                </Border>

                <!-- where the archive goes -->
                <Border Style="{StaticResource SheetGroup}">
                    <Grid Style="{StaticResource SheetRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr Decommission_ArchiveDirRow}" Style="{StaticResource SheetRowLabel}" />
                        <ui:TextBox x:Name="TxtArchiveDir" Grid.Column="1" FontFamily="{StaticResource SepMonoFont}" Icon="{ui:SymbolIcon Symbol=Folder20}" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Click="OnBrowseClick" Margin="8,0,0,0" VerticalAlignment="Center"
                                   ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- buttons bottom-right, the destructive one last in danger styling -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,4,24,22">
            <ui:Button Style="{StaticResource SepCapsuleSecondaryButton}" Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="96" IsCancel="True" />
            <ui:Button x:Name="ConfirmButton" Style="{StaticResource SepCapsuleButton}" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=ArchiveArrowBack20}" Content="{loc:Tr Decommission_Button}"
                       Click="OnConfirmDecommissionClick" MinWidth="120" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
