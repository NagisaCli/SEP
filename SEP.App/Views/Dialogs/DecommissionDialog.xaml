<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.DecommissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sepsvc="clr-namespace:SEP.App.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        Title="{loc:Tr Decommission_Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="{x:Static sepsvc:ThemeService.Backdrop}"
        FontFamily="{StaticResource SepTextFont}"
        Background="{DynamicResource SepPageBrush}" Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,20">
            <!-- dialog header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconTile Symbol="ArchiveArrowBack20" Tone="Warning" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Decommission_Header}" Style="{StaticResource SepTitle}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Tr Decommission_Hint}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- error -->
            <Border x:Name="ErrorBorder" Background="{DynamicResource SepDangerSoftBrush}" CornerRadius="{StaticResource SepRadiusS}" Padding="10,7" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle16" FontSize="14" Foreground="{DynamicResource SepDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SepDangerBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </Border>

            <!-- the project -->
            <Border Style="{StaticResource SepCard}" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Avatar" Style="{StaticResource SepAvatar}" Width="40" Height="40">
                        <TextBlock x:Name="TxtCode" Style="{StaticResource SepAvatarText}" FontSize="12" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtName" Style="{StaticResource SepBodyStrong}" FontSize="14" />
                        <TextBlock x:Name="TxtPath" Style="{StaticResource SepMono}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- what happens -->
            <StackPanel Margin="0,0,0,16">
                <CheckBox x:Name="ChkArchive" Content="{loc:Tr Decommission_ArchiveCheckbox}" IsChecked="True" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="18" Foreground="{DynamicResource SepSuccessBrush}" Margin="1,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Decommission_UnregisterCheckbox}" Style="{StaticResource SepBody}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- the destructive option sits in a danger tint -->
                <Border Background="{DynamicResource SepDangerSoftBrush}" CornerRadius="{StaticResource SepRadiusS}" Padding="10,8">
                    <CheckBox x:Name="ChkDelete" Content="{loc:Tr Decommission_DeleteCheckbox}" IsChecked="False" Foreground="{DynamicResource SepDangerBrush}" />
                </Border>
            </StackPanel>

            <TextBlock Text="{loc:Tr Decommission_ArchiveDirLabel}" Style="{StaticResource SepLabel}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtArchiveDir" FontFamily="{StaticResource SepMonoFont}" Icon="{ui:SymbolIcon Symbol=Folder20}" />
                <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Click="OnBrowseClick" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
            </Grid>
        </StackPanel>

        <!-- footer: the destructive action in danger styling -->
        <Border Grid.Row="2" Background="{DynamicResource SepSurfaceBrush}" BorderBrush="{DynamicResource SepDividerBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary" Content="{loc:Tr Common_Cancel}" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="96" IsCancel="True" />
                <ui:Button x:Name="ConfirmButton" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=ArchiveArrowBack20}" Content="{loc:Tr Decommission_Button}" Click="OnConfirmDecommissionClick" MinWidth="120" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
