<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.NewUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Background="{DynamicResource SepPageBrush}" Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <TextBlock Text="{loc:Tr Users_NewIntro}" Style="{StaticResource SepPageSubtitle}" Margin="0,0,0,16" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Tr Users_NewNameLabel}" Style="{StaticResource SepLabel}" />
                    <ui:TextBox x:Name="NameField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Users_NewNamePlaceholder}"
                                CharacterCasing="Upper" MaxLength="32" FontFamily="{StaticResource SepMonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Tr Users_NewSecurityLabel}" Style="{StaticResource SepLabel}" />
                    <Border Style="{StaticResource SepWell}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GeneralRadio" Content="{loc:Tr Users_SecurityGeneral}" IsChecked="{Binding IsGeneral}" Margin="4,0,12,0" />
                            <RadioButton x:Name="FreeRadio" Content="{loc:Tr Users_SecurityFree}" IsChecked="{Binding IsFree}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SecurityHint}" Style="{StaticResource SepCaption}" TextWrapping="Wrap" Margin="0,-6,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Tr Users_NewPasswordLabel}" Style="{StaticResource SepLabel}" />
                    <ui:PasswordBox x:Name="PasswordField" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="True" MaxLength="32" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Tr Users_PasswordRepeatLabel}" Style="{StaticResource SepLabel}" />
                    <ui:PasswordBox x:Name="PasswordRepeatField" Password="{Binding PasswordRepeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="True" MaxLength="32" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Tr Users_NewTeamLabel}" Style="{StaticResource SepLabel}" />
            <ComboBox x:Name="TeamBox" ItemsSource="{Binding TeamChoices}" SelectedItem="{Binding Team}" HorizontalAlignment="Stretch" Margin="0,0,0,12" IsEditable="True" Text="{Binding TeamText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{loc:Tr Users_NewDescLabel}" Style="{StaticResource SepLabel}" />
            <ui:TextBox x:Name="DescriptionField" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Users_NewDescPlaceholder}" MaxLength="120" />

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SepDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="{loc:Tr Common_Cancel}" Appearance="Secondary" Click="OnCancel" MinWidth="90" Margin="0,0,10,0" IsCancel="True" />
                <ui:Button Content="{loc:Tr Users_CreateButton}" Appearance="Primary" Click="OnOk" MinWidth="130" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
