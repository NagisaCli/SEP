<ui:FluentWindow x:Class="SEP.App.Views.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        Title="{Binding Request.Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Background="{DynamicResource SepPageBrush}" Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Request.Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <TextBlock Text="{Binding Request.Message}" Style="{StaticResource SepPageSubtitle}" Margin="0,0,0,14"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- choice -->
            <StackPanel Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                <TextBlock Text="{Binding Request.ChoiceLabel}" Style="{StaticResource SepLabel}" />
                <ComboBox x:Name="ChoiceBox" ItemsSource="{Binding Request.Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- text -->
            <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                <TextBlock Text="{Binding Request.TextLabel}" Style="{StaticResource SepLabel}" />
                <ui:TextBox x:Name="TextField" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Request.TextPlaceholder}"
                            MaxLength="{Binding Request.TextMaxLength}" CharacterCasing="{Binding Casing}" />
            </StackPanel>

            <!-- password + confirmation -->
            <StackPanel Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,4">
                <TextBlock Text="{Binding Request.PasswordLabel}" Style="{StaticResource SepLabel}" />
                <ui:PasswordBox x:Name="PasswordField" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="True" MaxLength="32" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Tr Users_PasswordRepeatLabel}" Style="{StaticResource SepLabel}" />
                <ui:PasswordBox x:Name="PasswordRepeatField" Password="{Binding PasswordRepeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="True" MaxLength="32" />
                <TextBlock Text="{loc:Tr Users_PasswordRules}" Style="{StaticResource SepCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SepDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="{loc:Tr Common_Cancel}" Appearance="Secondary" Click="OnCancel" MinWidth="90" Margin="0,0,10,0" IsCancel="True" />
                <ui:Button x:Name="OkButton" Content="{Binding Request.OkLabel}" Appearance="{Binding OkAppearance}" Click="OnOk" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
