<Page x:Class="SEP.App.Views.Pages.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Projects}"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, spinner, filter tabs, search, actions -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Nav_Projects}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center" />
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border Background="#161B22" CornerRadius="6" Padding="3" BorderBrush="#253040" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:Tr Projects_FilterAll}" Click="OnFilterAllClick" Margin="2,0" Padding="12,5"
                                   Appearance="{Binding FilterTab, Converter={StaticResource SelectedToAppearanceConverter}, ConverterParameter=All}" />
                        <ui:Button Content="{loc:Tr Projects_FilterMine}" Click="OnFilterMineClick" Margin="2,0" Padding="12,5"
                                   Appearance="{Binding FilterTab, Converter={StaticResource SelectedToAppearanceConverter}, ConverterParameter=Mine}" />
                        <ui:Button Content="{loc:Tr Projects_FilterLocal}" Click="OnFilterLocalClick" Margin="2,0" Padding="12,5"
                                   Appearance="{Binding FilterTab, Converter={StaticResource SelectedToAppearanceConverter}, ConverterParameter=Local}" />
                        <ui:Button Content="{loc:Tr Projects_FilterUnc}" Click="OnFilterUncClick" Margin="2,0" Padding="12,5"
                                   Appearance="{Binding FilterTab, Converter={StaticResource SelectedToAppearanceConverter}, ConverterParameter=Unc}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:TextBox Width="150" PlaceholderText="{loc:Tr Projects_SearchPlaceholder}" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}" Margin="0,0,10,0" />
                <ui:Button Appearance="Primary" Content="{loc:Tr Projects_CreateButton}" Click="OnCreateProjectClick" Margin="0,0,10,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Command="{Binding RescanAllCommand}" ToolTip="{loc:Tr Projects_RefreshTooltip}" />
            </StackPanel>
        </Grid>

        <!-- Add library -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="{loc:Tr Lib_AddPlaceholder}" Text="{Binding NewLibraryPath, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Symbol=FolderAdd24}" FontFamily="Cascadia Code, Consolas" />
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="{loc:Tr Lib_AddButton}" Command="{Binding AddLibraryCommand}" Margin="10,0,0,0" />
        </Grid>

        <!-- Notification banner -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#00E5FF" BorderThickness="1,0,0,0" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding NotificationText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding NotificationText}" Foreground="#00E5FF" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding NotificationText}" />
        </Border>

        <!-- Libraries with their projects -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel>
                <TextBlock Text="{loc:Tr Lib_Empty}" Foreground="#8B949E" FontSize="13" Margin="4,12" TextWrapping="Wrap"
                           Visibility="{Binding HasLibraries, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryGroup}">
                            <Border Margin="0,0,0,14" Background="#11161D" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <!-- Library header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Appearance="Transparent" Padding="4,2" Margin="0,0,6,0"
                                                   Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <!-- chevron turns instead of swapping glyphs -->
                                                <ui:SymbolIcon Symbol="ChevronDown20" RenderTransformOrigin="0.5,0.5">
                                                    <ui:SymbolIcon.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                    </ui:SymbolIcon.RenderTransform>
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Library.IsExpanded}" Value="False">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="0:0:0.18">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button.Icon>
                                        </ui:Button>

                                        <TextBlock Grid.Column="1" Text="{Binding Library.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <!-- Library type / Local / Network tag -->
                                        <Border Grid.Column="2" Background="#1F2937" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock FontSize="11" Foreground="#93C5FD">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SwitchConverter}">
                                                        <Binding Path="Library.IsCollection" />
                                                        <Binding Path="[Lib_TypeCollection]" Source="{x:Static loc:Loc.Instance}" />
                                                        <Binding Path="[Lib_TypeProject]" Source="{x:Static loc:Loc.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Library.Path}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis" ToolTip="{Binding Library.Path}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Library.IsReachable}" Value="False">
                                                                <Setter Property="Foreground" Value="#FBBF24" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Library.IsScanning}" Value="True">
                                                                <Setter Property="Foreground" Value="#00E5FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <ui:Button Appearance="Secondary" Content="{loc:Tr Lib_LoadWhole}" Padding="10,4" Margin="0,0,6,0"
                                                       Visibility="{Binding Library.IsCollection, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Command="{Binding DataContext.LoadLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" Padding="8,4" Margin="0,0,6,0" ToolTip="{loc:Tr Lib_Rescan}"
                                                       Command="{Binding DataContext.RescanLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Padding="8,4" Margin="0,0,6,0" ToolTip="{loc:Tr Lib_OpenFolder}"
                                                       Command="{Binding DataContext.OpenLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Dismiss20}" Padding="8,4" ToolTip="{loc:Tr Lib_Remove}"
                                                       Command="{Binding DataContext.RemoveLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Project cards (fade + slide in when the group expands) -->
                                    <ItemsControl ItemsSource="{Binding Projects}" Visibility="{Binding Library.IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.RenderTransform>
                                            <TranslateTransform x:Name="GroupSlide" Y="0" />
                                        </ItemsControl.RenderTransform>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Library.IsExpanded}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="0" Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ProjectItem}">
                                                <Border Width="330" Margin="0,0,12,12" Background="#161B22" BorderThickness="1" CornerRadius="8" Padding="14"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush x:Name="CardBorderBrush" Color="#253040" />
                                                    </Border.BorderBrush>
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                                            <TranslateTransform x:Name="CardSlide" Y="0" />
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <!-- appear: fade + rise -->
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <!-- hover: lift a little and light the border -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12" />
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12" />
                                                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#00A8BC" Duration="0:0:0.12" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#253040" Duration="0:0:0.15" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Header: code badge, title, star -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Background="#0D1117" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Badge}" FontFamily="Cascadia Code, Consolas" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                                <TextBlock Text="{Binding ProjectDir}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="#8B949E" TextTrimming="CharacterEllipsis" ToolTip="{Binding BatPath}" />
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.ToolTip>
                                                                    <MultiBinding Converter="{StaticResource SwitchConverter}">
                                                                        <Binding Path="IsFavorite" />
                                                                        <Binding Path="[Project_RemoveFromMine]" Source="{x:Static loc:Loc.Instance}" />
                                                                        <Binding Path="[Project_AddToMine]" Source="{x:Static loc:Loc.Instance}" />
                                                                    </MultiBinding>
                                                                </Button.ToolTip>
                                                                <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}" FontSize="16" Foreground="#F59E0B" />
                                                            </Button>
                                                        </Grid>

                                                        <!-- Status pills -->
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                    Background="{Binding IsLocked, Converter={StaticResource LockToBackgroundConverter}}"
                                                                    Visibility="{Binding LockStateKnown, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="{Binding IsLocked, Converter={StaticResource LockToForegroundConverter}}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource SwitchConverter}">
                                                                            <Binding Path="IsLocked" />
                                                                            <Binding Path="[Project_LockActive]" Source="{x:Static loc:Loc.Instance}" />
                                                                            <Binding Path="[Project_LockFree]" Source="{x:Static loc:Loc.Instance}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Background="#3F3F46"
                                                                    Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{loc:Tr Project_Cached}" FontSize="11" Foreground="#D4D4D8" />
                                                            </Border>
                                                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{loc:Tr Projects_ActiveBadge}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Actions -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:Button Grid.Column="0" Appearance="Primary" Content="{loc:Tr Projects_SwitchAndLaunch}" HorizontalAlignment="Stretch"
                                                                       Command="{Binding DataContext.SetActiveAndLaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Margin="6,0,0,0" ToolTip="{loc:Tr Projects_OpenFolderTooltip}"
                                                                       Command="{Binding DataContext.OpenProjectFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" Margin="6,0,0,0"
                                                                       Click="OnProjectMoreClick" Tag="{Binding}" ToolTip="{loc:Tr Projects_MoreTooltip}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
