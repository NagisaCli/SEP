<Page x:Class="SEP.App.Views.Pages.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:SEP.App.Models"
      Title="工程工作台"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="工程工作台" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
                
                <!-- Filter Tabs -->
                <Border Background="#161B22" CornerRadius="6" Padding="3" BorderBrush="#253040" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="全部工程" Appearance="Secondary" Click="OnFilterAllClick" Margin="2,0" Padding="12,5" />
                        <ui:Button Content="★ 我的常用" Appearance="Secondary" Click="OnFilterFavoritesClick" Margin="2,0" Padding="12,5" />
                        <ui:Button Content="💻 本地工程" Appearance="Secondary" Click="OnFilterLocalClick" Margin="2,0" Padding="12,5" />
                        <ui:Button Content="🌐 网络UNC" Appearance="Secondary" Click="OnFilterUncClick" Margin="2,0" Padding="12,5" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions Right -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:TextBox Width="200" PlaceholderText="快速搜索代号/路径..." Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}" Margin="0,0,10,0" />
                <ui:Button Appearance="Primary" Content="✨ 规范化新建工程" Click="OnCreateProjectClick" Margin="0,0,10,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Command="{Binding LoadProjectsCommand}" ToolTip="刷新工程清单" />
            </StackPanel>
        </Grid>

        <!-- Notification Banner if any -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#00E5FF" BorderThickness="1,0,0,0" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding NotificationText, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding NotificationText}" Foreground="#00E5FF" FontSize="13" />
        </Border>

        <!-- Project Cards List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredProjects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ProjectItem}">
                        <Border Width="380" Margin="0,0,16,16" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Code Badge + Name + Favorite -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 3-Letter Monospace Badge -->
                                    <Border Background="#0D1117" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontFamily="Cascadia Code, Consolas" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" />
                                    </Border>

                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#8B949E" />
                                    </StackPanel>

                                    <!-- Favorite Star -->
                                    <Button Grid.Column="2" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}" FontSize="16" Foreground="#F59E0B" />
                                    </Button>
                                </Grid>

                                <!-- Path & Location -->
                                <Border Grid.Row="1" Background="#0D1117" CornerRadius="4" Padding="8,6" Margin="0,12,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#8B949E"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                        <ui:Button Grid.Column="1" Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Padding="4,2"
                                                   Command="{Binding DataContext.OpenProjectFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" ToolTip="打开物理文件夹" />
                                    </Grid>
                                </Border>

                                <!-- Metrics & Health Status -->
                                <Grid Grid.Row="2" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Lock Pill -->
                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                Background="{Binding IsLocked, Converter={StaticResource LockToBackgroundConverter}}">
                                            <TextBlock Text="{Binding IsLocked, Converter={StaticResource LockToTextConverter}}" FontSize="11"
                                                       Foreground="{Binding IsLocked, Converter={StaticResource LockToForegroundConverter}}" FontWeight="Medium" />
                                        </Border>

                                        <!-- Size Tag -->
                                        <TextBlock Text="{Binding SizeHuman}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Active Pill if active -->
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="● 当前活动工程" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button Grid.Column="0" Appearance="Primary" Content="🚀 切换环境并启动 E3D" HorizontalAlignment="Stretch"
                                               Command="{Binding DataContext.SetActiveAndLaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />

                                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" Margin="8,0,0,0"
                                               Click="OnProjectMoreClick" Tag="{Binding}" ToolTip="下线归档与管理" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
