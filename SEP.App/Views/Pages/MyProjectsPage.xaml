<Page x:Class="SEP.App.Views.Pages.MyProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_MyProjects}"
      Foreground="{DynamicResource SepTextBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ProjectCard.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Nav_MyProjects}" Style="{StaticResource SepPageTitle}" />
                    <controls:Badge Content="{Binding CountText}" Tone="Accent" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:Tr My_PageSubtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket24}" Content="{loc:Tr My_LaunchAll}" Command="{Binding Actions.LaunchAllMineCommand}"
                           ToolTip="{loc:Tr My_LaunchAllTooltip}" IsEnabled="{Binding HasItems}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderAdd24}" Content="{loc:Tr My_NewGroup}" Command="{Binding CreateGroupCommand}" Margin="0,0,8,0"
                           ToolTip="{loc:Tr My_NewGroupTitle}" />
                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMaximizeVertical24}" ToolTip="{loc:Tr Lib_ExpandAll}" AutomationProperties.Name="{loc:Tr Lib_ExpandAll}"
                           Command="{Binding ExpandAllCommand}" Margin="0,0,2,0" />
                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMinimizeVertical24}" ToolTip="{loc:Tr Lib_CollapseAll}" AutomationProperties.Name="{loc:Tr Lib_CollapseAll}"
                           Command="{Binding CollapseAllCommand}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=People24}" Content="{loc:Tr My_ProbeSessions}" Command="{Binding ProbeSessionsCommand}" Margin="0,0,8,0"
                           ToolTip="{loc:Tr My_ProbeSessionsTooltip}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Folder24}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" Margin="0,0,8,0" />
                <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete24}" ToolTip="{loc:Tr My_ClearButton}" AutomationProperties.Name="{loc:Tr My_ClearButton}"
                           Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <!-- how it works -->
        <Border Grid.Row="1" Style="{StaticResource SepCard}" Padding="14,10" Margin="0,0,0,12" Background="{DynamicResource SepAccentSoftBrush}" BorderBrush="{DynamicResource SepAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource SepAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{loc:Tr My_Hint}" Style="{StaticResource SepBody}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="0,0,10,0">
                <!-- empty -->
                <Border Style="{StaticResource SepCard}" Padding="28" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Star48" FontSize="40" Foreground="{DynamicResource SepText3Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Tr My_EmptyTitle}" Style="{StaticResource SepSectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="{loc:Tr My_EmptyBody}" Style="{StaticResource SepPageSubtitle}" TextAlignment="Center" MaxWidth="520" />
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Folder24}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Groups List -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MyProjectGroupViewModel}">
                            <Border Style="{StaticResource SepCard}" Margin="0,0,0,16" Padding="0"
                                    Background="{DynamicResource SepSurfaceBrush}" BorderBrush="{DynamicResource SepBorderBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Group Header Bar -->
                                    <Border Grid.Row="0" Background="{DynamicResource SepSurfaceHoverBrush}" CornerRadius="10,10,0,0" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Expand / Collapse chevron button -->
                                            <ui:Button Style="{StaticResource SepIconButton}" Command="{Binding ToggleExpandedCommand}"
                                                       ToolTip="{loc:Tr Lib_ToggleTooltip}" VerticalAlignment="Center">
                                                <ui:SymbolIcon FontSize="16">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="ChevronRight24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Symbol" Value="ChevronDown24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button>

                                            <!-- Group Icon -->
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="8,0,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SepAccentSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SepCardBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ui:SymbolIcon FontSize="15">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Folder24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Symbol" Value="Star24" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>

                                            <!-- Group Title & Badges -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SepBody}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                <controls:Badge Content="{Binding CountText}" Tone="Info" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Group Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Launch Group Button: writes all projects in this group to custom_evars.bat and launches E3D -->
                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr My_LaunchGroup}"
                                                           ToolTip="{loc:Tr My_LaunchGroupTooltip}"
                                                           Command="{Binding LaunchGroupCommand}"
                                                           IsEnabled="{Binding HasItems}"
                                                           Padding="12,5" Margin="0,0,8,0" />

                                                <!-- Rename Group Button (custom groups only) -->
                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}"
                                                           ToolTip="{loc:Tr My_RenameGroup}" AutomationProperties.Name="{loc:Tr My_RenameGroup}"
                                                           Command="{Binding RenameCommand}"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                           Margin="0,0,4,0" />

                                                <!-- Delete Group Button (custom groups only) -->
                                                <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}"
                                                           ToolTip="{loc:Tr My_DeleteGroup}" AutomationProperties.Name="{loc:Tr My_DeleteGroup}"
                                                           Command="{Binding DeleteCommand}"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Group Content (when expanded) -->
                                    <StackPanel Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8,8,8,10">
                                        <!-- Empty Hint within group -->
                                        <TextBlock Text="{loc:Tr My_GroupEmptyHint}" Style="{StaticResource SepMuted}" Margin="16,16,16,16"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                        <!-- Projects in this group -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ProjectItem}">
                                                    <Border Style="{StaticResource SepRow}" Margin="4,2" ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- order -->
                                                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <ui:Button Style="{StaticResource SepIconButton}" MinWidth="24" MinHeight="22" Padding="2" Icon="{ui:SymbolIcon Symbol=ChevronUp20}" ToolTip="{loc:Tr My_MoveUp}" AutomationProperties.Name="{loc:Tr My_MoveUp}"
                                                                           Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource SepIconButton}" MinWidth="24" MinHeight="22" Padding="2" Icon="{ui:SymbolIcon Symbol=ChevronDown20}" ToolTip="{loc:Tr My_MoveDown}" AutomationProperties.Name="{loc:Tr My_MoveDown}"
                                                                           Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Style="{StaticResource SepAvatar}" Background="{Binding Badge, Converter={StaticResource PaletteConverter}}">
                                                                <TextBlock Text="{Binding Badge}" Style="{StaticResource SepAvatarText}" Foreground="#FFFFFF" FontSize="12" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SepBody}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                                    <controls:Badge Content="{loc:Tr Projects_ActiveBadge}" Tone="Success" IsSolid="True" Margin="8,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <controls:Badge Margin="6,0,0,0" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Content="{Binding Category.Name}" Foreground="{Binding Category.Color, Converter={StaticResource HexToBrushConverter}}" />
                                                                    <controls:Badge Tone="Info" Margin="6,0,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <controls:Badge.Content>
                                                                            <MultiBinding Converter="{StaticResource StatusLabelConverter}">
                                                                                <Binding Path="Status" />
                                                                                <Binding Path="[Status_None]" Source="{x:Static loc:Loc.Instance}" />
                                                                            </MultiBinding>
                                                                        </controls:Badge.Content>
                                                                    </controls:Badge>
                                                                    <controls:Badge Tone="Warning" Margin="6,0,0,0" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}" Content="{loc:Tr Project_LockActive}" />
                                                                    <controls:Badge Tone="Purple" Margin="6,0,0,0" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding OnlineSummary}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:SymbolIcon Symbol="People12" Margin="0,0,3,0" FontSize="11" />
                                                                            <TextBlock Text="{Binding OnlineSummary}" />
                                                                        </StackPanel>
                                                                    </controls:Badge>
                                                                    <controls:Badge Tone="Danger" Margin="6,0,0,0" Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}" Content="{loc:Tr My_Offline}" ToolTip="{loc:Tr My_OfflineTooltip}" />
                                                                    <controls:Badge Margin="6,0,0,0" Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:SymbolIcon Symbol="Person12" Margin="0,0,3,0" FontSize="11" />
                                                                            <TextBlock Text="{Binding Owner}" />
                                                                        </StackPanel>
                                                                    </controls:Badge>
                                                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding LibraryName}" Style="{StaticResource SepCaption}" />
                                                                    <TextBlock Text=" · " Style="{StaticResource SepCaption}" />
                                                                    <TextBlock Text="{Binding BatPath}" Style="{StaticResource SepMono}" ToolTip="{Binding BatPath}" MaxWidth="600" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SepMuted}" Margin="0,3,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr Projects_SwitchAndLaunch}" Padding="10,5" Margin="0,0,6,0"
                                                                           Command="{Binding DataContext.Actions.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Folder24}" ToolTip="{loc:Tr My_MoveToGroup}" AutomationProperties.Name="{loc:Tr My_MoveToGroup}"
                                                                           Command="{Binding DataContext.MoveToGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit24}" ToolTip="{loc:Tr Project_MenuEdit}" AutomationProperties.Name="{loc:Tr Project_MenuEdit}"
                                                                           Command="{Binding DataContext.Actions.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" ToolTip="{loc:Tr Projects_OpenFolderTooltip}" AutomationProperties.Name="{loc:Tr Projects_OpenFolderTooltip}"
                                                                           Command="{Binding DataContext.Actions.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" ToolTip="{loc:Tr Projects_MoreTooltip}" AutomationProperties.Name="{loc:Tr Projects_MoreTooltip}"
                                                                           beh:ClickMenu.IsEnabled="True" ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}" />
                                                                <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=StarOff24}" ToolTip="{loc:Tr Project_RemoveFromMine}" AutomationProperties.Name="{loc:Tr Project_RemoveFromMine}"
                                                                           Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
