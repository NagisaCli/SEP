<Page x:Class="SEP.App.Views.Pages.MyProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_MyProjects}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ProjectCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- small up / down order buttons beside the grip -->
            <Style x:Key="OrderButton" TargetType="ui:Button" BasedOn="{StaticResource SepIconButton}">
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Nav_MyProjects}" Style="{StaticResource SepPageTitle}" />
                    <controls:Badge Content="{Binding CountText}" Tone="Accent" Margin="12,2,0,0" Padding="9,2" />
                </StackPanel>
                <TextBlock Text="{loc:Tr My_PageSubtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr My_LaunchAll}" Command="{Binding Actions.LaunchAllMineCommand}"
                           ToolTip="{loc:Tr My_LaunchAllTooltip}" IsEnabled="{Binding HasItems}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderAdd20}" Content="{loc:Tr My_NewGroup}" Command="{Binding CreateGroupCommand}" Margin="0,0,12,0"
                           ToolTip="{loc:Tr My_NewGroupTitle}" />
                <Border Style="{StaticResource SepTrack}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMaximizeVertical20}" ToolTip="{loc:Tr Lib_ExpandAll}" AutomationProperties.Name="{loc:Tr Lib_ExpandAll}"
                                   Command="{Binding ExpandAllCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMinimizeVertical20}" ToolTip="{loc:Tr Lib_CollapseAll}" AutomationProperties.Name="{loc:Tr Lib_CollapseAll}"
                                   Command="{Binding CollapseAllCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}" ToolTip="{loc:Tr My_ProbeSessionsTooltip}" AutomationProperties.Name="{loc:Tr My_ProbeSessions}"
                                   Command="{Binding ProbeSessionsCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Folder20}" ToolTip="{loc:Tr Nav_Projects}" AutomationProperties.Name="{loc:Tr Nav_Projects}"
                                   Command="{Binding GoProjectsCommand}" />
                        <Border Style="{StaticResource SepToolSeparator}" Margin="4,6" />
                        <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr My_ClearButton}" AutomationProperties.Name="{loc:Tr My_ClearButton}"
                                   Command="{Binding ClearCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- how it works -->
        <Border Grid.Row="1" Style="{StaticResource SepCard}" Padding="12,10" Margin="32,0,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconTile Size="Small" Symbol="Info20" Tone="Info" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{loc:Tr My_Hint}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" VerticalAlignment="Center" TextTrimming="None" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="{StaticResource SepPageContentMargin}">
                <!-- empty -->
                <Border Style="{StaticResource SepCard}" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:EmptyState Symbol="Star24" Tone="Warning" Title="{loc:Tr My_EmptyTitle}" Description="{loc:Tr My_EmptyBody}" Padding="32,40">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Folder20}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" />
                    </controls:EmptyState>
                </Border>

                <!-- Groups. Drag & drop (Behaviors/ProjectDragDrop) needs this nesting: the group card and the empty
                     hint are group drop targets, each row is a draggable item drop target carrying its group id. -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MyProjectGroupViewModel}">
                            <!-- no local BorderBrush: the drag highlight sets one and clears it back to the style's -->
                            <Border Style="{StaticResource SepCard}" Margin="0,0,0,16" Padding="0"
                                    beh:ProjectDragDrop.IsDropTargetGroup="True" beh:ProjectDragDrop.GroupId="{Binding Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- group header -->
                                    <Grid Grid.Row="0" Margin="10,10,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Style="{StaticResource SepIconButton}" Command="{Binding ToggleExpandedCommand}"
                                                   ToolTip="{loc:Tr Lib_ToggleTooltip}" AutomationProperties.Name="{Binding Name}">
                                            <ui:SymbolIcon FontSize="16">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="ChevronRight20" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Symbol" Value="ChevronDown20" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button>

                                        <!-- custom group: folder; the default (ungrouped) list: star -->
                                        <controls:IconTile Grid.Column="1" Size="Small" Margin="4,0,10,0">
                                            <controls:IconTile.Style>
                                                <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                                    <Setter Property="Symbol" Value="Folder20" />
                                                    <Setter Property="Tone" Value="Accent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Symbol" Value="Star20" />
                                                            <Setter Property="Tone" Value="Warning" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:IconTile.Style>
                                        </controls:IconTile>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SepSubtitle}" />
                                            <controls:Badge Content="{Binding CountText}" Margin="10,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- writes all projects of this group to custom_evars.bat and launches E3D -->
                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr My_LaunchGroup}"
                                                       ToolTip="{loc:Tr My_LaunchGroupTooltip}" Command="{Binding LaunchGroupCommand}" IsEnabled="{Binding HasItems}"
                                                       Padding="12,5" Margin="0,0,8,0" />
                                            <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}"
                                                       ToolTip="{loc:Tr Usage_CheckGroupTooltip}" AutomationProperties.Name="{loc:Tr Usage_CheckGroupTooltip}"
                                                       Command="{Binding CheckUsageCommand}" IsEnabled="{Binding HasItems}" />
                                            <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}"
                                                       ToolTip="{loc:Tr My_RenameGroup}" AutomationProperties.Name="{loc:Tr My_RenameGroup}" Command="{Binding RenameCommand}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}"
                                                       ToolTip="{loc:Tr My_DeleteGroup}" AutomationProperties.Name="{loc:Tr My_DeleteGroup}" Command="{Binding DeleteCommand}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- group content (tray) -->
                                    <Border Grid.Row="1" Background="{DynamicResource SepTrayBrush}" BorderBrush="{DynamicResource SepDividerBrush}" BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,11,11" Padding="12,12,12,6" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- empty hint: also a drop target; the drag highlight lights its outline -->
                                            <Border beh:ProjectDragDrop.IsDropTargetGroup="True" beh:ProjectDragDrop.GroupId="{Binding Id}"
                                                    Background="Transparent" Padding="16,14" Margin="0,0,0,6" CornerRadius="{StaticResource SepRadiusM}"
                                                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SepBorderStrongBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="16" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Tr My_GroupEmptyHint}" Style="{StaticResource SepMuted}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- projects of this group -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ProjectItem}">
                                                        <!-- Tag is the page's ProjectActions, looked up once per row; the action buttons reach it by name -->
                                                        <Border x:Name="RowHost" Style="{StaticResource SepRow}" Padding="8,10,12,10" Margin="0,0,0,6"
                                                                ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                beh:ProjectDragDrop.IsDraggable="True"
                                                                beh:ProjectDragDrop.IsDropTargetItem="True"
                                                                beh:ProjectDragDrop.GroupId="{Binding MyGroupId}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- grip: the drag affordance -->
                                                                <Border Grid.Column="0" Width="18" Height="32" Cursor="SizeAll" Background="Transparent"
                                                                        ToolTip="{loc:Tr My_DragReorderTooltip}" Margin="0,0,2,0" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="ReOrderDotsVertical20" FontSize="16" Foreground="{DynamicResource SepText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <!-- order -->
                                                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <ui:Button Style="{StaticResource OrderButton}" Icon="{ui:SymbolIcon Symbol=ChevronUp16}" ToolTip="{loc:Tr My_MoveUp}" AutomationProperties.Name="{loc:Tr My_MoveUp}"
                                                                               Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource OrderButton}" Icon="{ui:SymbolIcon Symbol=ChevronDown16}" ToolTip="{loc:Tr My_MoveDown}" AutomationProperties.Name="{loc:Tr My_MoveDown}"
                                                                               Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Style="{StaticResource SepAvatar}" Background="{Binding Badge, Converter={StaticResource PaletteConverter}}">
                                                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource SepAvatarText}" FontSize="11" />
                                                                </Border>
                                                                <StackPanel Grid.Column="3" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SepBodyStrong}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Title}" />
                                                                        <controls:Badge Content="{loc:Tr Projects_ActiveBadge}" Tone="Success" IsSolid="True" Margin="0,1,6,1" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <controls:Badge HasDot="True" Tone="{Binding Status, Converter={StaticResource StatusToToneConverter}}" Margin="0,1,6,1"
                                                                                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <controls:Badge.Content>
                                                                                <MultiBinding Converter="{StaticResource StatusLabelConverter}">
                                                                                    <Binding Path="Status" />
                                                                                    <Binding Path="[Status_None]" Source="{x:Static loc:Loc.Instance}" />
                                                                                </MultiBinding>
                                                                            </controls:Badge.Content>
                                                                        </controls:Badge>
                                                                        <controls:Badge HasDot="True" Margin="0,1,6,1" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        Content="{Binding Category.Name}" DotBrush="{Binding Category.Color, Converter={StaticResource HexToBrushConverter}}" />
                                                                        <controls:Badge Tone="Warning" Margin="0,1,6,1" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="LockClosed12" Margin="0,0,3,0" FontSize="11" />
                                                                                <TextBlock Text="{loc:Tr Project_LockActive}" />
                                                                            </StackPanel>
                                                                        </controls:Badge>
                                                                        <controls:Badge Tone="Purple" HasDot="True" Margin="0,1,6,1" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding OnlineSummary}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="People12" Margin="0,0,3,0" FontSize="11" />
                                                                                <TextBlock Text="{Binding OnlineBadgeText}" />
                                                                            </StackPanel>
                                                                        </controls:Badge>
                                                                        <controls:Badge Tone="Danger" HasDot="True" Margin="0,1,6,1" Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        Content="{loc:Tr My_Offline}" ToolTip="{loc:Tr My_OfflineTooltip}" />
                                                                        <controls:Badge Margin="0,1,6,1" Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Person12" Margin="0,0,3,0" FontSize="11" />
                                                                                <TextBlock Text="{Binding Owner}" />
                                                                            </StackPanel>
                                                                        </controls:Badge>
                                                                        <ItemsControl ItemsSource="{Binding Tags, Converter={StaticResource TakeConverter}, ConverterParameter=3}" ItemTemplate="{StaticResource TagChip}"
                                                                                      VerticalAlignment="Center" Focusable="False" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                      ToolTip="{Binding Tags, Converter={StaticResource JoinConverter}}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                        <Border Style="{StaticResource SepChip}" Background="Transparent" Visibility="{Binding Tags, Converter={StaticResource OverflowCountConverter}, ConverterParameter=3}">
                                                                            <TextBlock Text="{Binding Tags, Converter={StaticResource OverflowCountConverter}, ConverterParameter=3}" Style="{StaticResource SepChipText}" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <ui:SymbolIcon Symbol="Library20" FontSize="12" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding LibraryName}" Style="{StaticResource SepCaption}" VerticalAlignment="Center" />
                                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource SepText3Brush}" Margin="7,1,7,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding BatPath}" Style="{StaticResource SepMono}" ToolTip="{Binding BatPath}" MaxWidth="600" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SepMuted}" Margin="0,4,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr Projects_SwitchAndLaunch}" Padding="10,5" Margin="0,0,8,0"
                                                                               Command="{Binding Tag.LaunchCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderArrowRight20}" ToolTip="{loc:Tr My_MoveToGroup}" AutomationProperties.Name="{loc:Tr My_MoveToGroup}"
                                                                               Command="{Binding DataContext.MoveToGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}" ToolTip="{loc:Tr Project_MenuEdit}" AutomationProperties.Name="{loc:Tr Project_MenuEdit}"
                                                                               Command="{Binding Tag.EditCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{loc:Tr Projects_OpenFolderTooltip}" AutomationProperties.Name="{loc:Tr Projects_OpenFolderTooltip}"
                                                                               Command="{Binding Tag.OpenFolderCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}" ToolTip="{loc:Tr Projects_MoreTooltip}" AutomationProperties.Name="{loc:Tr Projects_MoreTooltip}"
                                                                               beh:ClickMenu.IsEnabled="True" ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding Tag, ElementName=RowHost}" />
                                                                    <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=StarOff20}" ToolTip="{loc:Tr Project_RemoveFromMine}" AutomationProperties.Name="{loc:Tr Project_RemoveFromMine}"
                                                                               Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
