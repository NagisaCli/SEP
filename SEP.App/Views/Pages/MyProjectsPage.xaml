<Page x:Class="SEP.App.Views.Pages.MyProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_MyProjects}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ProjectCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- small up / down order buttons beside the grip -->
            <Style x:Key="OrderButton" TargetType="ui:Button" BasedOn="{StaticResource SepIconButton}">
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="18" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
            </Style>

            <!-- A whole group (header + list) is one group drop target. The ring stays transparent until the drag
                 highlight sets a BorderBrush (and clears it back to this style's), so no local BorderBrush here. The
                 negative margin cancels border + padding: the group lines up with the page header. -->
            <Style x:Key="GroupDropZone" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="6,4,6,6" />
                <Setter Property="Margin" Value="-8,-6,-8,20" />
            </Style>

            <!-- the empty-group hint inside the list: also a drop target, so the same transparent ring -->
            <Style x:Key="EmptyGroupHint" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,16" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <!-- rows of a group: hairlines start at the row text (padding 8 + grip 20 + order 32 + monogram 40 + gap 12) -->
            <ItemsPanelTemplate x:Key="ProjectRowsPanel">
                <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="112" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: large title with a quiet count, actions on the right -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Nav_MyProjects}" Style="{StaticResource SepLargeTitle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource SepNumber}" FontSize="15" Foreground="{DynamicResource SepText3Brush}"
                               Margin="12,0,0,4" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="{loc:Tr My_PageSubtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play20, Filled=True}" Content="{loc:Tr My_LaunchAll}" Command="{Binding Actions.LaunchAllMineCommand}"
                           ToolTip="{loc:Tr My_LaunchAllTooltip}" IsEnabled="{Binding HasItems}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderAdd20}" Content="{loc:Tr My_NewGroup}" Command="{Binding CreateGroupCommand}" Margin="0,0,12,0"
                           ToolTip="{loc:Tr My_NewGroupTitle}" />
                <!-- the rare actions, as one toolbar capsule -->
                <Border Style="{StaticResource SepTrack}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMaximizeVertical20}" ToolTip="{loc:Tr Lib_ExpandAll}" AutomationProperties.Name="{loc:Tr Lib_ExpandAll}"
                                   Command="{Binding ExpandAllCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowMinimizeVertical20}" ToolTip="{loc:Tr Lib_CollapseAll}" AutomationProperties.Name="{loc:Tr Lib_CollapseAll}"
                                   Command="{Binding CollapseAllCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}" ToolTip="{loc:Tr My_ProbeSessionsTooltip}" AutomationProperties.Name="{loc:Tr My_ProbeSessions}"
                                   Command="{Binding ProbeSessionsCommand}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Folder20}" ToolTip="{loc:Tr Nav_Projects}" AutomationProperties.Name="{loc:Tr Nav_Projects}"
                                   Command="{Binding GoProjectsCommand}" />
                        <Border Style="{StaticResource SepToolSeparator}" Margin="4,7" />
                        <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr My_ClearButton}" AutomationProperties.Name="{loc:Tr My_ClearButton}"
                                   Command="{Binding ClearCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- how it works: a quiet note, not a card -->
        <Grid Grid.Row="1" Margin="40,-8,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Info16" FontSize="14" Foreground="{DynamicResource SepText3Brush}" Margin="0,1,8,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{loc:Tr My_Hint}" Style="{StaticResource SepCaption}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" MaxWidth="820" HorizontalAlignment="Left" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="{StaticResource SepPageContentMargin}">
                <!-- empty -->
                <controls:Card Padding="0" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:EmptyState Symbol="Star24" Tone="Warning" Title="{loc:Tr My_EmptyTitle}" Description="{loc:Tr My_EmptyBody}" Padding="32,44">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Folder20}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" />
                    </controls:EmptyState>
                </controls:Card>

                <!-- Groups. Drag & drop (Behaviors/ProjectDragDrop) needs this nesting: the group block and the empty hint are
                     group drop targets, each row is a draggable item drop target carrying its group id. -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MyProjectGroupViewModel}">
                            <!-- no local BorderBrush: the drag highlight sets one and clears it back to the style's -->
                            <Border Style="{StaticResource GroupDropZone}"
                                    beh:ProjectDragDrop.IsDropTargetGroup="True" beh:ProjectDragDrop.GroupId="{Binding Id}">
                                <StackPanel>
                                    <!-- group header on the page: chevron, tile, name + count, actions -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Style="{StaticResource SepIconButton}" Command="{Binding ToggleExpandedCommand}" Margin="-6,0,0,0"
                                                   ToolTip="{loc:Tr Lib_ToggleTooltip}" AutomationProperties.Name="{Binding Name}">
                                            <ui:SymbolIcon FontSize="14">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="ChevronRight20" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Symbol" Value="ChevronDown20" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </ui:Button>

                                        <!-- custom group: blue folder; the default (ungrouped) list: orange star -->
                                        <controls:IconTile Grid.Column="1" Size="Small" Margin="2,0,10,0">
                                            <controls:IconTile.Style>
                                                <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                                    <Setter Property="Symbol" Value="Folder20" />
                                                    <Setter Property="Tone" Value="Accent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Symbol" Value="Star20" />
                                                            <Setter Property="Tone" Value="Warning" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:IconTile.Style>
                                        </controls:IconTile>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SepSubtitle}" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource SepNumber}" Foreground="{DynamicResource SepText3Brush}" Margin="10,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- writes all projects of this group to custom_evars.bat and launches E3D -->
                                            <ui:Button Style="{StaticResource SepTintedButton}" Icon="{ui:SymbolIcon Symbol=Play20, Filled=True}" Content="{loc:Tr My_LaunchGroup}"
                                                       ToolTip="{loc:Tr My_LaunchGroupTooltip}" Command="{Binding LaunchGroupCommand}" IsEnabled="{Binding HasItems}"
                                                       Padding="12,5" Margin="0,0,6,0" />
                                            <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}"
                                                       ToolTip="{loc:Tr Usage_CheckGroupTooltip}" AutomationProperties.Name="{loc:Tr Usage_CheckGroupTooltip}"
                                                       Command="{Binding CheckUsageCommand}" IsEnabled="{Binding HasItems}" />
                                            <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}"
                                                       ToolTip="{loc:Tr My_RenameGroup}" AutomationProperties.Name="{loc:Tr My_RenameGroup}" Command="{Binding RenameCommand}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}"
                                                       ToolTip="{loc:Tr My_DeleteGroup}" AutomationProperties.Name="{loc:Tr My_DeleteGroup}" Command="{Binding DeleteCommand}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- the projects of this group: an inset grouped list -->
                                    <Border Style="{StaticResource SepGroup}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- empty hint: also a drop target; the drag highlight lights its outline -->
                                            <Border Style="{StaticResource EmptyGroupHint}" beh:ProjectDragDrop.IsDropTargetGroup="True" beh:ProjectDragDrop.GroupId="{Binding Id}"
                                                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="16" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Tr My_GroupEmptyHint}" Style="{StaticResource SepMuted}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                                                </StackPanel>
                                            </Border>

                                            <!-- projects of this group -->
                                            <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource ProjectRowsPanel}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ProjectItem}">
                                                        <!-- Tag is the page's ProjectActions, looked up once per row; the action buttons reach it by name -->
                                                        <Border x:Name="RowHost" Style="{StaticResource SepGroupRow}" Padding="8,10,12,10"
                                                                ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                beh:ProjectDragDrop.IsDraggable="True"
                                                                beh:ProjectDragDrop.IsDropTargetItem="True"
                                                                beh:ProjectDragDrop.GroupId="{Binding MyGroupId}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- grip: the drag affordance -->
                                                                <Border Grid.Column="0" Width="18" Height="32" Cursor="SizeAll" Background="Transparent"
                                                                        ToolTip="{loc:Tr My_DragReorderTooltip}" Margin="0,0,2,0" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="ReOrderDotsVertical20" FontSize="16" Foreground="{DynamicResource SepText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <!-- order -->
                                                                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <ui:Button Style="{StaticResource OrderButton}" Icon="{ui:SymbolIcon Symbol=ChevronUp16}" ToolTip="{loc:Tr My_MoveUp}" AutomationProperties.Name="{loc:Tr My_MoveUp}"
                                                                               Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource OrderButton}" Icon="{ui:SymbolIcon Symbol=ChevronDown16}" ToolTip="{loc:Tr My_MoveDown}" AutomationProperties.Name="{loc:Tr My_MoveDown}"
                                                                               Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ProjectMonogram}" Width="40" Height="40" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="3" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                    <!-- title, then status as dot + words; capsules only for what must stand out -->
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SepBodyStrong}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Title}" />
                                                                        <controls:Badge Content="{loc:Tr Projects_ActiveShort}" Tone="Accent" IsSolid="True" Padding="8,1" Margin="0,1,10,1"
                                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <controls:Badge IsPlain="True" Tone="{Binding Status, Converter={StaticResource StatusToToneConverter}}" Margin="0,1,12,1"
                                                                                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <controls:Badge.Content>
                                                                                <MultiBinding Converter="{StaticResource StatusLabelConverter}">
                                                                                    <Binding Path="Status" />
                                                                                    <Binding Path="[Status_None]" Source="{x:Static loc:Loc.Instance}" />
                                                                                </MultiBinding>
                                                                            </controls:Badge.Content>
                                                                        </controls:Badge>
                                                                        <controls:Badge IsPlain="True" Margin="0,1,12,1" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        Content="{Binding Category.Name}" DotBrush="{Binding Category.Color, Converter={StaticResource HexToBrushConverter}}" />
                                                                        <controls:Badge Tone="Warning" Padding="7,1" Margin="0,1,8,1" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="LockClosed12" Filled="True" Margin="0,0,4,0" FontSize="11" />
                                                                                <TextBlock Text="{loc:Tr Project_Locked}" />
                                                                            </StackPanel>
                                                                        </controls:Badge>
                                                                        <controls:Badge Tone="Purple" Padding="7,1" Margin="0,1,8,1" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding OnlineSummary}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="People12" Filled="True" Margin="0,0,4,0" FontSize="11" />
                                                                                <TextBlock Text="{Binding OnlineBadgeText}" />
                                                                            </StackPanel>
                                                                        </controls:Badge>
                                                                        <controls:Badge Tone="Danger" Padding="7,1" Margin="0,1,8,1" Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        Content="{loc:Tr My_OfflineShort}" ToolTip="{loc:Tr My_OfflineTooltip}" />
                                                                    </WrapPanel>
                                                                    <!-- where it lives: library · evars path; then owner and tags -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <ui:SymbolIcon Symbol="Library16" FontSize="12" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding LibraryName}" Style="{StaticResource SepCaption}" FontSize="11.5" VerticalAlignment="Center" />
                                                                        <TextBlock Text="·" Style="{StaticResource SepCaption}" Margin="6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding BatPath}" Style="{StaticResource SepMono}" ToolTip="{Binding BatPath}" MaxWidth="560" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <WrapPanel Margin="0,4,0,0">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center" Visibility="{Binding HasOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <ui:SymbolIcon Symbol="Person12" FontSize="12" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Owner}" Style="{StaticResource SepCaption}" FontSize="11.5" MaxWidth="180" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <ItemsControl ItemsSource="{Binding Tags, Converter={StaticResource TakeConverter}, ConverterParameter=3}" ItemTemplate="{StaticResource TagChip}"
                                                                                      VerticalAlignment="Center" Focusable="False" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                      ToolTip="{Binding Tags, Converter={StaticResource JoinConverter}}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                        <Border Style="{StaticResource SepChip}" Background="Transparent" Visibility="{Binding Tags, Converter={StaticResource OverflowCountConverter}, ConverterParameter=3}">
                                                                            <TextBlock Text="{Binding Tags, Converter={StaticResource OverflowCountConverter}, ConverterParameter=3}" Style="{StaticResource SepChipText}" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SepMuted}" Margin="0,4,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </StackPanel>
                                                                <!-- actions: one tinted capsule, the rest quiet icons -->
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:Button Style="{StaticResource SepTintedButton}" Icon="{ui:SymbolIcon Symbol=Play20, Filled=True}" Content="{loc:Tr Projects_SwitchAndLaunch}" Padding="12,5" Margin="0,0,6,0"
                                                                               Command="{Binding Tag.LaunchCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderArrowRight20}" ToolTip="{loc:Tr My_MoveToGroup}" AutomationProperties.Name="{loc:Tr My_MoveToGroup}"
                                                                               Command="{Binding DataContext.MoveToGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}" ToolTip="{loc:Tr Project_MenuEdit}" AutomationProperties.Name="{loc:Tr Project_MenuEdit}"
                                                                               Command="{Binding Tag.EditCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{loc:Tr Projects_OpenFolderTooltip}" AutomationProperties.Name="{loc:Tr Projects_OpenFolderTooltip}"
                                                                               Command="{Binding Tag.OpenFolderCommand, ElementName=RowHost}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}" ToolTip="{loc:Tr Projects_MoreTooltip}" AutomationProperties.Name="{loc:Tr Projects_MoreTooltip}"
                                                                               beh:ClickMenu.IsEnabled="True" ContextMenu="{StaticResource ProjectCardMenu}" Tag="{Binding Tag, ElementName=RowHost}" />
                                                                    <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=StarOff20}" ToolTip="{loc:Tr Project_RemoveFromMine}" AutomationProperties.Name="{loc:Tr Project_RemoveFromMine}"
                                                                               Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
