<Page x:Class="SEP.App.Views.Pages.UserAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="用户与权限治理"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar: Project Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="用户与权限治理" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,24,0" VerticalAlignment="Center" />

                <TextBlock Text="当前工程:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="140" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" VerticalAlignment="Center" />

                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Command="{Binding RefreshUsersCommand}" Margin="10,0,0,0" ToolTip="刷新人员清单" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#00E5FF" VerticalAlignment="Center" FontSize="13" />
        </Grid>

        <!-- Main Master-Detail Split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left: User List Card -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="工程用户列表" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Users.Count, StringFormat='共 {0} 人'}" HorizontalAlignment="Right" Foreground="#8B949E" VerticalAlignment="Center" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="10,8" Background="#0D1117" BorderBrush="#253040" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" Foreground="#00E5FF" FontSize="13" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#D1D5DB" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Teams, Converter={StaticResource StringToVisibilityConverter}, FallbackValue='团队: 无'}" FontSize="11" Foreground="#9CA3AF" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="#111827" BorderBrush="#374151" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Security}" FontSize="11" Foreground="#93C5FD" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Details & Create Card -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Selected User Inspector -->
                <Border Grid.Row="0" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{Binding SelectedUser, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="选中用户信息" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="用户代号:" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Name}" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="安全等级:" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Security}" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="所属团队:" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Teams, StringFormat='{}{0}'}" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>

                        <ui:Button Appearance="Danger" Content="🗑️ 删除此用户" HorizontalAlignment="Right" Margin="0,8,0,0"
                                   Command="{Binding DeleteUserCommand}" CommandParameter="{Binding SelectedUser}" />
                    </StackPanel>
                </Border>

                <!-- Add User Form -->
                <Border Grid.Row="2" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="新建工程用户" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <TextBlock Text="用户名称 (代号)" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="如 JOHN" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="分配初始团队" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="如 *MASTER 或 *PIPING" Text="{Binding NewUserTeam, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="登录初始密码 (可选，默认空)" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:PasswordBox Margin="0,0,0,10" />

                        <TextBlock Text="用户安全等级" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding NewUserSecurity}" SelectedValuePath="Content" Margin="0,0,0,10">
                            <ComboBoxItem Content="General" IsSelected="True" />
                            <ComboBoxItem Content="Free" />
                        </ComboBox>

                        <TextBlock Text="用户描述 / 备注" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="如 管道专业负责人" Text="{Binding NewUserDesc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <ui:Button Appearance="Primary" Content="➕ 立即创建用户" Command="{Binding AddUserCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
