<Page x:Class="SEP.App.Views.Pages.UserAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      Title="{loc:Tr Nav_UserAdmin}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <!-- role / membership chip with a remove button -->
        <Style x:Key="RemovableChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SepBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource SepRadiusPill}" />
            <Setter Property="Padding" Value="9,1,2,1" />
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>
        <Style x:Key="ChipRemoveButton" TargetType="ui:Button" BasedOn="{StaticResource SepIconButton}">
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        </Style>
        <DataTemplate x:Key="MembershipChip" DataType="{x:Type models:TeamMembership}">
            <Border Style="{StaticResource RemovableChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TeamLabel}" Style="{StaticResource SepChipText}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource ChipRemoveButton}" Icon="{ui:SymbolIcon Symbol=Dismiss12}" ToolTip="{loc:Tr Users_RemoveMemberTooltip}" AutomationProperties.Name="{loc:Tr Users_RemoveMemberTooltip}"
                               Command="{Binding DataContext.RemoveMembershipCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MemberChip" DataType="{x:Type models:TeamMembership}">
            <Border Style="{StaticResource RemovableChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding User}" Style="{StaticResource SepChipText}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource ChipRemoveButton}" Icon="{ui:SymbolIcon Symbol=Dismiss12}" ToolTip="{loc:Tr Users_RemoveMemberTooltip}" AutomationProperties.Name="{loc:Tr Users_RemoveMemberTooltip}"
                               Command="{Binding DataContext.RemoveMembershipCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- table row inside the list card: divider above, hover wash -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SepDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource SepCaption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Users_PageTitle}" Style="{StaticResource SepPageTitle}" />
                <TextBlock Text="{loc:Tr Users_PageSubtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{loc:Tr Users_CurrentProject}" Style="{StaticResource SepLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ProjectCombo" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Display" MinWidth="260" />
                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" Margin="6,0,0,0" ToolTip="{loc:Tr Users_RefreshTooltip}" AutomationProperties.Name="{loc:Tr Users_RefreshTooltip}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Administrator credentials -->
        <Border Grid.Row="1" Style="{StaticResource SepCard}" Margin="32,0,32,16" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconTile Symbol="Key20" Tone="Warning" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr Users_CredHeader}" Style="{StaticResource SepSectionTitle}" />
                            <controls:Badge Content="{Binding CredentialSummary}" Margin="10,0,0,0" FontFamily="{StaticResource SepMonoFont}" HasDot="True">
                                <controls:Badge.Style>
                                    <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                                        <Setter Property="Tone" Value="Neutral" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSavedCredentials}" Value="True">
                                                <Setter Property="Tone" Value="Success" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Badge.Style>
                            </controls:Badge>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Users_CredHint}" Style="{StaticResource SepCaption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Key20}" Command="{Binding ToggleCredentialsCommand}" VerticalAlignment="Center">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource SwitchConverter}">
                                <Binding Path="ShowCredentials" />
                                <Binding Path="[Common_Close]" Source="{x:Static loc:Loc.Instance}" />
                                <Binding Path="[Users_CredChange]" Source="{x:Static loc:Loc.Instance}" />
                            </MultiBinding>
                        </ui:Button.Content>
                    </ui:Button>
                </Grid>

                <!-- expanded editor -->
                <Border Margin="48,14,0,0" Style="{StaticResource SepCardInner}" Padding="14" Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Users_CredUserLabel}" Style="{StaticResource SepLabel}" />
                                <ui:TextBox x:Name="AdminUserBox" Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" FontFamily="{StaticResource SepMonoFont}" PlaceholderText="SYSTEM" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr Users_CredPasswordLabel}" Style="{StaticResource SepLabel}" />
                                <ui:PasswordBox x:Name="AdminPasswordBox" Password="{Binding AdminPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="True" MaxLength="32" />
                            </StackPanel>
                            <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <ui:Button Appearance="Secondary" Content="{loc:Tr Users_CredTest}" Command="{Binding TestCredentialsCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Primary" Content="{loc:Tr Users_CredSave}" Command="{Binding SaveCredentialsCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Transparent" Content="{loc:Tr Users_CredForget}" Command="{Binding ForgetCredentialsCommand}" Foreground="{DynamicResource SepDangerBrush}"
                                           Visibility="{Binding HasSavedCredentials, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                             Visibility="{Binding IsTestingCredentials, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding CredentialStatus}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CredentialStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Users_CredStorageNote}" Style="{StaticResource SepCaption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tabs + search + actions -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SepDividerBrush}" BorderThickness="0,0,0,1" Margin="32,0,32,16" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="-4,0,0,0">
                    <RadioButton x:Name="UsersTab" Style="{StaticResource SepTabButton}" IsChecked="{Binding IsUsersTab}" GroupName="AdminTabs">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People20" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr Users_TabUsers}" />
                            <controls:Badge Content="{Binding UserCount}" Margin="8,0,0,0" Padding="6,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TeamsTab" Style="{StaticResource SepTabButton}" GroupName="AdminTabs" Click="OnTeamsTabClick">
                        <RadioButton.IsChecked>
                            <Binding Path="IsUsersTab" Converter="{StaticResource InverseBoolConverter}" Mode="OneWay" />
                        </RadioButton.IsChecked>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PeopleTeam20" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr Users_TabTeams}" />
                            <controls:Badge Content="{Binding TeamCount}" Margin="8,0,0,0" Padding="6,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <ui:TextBox x:Name="UserFilterBox" Width="220" Icon="{ui:SymbolIcon Symbol=Search20}" PlaceholderText="{loc:Tr Users_FilterPlaceholder}" Margin="0,0,10,0"
                                Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsUsersTab, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:TextBox Width="220" Icon="{ui:SymbolIcon Symbol=Search20}" PlaceholderText="{loc:Tr Users_FilterTeamsPlaceholder}" Margin="0,0,10,0"
                                Text="{Binding TeamFilter, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsUsersTab, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=PersonAdd20}" Content="{loc:Tr Users_NewUserButton}" Command="{Binding CreateUserCommand}"
                               Visibility="{Binding IsUsersTab, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=PeopleAdd20}" Content="{loc:Tr Users_NewTeamButton}" Command="{Binding CreateTeamCommand}"
                               Visibility="{Binding IsUsersTab, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lists -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                      beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <Grid Margin="{StaticResource SepPageContentMargin}">
                <!-- no project -->
                <Border Style="{StaticResource SepCard}" Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:EmptyState Symbol="PeopleSearch24" Tone="Neutral" Title="{loc:Tr Users_NoProjectTitle}" Description="{loc:Tr Users_NoCode}" />
                </Border>

                <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- users table -->
                    <Border Style="{StaticResource SepCard}" Padding="0,0,0,4" Visibility="{Binding IsUsersTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Users_ColUser}" Style="{StaticResource ColumnHeader}" Margin="48,0,0,0" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Users_ColSecurity}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr Users_ColTeams}" Style="{StaticResource ColumnHeader}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Users}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserRow}">
                                        <Border Style="{StaticResource TableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <!-- identity -->
                                                <Grid Margin="0,0,12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SepAvatar}" Width="36" Height="36" Background="{Binding Name, Converter={StaticResource PaletteConverter}}">
                                                        <TextBlock Text="{Binding Initials}" Style="{StaticResource SepAvatarText}" FontSize="12" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SepBodyStrong}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                                                            <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SepCaption}" Margin="0,2,0,0" ToolTip="{Binding Description}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- role chips -->
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <controls:Badge HasDot="True" Margin="0,2,6,2">
                                                        <controls:Badge.Style>
                                                            <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                                                                <Setter Property="Tone" Value="Info" />
                                                                <Setter Property="Content" Value="{loc:Tr Users_SecurityGeneral}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFree}" Value="True">
                                                                        <Setter Property="Tone" Value="Warning" />
                                                                        <Setter Property="Content" Value="{loc:Tr Users_SecurityFree}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:Badge.Style>
                                                    </controls:Badge>
                                                    <controls:Badge Content="{loc:Tr Users_SystemBadge}" Tone="Purple" Margin="0,2,6,2"
                                                                    Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </WrapPanel>
                                                <!-- teams -->
                                                <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <ItemsControl ItemsSource="{Binding Memberships}" ItemTemplate="{StaticResource MembershipChip}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <TextBlock Text="{loc:Tr Users_NoTeams}" Style="{StaticResource SepCaption}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Visibility="{Binding HasTeams, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <ui:Button Style="{StaticResource ChipRemoveButton}" Width="22" Height="22" CornerRadius="11" Icon="{ui:SymbolIcon Symbol=Add12}"
                                                               BorderBrush="{DynamicResource SepBorderStrongBrush}" BorderThickness="1" Margin="0,2,0,2"
                                                               ToolTip="{loc:Tr Users_AddToTeamTooltip}" AutomationProperties.Name="{loc:Tr Users_AddToTeamTooltip}"
                                                               Command="{Binding DataContext.AddToTeamCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                                <!-- actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Key20}" ToolTip="{loc:Tr Users_PasswordTooltip}" AutomationProperties.Name="{loc:Tr Users_PasswordTooltip}"
                                                               Command="{Binding DataContext.SetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Shield20}" ToolTip="{loc:Tr Users_SecurityTooltip}" AutomationProperties.Name="{loc:Tr Users_SecurityTooltip}"
                                                               Command="{Binding DataContext.ToggleSecurityCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}" ToolTip="{loc:Tr Users_DescriptionTooltip}" AutomationProperties.Name="{loc:Tr Users_DescriptionTooltip}"
                                                               Command="{Binding DataContext.EditDescriptionCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr Users_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Users_DeleteTooltip}"
                                                               Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                               Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- teams table -->
                    <Border Style="{StaticResource SepCard}" Padding="0,0,0,4" Visibility="{Binding IsUsersTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr Users_ColTeam}" Style="{StaticResource ColumnHeader}" Margin="48,0,0,0" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Users_ColMembers}" Style="{StaticResource ColumnHeader}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Teams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TeamRow}">
                                        <Border Style="{StaticResource TableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Margin="0,0,12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SepAvatar}" Width="36" Height="36" Background="{Binding Label, Converter={StaticResource PaletteConverter}}">
                                                        <ui:SymbolIcon Symbol="PeopleTeam20" Foreground="#FFFFFF" FontSize="17" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SepBodyStrong}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                                                            <controls:Badge Content="{loc:Tr Users_MasterBadge}" Tone="Purple" Margin="8,0,0,0" Visibility="{Binding IsMaster, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <controls:Badge Margin="6,0,0,0" Padding="6,0">
                                                                <controls:Badge.Content>
                                                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                                                        <Binding Path="[Users_MemberCount]" Source="{x:Static loc:Loc.Instance}" />
                                                                        <Binding Path="MemberCount" />
                                                                    </MultiBinding>
                                                                </controls:Badge.Content>
                                                            </controls:Badge>
                                                            <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SepCaption}" Margin="0,2,0,0" ToolTip="{Binding Description}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <ItemsControl ItemsSource="{Binding Memberships}" ItemTemplate="{StaticResource MemberChip}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <TextBlock Text="{loc:Tr Users_NoMembers}" Style="{StaticResource SepCaption}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Visibility="{Binding HasMembers, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <ui:Button Style="{StaticResource ChipRemoveButton}" Width="22" Height="22" CornerRadius="11" Icon="{ui:SymbolIcon Symbol=Add12}"
                                                               BorderBrush="{DynamicResource SepBorderStrongBrush}" BorderThickness="1" Margin="0,2,0,2"
                                                               ToolTip="{loc:Tr Users_AddMemberTooltip}" AutomationProperties.Name="{loc:Tr Users_AddMemberTooltip}"
                                                               Command="{Binding DataContext.AddMemberCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=PersonAdd20}" ToolTip="{loc:Tr Users_AddMemberTooltip}" AutomationProperties.Name="{loc:Tr Users_AddMemberTooltip}"
                                                               Command="{Binding DataContext.AddMemberCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr Users_DeleteTeamTooltip}" AutomationProperties.Name="{loc:Tr Users_DeleteTeamTooltip}"
                                                               Command="{Binding DataContext.DeleteTeamCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                               Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- empty / not loaded -->
                    <Border Style="{StaticResource SepCard}" Margin="0,12,0,0" Visibility="{Binding HasLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" MaxWidth="700" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status line -->
        <Grid Grid.Row="4" Margin="{StaticResource SepPageStatusMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SepStatusText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <controls:Badge Grid.Column="2" Content="{Binding ListedAtText}" Margin="12,0,0,0" HasDot="True"
                            Visibility="{Binding ListedAtText, Converter={StaticResource StringToVisibilityConverter}}">
                <controls:Badge.Style>
                    <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                        <Setter Property="Tone" Value="Success" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFromCache}" Value="True">
                                <Setter Property="Tone" Value="Neutral" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:Badge.Style>
            </controls:Badge>
        </Grid>
    </Grid>
</Page>
