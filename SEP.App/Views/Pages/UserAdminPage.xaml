<Page x:Class="SEP.App.Views.Pages.UserAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      Title="{loc:Tr Users_PageTitle}"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar: Project Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Users_PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,24,0" VerticalAlignment="Center" />

                <TextBlock Text="{loc:Tr Users_CurrentProject}" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="200" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Display" VerticalAlignment="Center" />

                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Command="{Binding RefreshUsersCommand}" Margin="10,0,0,0" ToolTip="{loc:Tr Users_RefreshTooltip}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#00E5FF" VerticalAlignment="Center" FontSize="13" />
        </Grid>

        <!-- Main Master-Detail Split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left: User List Card -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Tr Users_ListHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#8B949E" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FormatConverter}">
                                    <Binding Path="[Users_CountFormat]" Source="{x:Static loc:Loc.Instance}" />
                                    <Binding Path="Users.Count" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                              ScrollViewer.CanContentScroll="False" beh:SmoothScroll.IsEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="10,8" Background="#0D1117" BorderBrush="#253040" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" Foreground="#00E5FF" FontSize="13" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#D1D5DB" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="#9CA3AF">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                                        <Binding Path="[Users_TeamsFormat]" Source="{x:Static loc:Loc.Instance}" />
                                                        <Binding Path="Teams" Converter="{StaticResource JoinConverter}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="#111827" BorderBrush="#374151" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Security}" FontSize="11" Foreground="#93C5FD" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Details & Create Card -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Selected User Inspector -->
                <Border Grid.Row="0" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{Binding SelectedUser, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Users_SelectedHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr Users_NameLabel}" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Name}" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr Users_SecurityLabel}" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Security}" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr Users_TeamsLabel}" Foreground="#8B949E" />
                            <TextBlock Text="{Binding SelectedUser.Teams, Converter={StaticResource JoinConverter}}" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </Grid>

                        <ui:Button Appearance="Danger" Content="{loc:Tr Users_DeleteButton}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                   Command="{Binding DeleteUserCommand}" CommandParameter="{Binding SelectedUser}" />
                    </StackPanel>
                </Border>

                <!-- Add User Form -->
                <Border Grid.Row="2" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Users_NewHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Tr Users_NewNameLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="{loc:Tr Users_NewNamePlaceholder}" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="{loc:Tr Users_NewTeamLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="{loc:Tr Users_NewTeamPlaceholder}" Text="{Binding NewUserTeam, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="{loc:Tr Users_NewPasswordLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:PasswordBox Margin="0,0,0,10" />

                        <TextBlock Text="{loc:Tr Users_NewSecurityLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding NewUserSecurity}" SelectedValuePath="Content" Margin="0,0,0,10">
                            <ComboBoxItem Content="General" IsSelected="True" />
                            <ComboBoxItem Content="Free" />
                        </ComboBox>

                        <TextBlock Text="{loc:Tr Users_NewDescLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox PlaceholderText="{loc:Tr Users_NewDescPlaceholder}" Text="{Binding NewUserDesc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <ui:Button Appearance="Primary" Content="{loc:Tr Users_CreateButton}" Command="{Binding AddUserCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
