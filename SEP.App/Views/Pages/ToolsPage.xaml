<Page x:Class="SEP.App.Views.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Tools}"
      Foreground="{DynamicResource SepTextBrush}">

    <Page.Resources>
        <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource SepCard}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="400" />
        </Style>
        <Style x:Key="ToolIconTile" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- one check of a report -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type models:DiagCheck}">
            <Border BorderBrush="{DynamicResource SepBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon FontSize="18" Margin="0,1,10,0" VerticalAlignment="Top">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Warn">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SepWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                                        <Setter Property="Symbol" Value="DismissCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skip">
                                        <Setter Property="Symbol" Value="Subtract24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SepBody}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0" Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:FlaggedLine}">
                                    <Border Style="{StaticResource SepWell}" Padding="8,4" Margin="0,2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LineNumber, StringFormat='L{0}'}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding RawLine}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource SepCaption}" Foreground="{DynamicResource SepWarningBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Wrench20}" Content="{Binding Fix.Title}" Padding="8,4" FontSize="12"
                                   Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Fix}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one suggested fix -->
        <DataTemplate x:Key="FixRow" DataType="{x:Type models:DiagFix}">
            <Border Style="{StaticResource SepCardInner}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SepBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <controls:Badge Content="{loc:Tr Tools_NeedsAdmin}" Tone="Warning" Margin="8,0,0,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Commands}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Wrench20}" Content="{loc:Tr Tools_FixRun}" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                                   Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Copy20}" ToolTip="{loc:Tr Tools_CopyCommands}" AutomationProperties.Name="{loc:Tr Tools_CopyCommands}"
                                   Visibility="{Binding Commands.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"
                                   Command="{Binding DataContext.CopyCommandsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Tools_Title}" Style="{StaticResource SepPageTitle}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Tools_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="0,0,10,0">
                <!-- Report -->
                <Border Margin="0,0,0,12" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SepCard}">
                            <Setter Property="BorderBrush" Value="{DynamicResource SepDangerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReportOk}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SepSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReportOk}" Value="True">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource SepSectionTitle}" />
                                <TextBlock Text="{Binding ReportSubtitle}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Command="{Binding CloseReportCommand}" ToolTip="{loc:Tr Common_Close}" AutomationProperties.Name="{loc:Tr Common_Close}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRow}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Fixes.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <TextBlock Text="{loc:Tr Tools_FixesHeader}" Style="{StaticResource SepLabel}" />
                            <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource FixRow}" />
                        </StackPanel>
                        <Border Style="{StaticResource SepWell}" Margin="0,8,0,0" Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Output}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tool cards -->
                <WrapPanel Orientation="Horizontal">
                    <!-- configuration health -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepAccentSoftBrush}">
                                    <ui:SymbolIcon Symbol="Stethoscope24" Foreground="{DynamicResource SepAccentBrush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr Tools_ConfigTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <TextBlock Text="{loc:Tr Tools_ConfigBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding CustomEvarsPath}" Style="{StaticResource SepMono}" Margin="0,6,0,0" ToolTip="{Binding CustomEvarsPath}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}" Content="{loc:Tr Tools_CheckButton}" Command="{Binding CheckConfigCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Wrench24}" Content="{loc:Tr Tools_FixConfigButton}" Command="{Binding FixConfigCommand}" ToolTip="{loc:Tr Tools_FixConfigTooltip}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- network / library -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepPurpleSoftBrush}">
                                    <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource SepPurpleBrush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr Tools_NetTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <TextBlock Text="{loc:Tr Tools_NetBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <ComboBox x:Name="LibraryBox" ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" DisplayMemberPath="Display" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play24}" Content="{loc:Tr Tools_DiagnoseButton}" Command="{Binding DiagnoseLibraryCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Content="{loc:Tr Tools_DiagnoseAllButton}" Command="{Binding DiagnoseAllCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- USERDATA -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepWarningSoftBrush}">
                                    <ui:SymbolIcon Symbol="Broom24" Foreground="{DynamicResource SepWarningBrush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr Tools_UserDataTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <TextBlock Text="{loc:Tr Tools_UserDataBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding UserDataDir}" Style="{StaticResource SepMono}" Margin="0,6,0,0" ToolTip="{Binding UserDataDir}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Broom24}" Content="{loc:Tr Tools_UserDataButton}" Command="{Binding CleanUserDataCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="{loc:Tr Lib_OpenFolder}" Command="{Binding OpenUserDataCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <!-- plug-in indexes -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepSuccessSoftBrush}">
                                    <ui:SymbolIcon Symbol="DocumentSync24" Foreground="{DynamicResource SepSuccessBrush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr Tools_ReindexTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <TextBlock Text="{loc:Tr Tools_ReindexBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=DocumentSync24}" Content="{loc:Tr Tools_ReindexButton}" Command="{Binding RebuildIndexesCommand}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- E3D install -->
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepSurface2Brush}">
                                    <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource SepText2Brush}" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr Tools_InstallTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <TextBlock Text="{loc:Tr Tools_InstallBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding InstallDir}" Style="{StaticResource SepMono}" Margin="0,6,0,0" ToolTip="{Binding InstallDir}" />
                                </StackPanel>
                            </Grid>
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Settings24}" Content="{loc:Tr Nav_Settings}" Command="{Binding GoSettingsCommand}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Session locks -->
                <Border Style="{StaticResource SepCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIconTile}" Background="{DynamicResource SepDangerSoftBrush}">
                                <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource SepDangerBrush}" FontSize="18" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr Diag_LocksHeader}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    <controls:Badge Margin="10,0,0,0" Tone="Danger" Visibility="{Binding Locks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                        <controls:Badge.Content>
                                            <MultiBinding Converter="{StaticResource FormatConverter}">
                                                <Binding Path="[Diag_LocksCountFormat]" Source="{x:Static loc:Loc.Instance}" />
                                                <Binding Path="Locks.Count" />
                                            </MultiBinding>
                                        </controls:Badge.Content>
                                    </controls:Badge>
                                </StackPanel>
                                <TextBlock Text="{loc:Tr Tools_LocksBody}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Search24}" Content="{loc:Tr Tools_ScanLocks}" Command="{Binding ScanLocksCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Symbol=LockOpen24}" Content="{loc:Tr Diag_UnlockAll}" Command="{Binding UnlockAllCommand}"
                                           Visibility="{Binding Locks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Locks}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SessionLockItem}">
                                    <Border Style="{StaticResource SepRow}" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Badge Content="{Binding ProjectCode}" Tone="Accent" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource SepBody}" FontFamily="{StaticResource SepMonoFont}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FilePath}" Style="{StaticResource SepMono}" ToolTip="{Binding FilePath}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding LockTime, StringFormat='{}{0:g}'}" Style="{StaticResource SepMuted}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource SepCaption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=LockOpen20}" Content="{loc:Tr Diag_UnlockButton}" Padding="8,4" FontSize="12"
                                                       Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Tr Diag_NoLocks}" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SepMuted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LocksScanned}" Value="True" />
                                                <Condition Binding="{Binding Locks.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" ToolTip="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SepStatusText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
