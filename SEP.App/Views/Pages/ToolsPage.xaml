<Page x:Class="SEP.App.Views.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Tools}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <!-- tool widget: a card in the responsive grid; its margin is the gap -->
        <Style x:Key="ToolCard" TargetType="controls:Card" BasedOn="{StaticResource {x:Type controls:Card}}">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="18,18,18,16" />
            <Setter Property="ShadowBlur" Value="20" />
            <Setter Property="ShadowOffset" Value="5" />
        </Style>
        <Style x:Key="ToolTitle" TargetType="TextBlock" BasedOn="{StaticResource SepSectionTitle}">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="ToolBody" TargetType="TextBlock" BasedOn="{StaticResource SepMuted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- severity tile of one check: a white symbol on green / orange / red / grey -->
        <Style x:Key="CheckTile" TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
            <Setter Property="Size" Value="Small" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Symbol" Value="Checkmark20" />
            <Setter Property="Tone" Value="Success" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warn">
                    <Setter Property="Symbol" Value="Warning20" />
                    <Setter Property="Tone" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Symbol" Value="Dismiss20" />
                    <Setter Property="Tone" Value="Danger" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skip">
                    <Setter Property="Symbol" Value="Subtract20" />
                    <Setter Property="Tone" Value="Neutral" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one check of a report, a row of the report's list: severity tile, title, detail, flagged lines, fix -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type models:DiagCheck}">
            <Grid Margin="20,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:IconTile Style="{StaticResource CheckTile}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SepBody}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0" Focusable="False" Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FlaggedLine}">
                                <Border Style="{StaticResource SepWell}" Padding="10,6" Margin="0,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LineNumber, StringFormat='L{0}'}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepAccentBrush}" Margin="0,0,10,0"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding RawLine}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" TextWrapping="Wrap" TextTrimming="None" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource SepCaption}" Foreground="{DynamicResource SepWarningBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ui:Button Grid.Column="2" Style="{StaticResource SepTintedButton}" Icon="{ui:SymbolIcon Symbol=Wrench20}" Content="{Binding Fix.Title}" Padding="12,5" FontSize="12"
                           Margin="12,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibilityConverter}}"
                           Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Fix}" />
            </Grid>
        </DataTemplate>

        <!-- one suggested fix: a row of the fixes list -->
        <DataTemplate x:Key="FixRow" DataType="{x:Type models:DiagFix}">
            <Grid Margin="20,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:IconTile Size="Small" Symbol="Wrench20" Tone="Accent" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SepBodyStrong}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <controls:Badge Content="{loc:Tr Tools_NeedsAdmin}" Tone="Warning" IsPlain="True" VerticalAlignment="Center"
                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SepWell}" Padding="10,6" Margin="0,6,0,0" Visibility="{Binding Commands.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Commands}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Wrench20}" Content="{loc:Tr Tools_FixRun}" Padding="11,5" FontSize="12" Margin="0,0,4,0"
                               Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Copy20}" ToolTip="{loc:Tr Tools_CopyCommands}" AutomationProperties.Name="{loc:Tr Tools_CopyCommands}"
                               Visibility="{Binding Commands.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"
                               Command="{Binding DataContext.CopyCommandsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Tools_Title}" Style="{StaticResource SepPageTitle}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Tools_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="{StaticResource SepPageContentMargin}">
                <!-- Health: an idle prompt until something ran, then the report -->
                <controls:Card Style="{StaticResource SepHeroCard}" Padding="26,24" Margin="0,0,0,32" Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconTile Size="Large" Symbol="HeartPulse24" Tone="Danger" />
                        <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Tools_IdleTitle}" Style="{StaticResource SepTitle}" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock Text="{loc:Tr Tools_IdleHint}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Style="{StaticResource SepCapsuleButton}" Icon="{ui:SymbolIcon Symbol=Stethoscope20}" Content="{loc:Tr Tools_CheckButton}"
                                   Command="{Binding CheckConfigCommand}" VerticalAlignment="Center" MinWidth="120" />
                    </Grid>
                </controls:Card>

                <!-- the report: outcome tile, the counts per severity, then the checks as a list inside the card -->
                <controls:Card Padding="0" Margin="0,0,0,32" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="20,18,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile Size="Medium">
                                <controls:IconTile.Style>
                                    <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                        <Setter Property="Symbol" Value="ErrorCircle20" />
                                        <Setter Property="Tone" Value="Danger" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReportOk}" Value="True">
                                                <Setter Property="Symbol" Value="CheckmarkCircle20" />
                                                <Setter Property="Tone" Value="Success" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:IconTile.Style>
                            </controls:IconTile>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource SepSectionTitle}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding ReportSubtitle}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Dismiss20}" Command="{Binding CloseReportCommand}" ToolTip="{loc:Tr Common_Close}"
                                       AutomationProperties.Name="{loc:Tr Common_Close}" VerticalAlignment="Top" />
                        </Grid>
                        <!-- counts per severity: dot + words -->
                        <WrapPanel Margin="64,0,20,14" Visibility="{Binding Checks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <controls:Badge Tone="Success" IsPlain="True" Margin="0,0,16,0">
                                <controls:Badge.Content>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Tools_SummaryPassed]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="CheckOkCount" />
                                    </MultiBinding>
                                </controls:Badge.Content>
                            </controls:Badge>
                            <controls:Badge Tone="Warning" IsPlain="True" Margin="0,0,16,0">
                                <controls:Badge.Content>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Tools_SummaryWarnings]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="CheckWarnCount" />
                                    </MultiBinding>
                                </controls:Badge.Content>
                            </controls:Badge>
                            <controls:Badge Tone="Danger" IsPlain="True" Margin="0,0,16,0">
                                <controls:Badge.Content>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Tools_SummaryFailed]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="CheckFailCount" />
                                    </MultiBinding>
                                </controls:Badge.Content>
                            </controls:Badge>
                            <controls:Badge IsPlain="True" Margin="0,0,16,0" Visibility="{Binding CheckSkipCount, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                <controls:Badge.Content>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Tools_SummarySkipped]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="CheckSkipCount" />
                                    </MultiBinding>
                                </controls:Badge.Content>
                            </controls:Badge>
                        </WrapPanel>
                        <!-- the checks: rows under a hairline, separators inset to where the row text starts -->
                        <Border Style="{StaticResource SepHairline}" Visibility="{Binding Checks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel SeparatorBrush="{DynamicResource SepSeparatorBrush}" SeparatorInset="58" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- suggested fixes: a second list in the same card, under its own caption -->
                        <StackPanel Visibility="{Binding Fixes.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <Border Style="{StaticResource SepHairline}" />
                            <TextBlock Text="{loc:Tr Tools_FixesHeader}" Style="{StaticResource SepGroupHeader}" Margin="20,14,0,0" />
                            <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource FixRow}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:SeparatedStackPanel SeparatorBrush="{DynamicResource SepSeparatorBrush}" SeparatorInset="58" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Border Style="{StaticResource SepWell}" Margin="20,12,20,0" Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Output}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Height="8" />
                    </StackPanel>
                </controls:Card>

                <!-- Tools: widgets in a responsive grid (two or three to a row) -->
                <TextBlock Text="{loc:Tr Tools_ToolsHeader}" Style="{StaticResource SepSubtitle}" Margin="0,0,0,14" />
                <controls:CardGridPanel MinItemWidth="340" MaxColumns="3" Margin="0,0,-16,16">
                    <!-- configuration health -->
                    <controls:Card Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <controls:IconTile Symbol="Stethoscope20" Tone="Accent" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{loc:Tr Tools_ConfigTitle}" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="{loc:Tr Tools_ConfigBody}" Style="{StaticResource ToolBody}" />
                                <TextBlock Text="{Binding CustomEvarsPath}" Style="{StaticResource SepMono}" Margin="0,8,0,0" ToolTip="{Binding CustomEvarsPath}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play20}" Content="{loc:Tr Tools_CheckButton}" Command="{Binding CheckConfigCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Wrench20}" Content="{loc:Tr Tools_FixConfigButton}" Command="{Binding FixConfigCommand}" ToolTip="{loc:Tr Tools_FixConfigTooltip}" />
                            </WrapPanel>
                        </Grid>
                    </controls:Card>

                    <!-- network / library -->
                    <controls:Card Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <controls:IconTile Symbol="Globe20" Tone="Purple" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{loc:Tr Tools_NetTitle}" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="{loc:Tr Tools_NetBody}" Style="{StaticResource ToolBody}" />
                                <ComboBox x:Name="LibraryBox" ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" DisplayMemberPath="Display" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Play20}" Content="{loc:Tr Tools_DiagnoseButton}" Command="{Binding DiagnoseLibraryCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Content="{loc:Tr Tools_DiagnoseAllButton}" Command="{Binding DiagnoseAllCommand}" />
                            </WrapPanel>
                        </Grid>
                    </controls:Card>

                    <!-- USERDATA -->
                    <controls:Card Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <controls:IconTile Symbol="Broom20" Tone="Warning" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{loc:Tr Tools_UserDataTitle}" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="{loc:Tr Tools_UserDataBody}" Style="{StaticResource ToolBody}" />
                                <TextBlock Text="{Binding UserDataDir}" Style="{StaticResource SepMono}" Margin="0,8,0,0" ToolTip="{Binding UserDataDir}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Broom20}" Content="{loc:Tr Tools_UserDataButton}" Command="{Binding CleanUserDataCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Content="{loc:Tr Lib_OpenFolder}" Command="{Binding OpenUserDataCommand}" />
                            </WrapPanel>
                        </Grid>
                    </controls:Card>

                    <!-- plug-in indexes -->
                    <controls:Card Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <controls:IconTile Symbol="DocumentSync20" Tone="Success" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{loc:Tr Tools_ReindexTitle}" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="{loc:Tr Tools_ReindexBody}" Style="{StaticResource ToolBody}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=DocumentSync20}" Content="{loc:Tr Tools_ReindexButton}" Command="{Binding RebuildIndexesCommand}" />
                            </WrapPanel>
                        </Grid>
                    </controls:Card>

                    <!-- E3D install -->
                    <controls:Card Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <controls:IconTile Symbol="Desktop20" Tone="Neutral" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{loc:Tr Tools_InstallTitle}" Style="{StaticResource ToolTitle}" />
                                <TextBlock Text="{loc:Tr Tools_InstallBody}" Style="{StaticResource ToolBody}" />
                                <TextBlock Text="{Binding InstallDir}" Style="{StaticResource SepMono}" Margin="0,8,0,0" ToolTip="{Binding InstallDir}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Settings20}" Content="{loc:Tr Nav_Settings}" Command="{Binding GoSettingsCommand}" />
                            </WrapPanel>
                        </Grid>
                    </controls:Card>
                </controls:CardGridPanel>

                <!-- Session locks: title + count, what it does, the actions; the locks as an inset grouped list -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{loc:Tr Diag_LocksHeader}" Style="{StaticResource SepSubtitle}" Margin="0,0,10,0" />
                            <controls:Badge Tone="Danger" HasDot="True" VerticalAlignment="Center" Visibility="{Binding Locks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                <controls:Badge.Content>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Diag_LocksCountFormat]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="Locks.Count" />
                                    </MultiBinding>
                                </controls:Badge.Content>
                            </controls:Badge>
                        </WrapPanel>
                        <TextBlock Text="{loc:Tr Tools_LocksBody}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Search20}" Content="{loc:Tr Tools_ScanLocks}" Command="{Binding ScanLocksCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Symbol=LockOpen20}" Content="{loc:Tr Diag_UnlockAll}" Command="{Binding UnlockAllCommand}"
                                   Visibility="{Binding Locks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource SepGroup}" Margin="0,14,0,0" Visibility="{Binding Locks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Locks}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:SeparatedStackPanel Style="{StaticResource SepGroupStackPlain}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SessionLockItem}">
                                <Border Style="{StaticResource SepGroupRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Badge Content="{Binding ProjectCode}" Tone="Accent" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource SepBodyStrong}" FontFamily="{StaticResource SepMonoFont}" FontSize="12" />
                                            <TextBlock Text="{Binding FilePath}" Style="{StaticResource SepMono}" Margin="0,2,0,0" ToolTip="{Binding FilePath}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding LockTime, StringFormat='{}{0:g}'}" Style="{StaticResource SepNumber}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource SepCaption}" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=LockOpen20}" Content="{loc:Tr Diag_UnlockButton}" Padding="10,5" FontSize="12"
                                                   VerticalAlignment="Center" Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <!-- scanned and nothing found: one quiet line -->
                <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding LocksScanned}" Value="True" />
                                        <Condition Binding="{Binding Locks.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="16" Foreground="{DynamicResource SepSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Diag_NoLocks}" Style="{StaticResource SepBody}" Foreground="{DynamicResource SepText2Brush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="{StaticResource SepPageStatusMargin}" ToolTip="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SepStatusText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
