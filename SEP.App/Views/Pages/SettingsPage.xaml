<Page x:Class="SEP.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      Title="{loc:Tr Nav_Settings}"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Tr Nav_Settings}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <!-- Group 1: Paths -->
                <Border Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_PathsHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:Tr Settings_InstallDirLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_InstallDirPlaceholder}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Tr Settings_ProjectsDirLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ProjectsDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_ProjectsDirPlaceholder}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Tr Settings_EvarsLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding EvarsBat, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_EvarsPlaceholder}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Tr Settings_VersionLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding E3dVersion, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_VersionPlaceholder}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Tr Settings_LocalProjectsDirLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding LocalProjectsDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_ProjectsDirPlaceholder}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Tr Settings_LnkLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding E3dLnk, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    </StackPanel>
                </Border>

                <!-- Group 2: Preferences -->
                <Border Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_PreferencesHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <!-- Language: applies immediately and is saved on change -->
                        <TextBlock Text="{loc:Tr Settings_LanguageLabel}" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox Width="260" HorizontalAlignment="Left" Margin="0,0,0,14"
                                  ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Code" SelectedValue="{Binding Language}" />

                        <CheckBox Content="{loc:Tr Settings_AutoStart}" IsChecked="{Binding AutoStart}" Margin="0,0,0,10" Foreground="#FFFFFF" />
                    </StackPanel>
                </Border>

                <!-- Group 3: About -->
                <Border Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_AboutHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Tr Settings_AboutTagline}" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Settings_AboutArch}" Foreground="#8B949E" FontSize="12" Margin="0,0,0,2" />
                        <TextBlock Text="{loc:Tr Settings_AboutStyle}" Foreground="#8B949E" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <ui:Button Appearance="Primary" Content="{loc:Tr Settings_SaveButton}" Command="{Binding SaveSettingsCommand}" Padding="24,10" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
