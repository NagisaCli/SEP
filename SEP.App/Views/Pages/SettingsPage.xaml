<Page x:Class="SEP.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Settings}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <!-- a group of settings starts with a section header; groups are 24 px apart -->
        <Style x:Key="GroupHeader" TargetType="controls:SectionHeader" BasedOn="{StaticResource {x:Type controls:SectionHeader}}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- one labelled path inside the paths card: label | path box | browse -->
        <Style x:Key="PathRow" TargetType="Grid">
            <Setter Property="Margin" Value="16,10" />
        </Style>
        <Style x:Key="PathLabel" TargetType="TextBlock" BasedOn="{StaticResource SepBody}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SepDividerBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Nav_Settings}" Style="{StaticResource SepPageTitle}" />
                <TextBlock Text="{loc:Tr Settings_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SepStatusText}" Margin="0,0,12,0" MaxWidth="320" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save20}" Content="{loc:Tr Settings_SaveButton}" Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="{StaticResource SepPageContentMargin}" MaxWidth="940" HorizontalAlignment="Left">

                <!-- ── Appearance ─────────────────────────────────────────── -->
                <controls:SectionHeader Style="{StaticResource GroupHeader}" Title="{loc:Tr Settings_PreferencesHeader}" Subtitle="{loc:Tr Settings_PreferencesHint}" Symbol="PaintBrush20" Tone="Purple" />
                <controls:SettingCard Header="{loc:Tr Settings_LanguageLabel}" Symbol="LocalLanguage20">
                    <ComboBox x:Name="LanguageBox" Width="240" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Display" SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                </controls:SettingCard>
                <controls:SettingCard Header="{loc:Tr Settings_ThemeLabel}" Symbol="DarkTheme20">
                    <ComboBox x:Name="ThemeBox" Width="240" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Display" SelectedValuePath="Code" SelectedValue="{Binding Theme}" />
                </controls:SettingCard>
                <controls:SettingCard Header="{loc:Tr Settings_StartupHeader}" Description="{loc:Tr Settings_AutoStartHint}" Symbol="Power20">
                    <ui:ToggleSwitch x:Name="AutoStartBox" IsChecked="{Binding AutoStart}" ToolTip="{loc:Tr Settings_AutoStart}" AutomationProperties.Name="{loc:Tr Settings_AutoStart}" />
                </controls:SettingCard>

                <!-- ── E3D paths ──────────────────────────────────────────── -->
                <controls:SectionHeader Style="{StaticResource GroupHeader}" Margin="0,24,0,10" Title="{loc:Tr Settings_PathsHeader}" Subtitle="{loc:Tr Settings_PathsHint}" Symbol="Folder20" Tone="Accent" />
                <Border Style="{StaticResource SepCard}" Padding="0,6">
                    <StackPanel>
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_InstallDirLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="InstallDirBox" Grid.Column="1" Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_InstallDirPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Command="{Binding BrowseInstallDirCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_EvarsLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="EvarsBox" Grid.Column="1" Text="{Binding EvarsBat, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_EvarsPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentSearch20}" Command="{Binding BrowseEvarsBatCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_ProjectsDirLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="ProjectsDirBox" Grid.Column="1" Text="{Binding ProjectsDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_ProjectsDirPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Command="{Binding BrowseProjectsDirCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr Settings_LocalProjectsDirLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="LocalProjectsDirBox" Grid.Column="1" Text="{Binding LocalProjectsDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_ProjectsDirPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Command="{Binding BrowseLocalProjectsDirCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Tr Settings_LocalProjectsDirHint}" Style="{StaticResource SepCaption}" Margin="2,6,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_PluginsDirLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="PluginsDirBox" Grid.Column="1" Text="{Binding PluginsDir, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_PluginsDirPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Command="{Binding BrowsePluginsDirCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_LnkLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="LnkBox" Grid.Column="1" Text="{Binding E3dLnk, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_LnkPlaceholder}" FontFamily="{StaticResource SepMonoFont}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentSearch20}" Command="{Binding BrowseLnkCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Common_Browse}" AutomationProperties.Name="{loc:Tr Common_Browse}" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource PathRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_VersionLabel}" Style="{StaticResource PathLabel}" />
                            <ui:TextBox x:Name="VersionBox" Grid.Column="1" Text="{Binding E3dVersion, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr Settings_VersionPlaceholder}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Data ───────────────────────────────────────────────── -->
                <controls:SectionHeader Style="{StaticResource GroupHeader}" Margin="0,24,0,10" Title="{loc:Tr Settings_DataHeader}" Subtitle="{loc:Tr Settings_DataHint}" Symbol="Database20" Tone="Success">
                    <controls:Badge Content="{loc:Tr Settings_PortableBadge}" Tone="Info" HasDot="True" Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </controls:SectionHeader>
                <controls:SettingCard Header="{loc:Tr Settings_DataFolderHeader}" Description="{Binding DataDir}" Symbol="FolderOpen20" ToolTip="{Binding DataDir}">
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Open20}" Content="{loc:Tr Lib_OpenFolder}" Command="{Binding OpenDataDirCommand}" />
                </controls:SettingCard>
                <controls:SettingCard Header="{loc:Tr Settings_BundleHeader}" Description="{loc:Tr Settings_BundleHint}" Symbol="ArrowSwap20">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowExportLtr20}" Content="{loc:Tr Settings_Export}" Command="{Binding ExportBundleCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Settings_ExportTooltip}" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowImport20}" Content="{loc:Tr Settings_Import}" Command="{Binding ImportBundleCommand}" ToolTip="{loc:Tr Settings_ImportTooltip}" />
                    </StackPanel>
                </controls:SettingCard>

                <!-- ── Paths on this PC ───────────────────────────────────── -->
                <controls:SectionHeader Style="{StaticResource GroupHeader}" Margin="0,24,0,10" Title="{loc:Tr Settings_DevicePathsHeader}" Symbol="Desktop20" Tone="Info">
                    <ui:Button Style="{StaticResource SepLinkButton}" Icon="{ui:SymbolIcon Symbol=ArrowSync16}" Content="{loc:Tr Projects_RefreshTooltip}" Command="{Binding RefreshDevicePathsCommand}" />
                </controls:SectionHeader>
                <Border Style="{StaticResource SepCard}" Padding="16,6">
                    <ItemsControl ItemsSource="{Binding DevicePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DevicePath}">
                                <Border BorderBrush="{DynamicResource SepDividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <controls:IconTile Size="Small" Margin="0,0,12,0">
                                            <controls:IconTile.Style>
                                                <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                                    <Setter Property="Symbol" Value="DismissCircle20" />
                                                    <Setter Property="Tone" Value="Danger" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exists}" Value="True">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle20" />
                                                            <Setter Property="Tone" Value="Success" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:IconTile.Style>
                                        </controls:IconTile>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SepBody}" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SepMono}" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <controls:Badge Grid.Column="2" HasDot="True" Content="{Binding StatusText}" Margin="12,0,0,0">
                                            <controls:Badge.Style>
                                                <Style TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
                                                    <Setter Property="Tone" Value="Danger" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exists}" Value="True">
                                                            <Setter Property="Tone" Value="Success" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:Badge.Style>
                                        </controls:Badge>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── About ──────────────────────────────────────────────── -->
                <controls:SectionHeader Style="{StaticResource GroupHeader}" Margin="0,24,0,10" Title="{loc:Tr Settings_AboutHeader}" Symbol="Info20" Tone="Neutral" />
                <Border Style="{StaticResource SepCard}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SepIconTile}" Width="48" Height="48" CornerRadius="{StaticResource SepRadiusL}" Background="{DynamicResource SepAccentGradientBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Tr Main_ProductName}" FontFamily="{StaticResource SepDisplayFont}" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource SepOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr Settings_AboutTagline}" Style="{StaticResource SepSubtitle}" />
                                <controls:Badge Content="{Binding VersionText}" Margin="10,0,0,0" FontFamily="{StaticResource SepMonoFont}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Tr Settings_AboutArch}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                            <TextBlock Text="{loc:Tr Settings_AboutStyle}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                            <!-- per-user installation: Start menu / desktop shortcut, Apps & features entry -->
                            <Border Style="{StaticResource SepCardInner}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <controls:IconTile Size="Small" Symbol="ArrowDownload20" Tone="Accent" Margin="0,0,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Settings_InstallHeader}" Style="{StaticResource SepBodyStrong}" />
                                        <TextBlock Text="{Binding InstallStatusText}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload20}" Content="{Binding InstallButtonText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Command="{Binding InstallOnThisPcCommand}" ToolTip="{loc:Tr Settings_InstallTooltip}"
                                               Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
