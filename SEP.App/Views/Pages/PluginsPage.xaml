<Page x:Class="SEP.App.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Plugins}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>

        <!-- one PML symbol with its call command -->
        <DataTemplate x:Key="SymbolRow" DataType="{x:Type models:PluginSymbol}">
            <Border Style="{StaticResource SepInsetRow}" Padding="6,3" Margin="-6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <controls:Badge Content="{Binding Kind}" Margin="0,0,8,0" MinWidth="60" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SepBody}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding File}" Style="{StaticResource SepCaption}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Style="{StaticResource SepIconButton}" MinWidth="26" MinHeight="26" Padding="3" Icon="{ui:SymbolIcon Symbol=Copy16}"
                               ToolTip="{Binding CallCommand}" AutomationProperties.Name="{Binding CallCommand}" Visibility="{Binding CallCommand, Converter={StaticResource StringToVisibilityConverter}}"
                               Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding CallCommand}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- component chips (pmllib / pmlui / pml.net / dflts / uic / addin): technical folder names, so mono -->
        <Style x:Key="FeatureBadge" TargetType="controls:Badge" BasedOn="{StaticResource {x:Type controls:Badge}}">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontFamily" Value="{StaticResource SepMonoFont}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- icon + label (+ count) inside a segment of the panel switcher -->
        <Style x:Key="SegmentIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- a read-only value well inside the (grey) details area: one step back up to the card colour -->
        <Style x:Key="DetailWell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource SepRadiusS}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>

    <Grid beh:FolderDropHelper.DropMode="Plugin" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <!-- the toolbar sits beside the title, or under it when the window is too narrow (OnLayoutSizeChanged) -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}" SizeChanged="OnLayoutSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Plugins_Title}" Style="{StaticResource SepLargeTitle}" />
                    <controls:Badge Content="{Binding Total}" Margin="12,4,0,0" Padding="9,2" FontSize="12" ToolTip="{loc:Tr Plugins_TotalTooltip}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="12,4,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Plugins_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="FilterBox" Width="220" Icon="{ui:SymbolIcon Symbol=Search20}" PlaceholderText="{loc:Tr Plugins_FilterPlaceholder}" ClearButtonEnabled="True" Margin="0,0,12,0"
                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Content="{loc:Tr Plugins_New}" Command="{Binding CreateCommand}" Margin="0,0,8,0" />
                <ui:DropDownButton Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload20}" Content="{loc:Tr Plugins_Import}" Margin="0,0,8,0">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr Plugins_ImportFolder}" Icon="{ui:SymbolIcon Symbol=Folder24}" Command="{Binding ImportFolderCommand}" />
                            <MenuItem Header="{loc:Tr Plugins_ImportZip}" Icon="{ui:SymbolIcon Symbol=FolderZip24}" Command="{Binding ImportZipCommand}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Scan20}" Content="{loc:Tr Plugins_ScanSystem}" Command="{Binding ScanSystemPluginsCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Plugins_ScanSystem}" />
                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" Command="{Binding RefreshCommand}" ToolTip="{loc:Tr Plugins_Rescan}" AutomationProperties.Name="{loc:Tr Plugins_Rescan}" />
            </StackPanel>
        </Grid>

        <!-- The E3D plug-in bar switch and the plug-in folder with its bulk actions: an inset grouped list -->
        <Border Grid.Row="1" Style="{StaticResource SepGroup}" Margin="40,0,40,18">
            <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}">
                <Border Style="{StaticResource SepGroupRowStatic}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconTile Size="Small" Symbol="Apps20" Tone="Accent" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Plugins_PanelToggle}" Style="{StaticResource SepBody}" />
                            <TextBlock Text="{Binding PluginPanelTooltip}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0"
                                       ToolTip="{Binding PluginPanelTooltip}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding UsePluginPanel}" IsEnabled="{Binding CanUsePluginPanel}"
                                         ToolTip="{Binding PluginPanelTooltip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Tr Plugins_PanelToggle}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SepGroupRowStatic}" Padding="16,12">
                    <Grid x:Name="DirGrid" SizeChanged="OnLayoutSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:IconTile Size="Small" Symbol="PuzzlePiece20" Tone="Purple" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr Plugins_DirLabel}" Style="{StaticResource SepBody}" VerticalAlignment="Center" />
                                <controls:Badge Margin="12,0,0,0" Tone="Success" IsPlain="True">
                                    <controls:Badge.Content>
                                        <MultiBinding Converter="{StaticResource FormatConverter}">
                                            <Binding Path="[Plugins_CountFormat]" Source="{x:Static loc:Loc.Instance}" />
                                            <Binding Path="Total" />
                                            <Binding Path="EnabledCount" />
                                        </MultiBinding>
                                    </controls:Badge.Content>
                                </controls:Badge>
                            </StackPanel>
                            <TextBlock Text="{Binding PluginsDir}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepText2Brush}" Margin="0,3,0,0" ToolTip="{Binding PluginsDir}" />
                        </StackPanel>
                        <StackPanel x:Name="DirTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=CheckmarkCircle20}" Content="{loc:Tr Plugins_EnableAll}" Margin="0,0,6,0" Command="{Binding SetAllCommand}" CommandParameter="{StaticResource True}" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DismissCircle20}" Content="{loc:Tr Plugins_DisableAll}" Margin="0,0,6,0" Command="{Binding SetAllCommand}" CommandParameter="{StaticResource False}" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentSync20}" Content="{loc:Tr Plugins_RebuildAll}" Margin="0,0,6,0" Command="{Binding RebuildAllIndexesCommand}" ToolTip="{loc:Tr Plugins_RebuildAllTooltip}" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" Content="{loc:Tr Plugins_ChangeDir}" Command="{Binding ChangeDirCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:SeparatedStackPanel>
        </Border>

        <!-- Panel switcher: a segmented control whose thumb slides to the open panel -->
        <controls:SegmentedPanel Grid.Row="2" IsUniform="False" Margin="40,0,40,18">
            <RadioButton x:Name="ListTab" Style="{StaticResource SepSegmentItem}" GroupName="PluginTabs" IsChecked="{Binding ShowList, Mode=OneWay}" Click="OnListTab">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="AppsList20" Style="{StaticResource SegmentIcon}" />
                    <TextBlock Text="{loc:Tr Plugins_TabList}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ConflictsTab" Style="{StaticResource SepSegmentItem}" GroupName="PluginTabs" IsChecked="{Binding ShowConflicts, Mode=OneWay}" Click="OnConflictsTab">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning20" Style="{StaticResource SegmentIcon}" />
                    <TextBlock Text="{loc:Tr Plugins_TabConflicts}" VerticalAlignment="Center" />
                    <controls:Badge Content="{Binding ConflictCount}" Tone="Warning" Margin="7,0,0,0" Padding="6,0" Visibility="{Binding ConflictCount, Converter={StaticResource NonZeroToVisibilityConverter}}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ChainTab" Style="{StaticResource SepSegmentItem}" GroupName="PluginTabs" IsChecked="{Binding ShowChain, Mode=OneWay}" Click="OnChainTab">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Link20" Style="{StaticResource SegmentIcon}" />
                    <TextBlock Text="{loc:Tr Plugins_TabChain}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MacroTab" Style="{StaticResource SepSegmentItem}" GroupName="PluginTabs" IsChecked="{Binding ShowMacro, Mode=OneWay}" Click="OnMacroTab">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Code20" Style="{StaticResource SegmentIcon}" />
                    <TextBlock Text="{loc:Tr Plugins_TabMacro}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="DiscoveryTab" Style="{StaticResource SepSegmentItem}" GroupName="PluginTabs" IsChecked="{Binding ShowDiscovery, Mode=OneWay}" Click="OnDiscoveryTab">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Scan20" Style="{StaticResource SegmentIcon}" />
                    <TextBlock Text="{loc:Tr Plugins_TabDiscovery}" VerticalAlignment="Center" />
                    <controls:Badge Content="{Binding UnmanagedCount}" Tone="Accent" Margin="7,0,0,0" Padding="6,0" Visibility="{Binding UnmanagedCount, Converter={StaticResource NonZeroToVisibilityConverter}}" />
                </StackPanel>
            </RadioButton>
        </controls:SegmentedPanel>

        <!-- Panels -->
        <Grid Grid.Row="3">
            <!-- list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True"
                          Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="{StaticResource SepPageContentMargin}">
                    <controls:Card Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:EmptyState Symbol="PuzzlePiece24" Tone="Purple" Title="{loc:Tr Plugins_EmptyTitle}" Description="{loc:Tr Plugins_EmptyBody}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Content="{loc:Tr Plugins_New}" Command="{Binding CreateCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Folder20}" Content="{loc:Tr Plugins_ImportFolder}" Command="{Binding ImportFolderCommand}" />
                            </StackPanel>
                        </controls:EmptyState>
                    </controls:Card>

                    <!-- the plug-ins as one inset grouped list; hairlines start where the names start -->
                    <Border Style="{StaticResource SepGroup}" Visibility="{Binding Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="96" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PluginInfo}">
                                    <Border Style="{StaticResource SepGroupRow}" Padding="10,12,14,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:Button Style="{StaticResource SepIconButton}" Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                           ToolTip="{loc:Tr Plugins_Details}" AutomationProperties.Name="{Binding Name}">
                                                    <ui:SymbolIcon FontSize="14">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="ChevronRight20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Symbol" Value="ChevronDown20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </ui:Button>
                                                <!-- glossy monogram: initials on the plug-in's colour, lit from above -->
                                                <Border Grid.Column="1" Style="{StaticResource SepAvatar}" Background="{Binding Name, Converter={StaticResource PaletteGradientConverter}}" Margin="4,0,0,0">
                                                    <Grid>
                                                        <Border Style="{StaticResource SepAvatarGloss}" />
                                                        <TextBlock Text="{Binding Initials}" Style="{StaticResource SepAvatarText}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding EffectiveDisplayName}" Style="{StaticResource SepBodyStrong}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name, StringFormat='({0})'}" Style="{StaticResource SepMono}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasCustomDisplayName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <!-- state: dot + words; problems as capsules -->
                                                        <controls:Badge Margin="0,1,10,1" IsPlain="True" Content="{loc:Tr Plugins_EnabledShort}" Tone="Success" Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <controls:Badge Margin="0,1,10,1" IsPlain="True" Content="{loc:Tr Plugins_DisabledShort}" Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        <controls:Badge Margin="0,1,6,1" Padding="7,1" Tone="Warning" Content="{loc:Tr Plugins_IndexStaleShort}" Visibility="{Binding IndexNeedsRebuild, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding PmlIndexStatus}" />
                                                        <controls:Badge Margin="0,1,6,1" Padding="7,1" Tone="Danger" Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{loc:Tr Plugins_DiagnosticsTooltip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Warning16" Filled="True" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding Diagnostics.Count}" />
                                                            </StackPanel>
                                                        </controls:Badge>
                                                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="pmllib" Tone="Accent" Visibility="{Binding HasPmlLib, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding PmlLibPath}" />
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="pmlui" Tone="Purple" Visibility="{Binding HasPmlUi, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding PmlUiPath}" />
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="pml.net" Tone="Info" Visibility="{Binding HasPmlNet, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding PmlNetPath}" />
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="dflts" Visibility="{Binding HasDflts, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding DfltsPath}" />
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="uic" Tone="Warning" Visibility="{Binding HasUic, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{loc:Tr Plugins_UicTooltip}" />
                                                        <controls:Badge Style="{StaticResource FeatureBadge}" Content="addin" Tone="Success" Visibility="{Binding HasAddin, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{loc:Tr Plugins_AddinTooltip}" />
                                                        <TextBlock Style="{StaticResource SepCaption}" VerticalAlignment="Center" Margin="4,0,0,0" Typography.NumeralAlignment="Tabular">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource FormatConverter}">
                                                                    <Binding Path="[Plugins_SymbolCounts]" Source="{x:Static loc:Loc.Instance}" />
                                                                    <Binding Path="FormCount" />
                                                                    <Binding Path="ObjectCount" />
                                                                    <Binding Path="FunctionCount" />
                                                                    <Binding Path="MacroCount" />
                                                                    <Binding Path="AssemblyCount" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource SepMono}" Margin="0,4,0,0" ToolTip="{Binding Path}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                                    <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=OneWay}" AutomationProperties.Name="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                     Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Edit20}" ToolTip="{loc:Tr Plugins_EditDisplayNameTooltip}" AutomationProperties.Name="{loc:Tr Plugins_EditDisplayNameTooltip}"
                                                               Command="{Binding DataContext.EditDisplayNameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=DocumentSync20}" ToolTip="{loc:Tr Plugins_RebuildIndex}" AutomationProperties.Name="{loc:Tr Plugins_RebuildIndex}"
                                                               Visibility="{Binding HasPmlLib, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               Command="{Binding DataContext.RebuildIndexCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{loc:Tr Projects_OpenFolderTooltip}" AutomationProperties.Name="{loc:Tr Projects_OpenFolderTooltip}"
                                                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource SepDangerIconButton}" Icon="{ui:SymbolIcon Symbol=Delete20}" ToolTip="{loc:Tr Plugins_UninstallTooltip}" AutomationProperties.Name="{loc:Tr Plugins_UninstallTooltip}"
                                                               Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- details: a grey inner area under the name column -->
                                            <Border Style="{StaticResource SepCardInner}" Margin="86,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <!-- diagnostics -->
                                                    <StackPanel Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <ui:SymbolIcon Symbol="Warning16" Filled="True" FontSize="14" Foreground="{DynamicResource SepDangerBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{loc:Tr Plugins_DiagnosticsHeader}" Style="{StaticResource SepLabel}" Foreground="{DynamicResource SepDangerBrush}" Margin="0" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- entry commands -->
                                                    <StackPanel Visibility="{Binding HasEntryCommands, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="{loc:Tr Plugins_EntryHeader}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <ui:Button Style="{StaticResource SepLinkButton}" Icon="{ui:SymbolIcon Symbol=Copy16}" Content="{loc:Tr Plugins_CopyEntry}" HorizontalAlignment="Right" Padding="6,2"
                                                                       Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding EntryCommandsText}" />
                                                        </Grid>
                                                        <Border Style="{StaticResource DetailWell}">
                                                            <TextBlock Text="{Binding EntryCommandsText}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepTextBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- symbols -->
                                                    <TextBlock Text="{loc:Tr Plugins_SymbolsHeader}" Style="{StaticResource SepLabel}" />
                                                    <ItemsControl ItemsSource="{Binding AllSymbols}" ItemTemplate="{StaticResource SymbolRow}" />
                                                    <TextBlock Text="{loc:Tr Plugins_NoSymbols}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SepCaption}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding FormCount}" Value="0" />
                                                                            <Condition Binding="{Binding ObjectCount}" Value="0" />
                                                                            <Condition Binding="{Binding FunctionCount}" Value="0" />
                                                                            <Condition Binding="{Binding MacroCount}" Value="0" />
                                                                            <Condition Binding="{Binding AssemblyCount}" Value="0" />
                                                                            <Condition Binding="{Binding UicCount}" Value="0" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- index -->
                                                    <TextBlock Style="{StaticResource SepCaption}" Margin="0,10,0,0" Visibility="{Binding HasPmlLib, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource FormatConverter}">
                                                                <Binding Path="[Plugins_IndexInfo]" Source="{x:Static loc:Loc.Instance}" />
                                                                <Binding Path="PmlIndexStatus" />
                                                                <Binding Path="PmlIndexCount" />
                                                                <Binding Path="PmlFileCount" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- conflicts -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True"
                          Visibility="{Binding ShowConflicts, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="{StaticResource SepPageContentMargin}">
                    <!-- how conflicts resolve: a quiet card with a warning tile, not a yellow box -->
                    <controls:Card Padding="16,14" Margin="0,0,0,18" Visibility="{Binding ConflictCount, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile Size="Small" Symbol="Warning20" Tone="Warning" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{loc:Tr Plugins_ConflictsHint}" Style="{StaticResource SepBody}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </Grid>
                    </controls:Card>
                    <controls:Card>
                        <controls:Card.Style>
                            <Style TargetType="controls:Card" BasedOn="{StaticResource {x:Type controls:Card}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConflictCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:Card.Style>
                        <controls:EmptyState Symbol="CheckmarkCircle24" Tone="Success" Title="{loc:Tr Plugins_NoConflicts}" />
                    </controls:Card>
                    <Border Style="{StaticResource SepGroup}" Visibility="{Binding Conflicts.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PluginConflict}">
                                    <Border Style="{StaticResource SepGroupRowStatic}" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconTile Size="Small" Symbol="BranchFork20" Tone="Warning" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Symbol}" Style="{StaticResource SepBodyStrong}" FontFamily="{StaticResource SepMonoFont}" VerticalAlignment="Center" />
                                                    <controls:Badge Content="{Binding Kind}" Tone="Warning" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SepMuted}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource FormatConverter}">
                                                            <Binding Path="[Plugins_ConflictLine]" Source="{x:Static loc:Loc.Instance}" />
                                                            <Binding Path="PluginsText" />
                                                            <Binding Path="Winner" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- resolution chain -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True"
                          Visibility="{Binding ShowChain, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="{StaticResource SepPageContentMargin}">
                    <TextBlock Text="{loc:Tr Plugins_ChainHint}" Style="{StaticResource SepPageSubtitle}" Margin="2,0,0,12" />
                    <Border Style="{StaticResource SepGroup}">
                        <ItemsControl ItemsSource="{Binding Chain}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStackPlain}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChainEntry}">
                                    <Border Style="{StaticResource SepGroupRowStatic}" MinHeight="44" Padding="16,9">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index}" Style="{StaticResource SepMono}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <controls:Badge Grid.Column="1" Content="{Binding Variable}" Tone="Accent" HorizontalAlignment="Left" FontFamily="{StaticResource SepMonoFont}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource SepBody}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Path}" Style="{StaticResource SepMono}" Foreground="{DynamicResource SepText2Brush}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- hot-load macro -->
            <Grid Margin="40,0,40,28" Visibility="{Binding ShowMacro, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:Card Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconTile Symbol="Code20" Tone="Info" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="{loc:Tr Plugins_MacroHint}" Style="{StaticResource SepBody}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MacroPath}" Style="{StaticResource SepMono}" Margin="0,4,0,0" ToolTip="{Binding MacroPath}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Copy20}" Content="{loc:Tr Plugins_CopyRun}" Command="{Binding CopyRunCommandCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Plugins_CopyRunTooltip}" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Copy20}" Content="{loc:Tr Plugins_CopyMacro}" Command="{Binding CopyMacroCommand}" />
                        </StackPanel>
                    </Grid>
                </controls:Card>
                <controls:Card Grid.Row="1" Padding="6" Background="{DynamicResource SepInputBrush}">
                    <ui:TextBox Text="{Binding MacroText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="{StaticResource SepMonoFont}" FontSize="12"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
                </controls:Card>
            </Grid>

            <!-- discovery / system scan -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True"
                          Visibility="{Binding ShowDiscovery, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="{StaticResource SepPageContentMargin}">
                    <!-- action card -->
                    <controls:Card Padding="16,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile Symbol="Scan20" Tone="Accent" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0">
                                <TextBlock Text="{loc:Tr Plugins_DiscoveryTitle}" Style="{StaticResource SepSectionTitle}" />
                                <TextBlock Text="{loc:Tr Plugins_DiscoveryBody}" Style="{StaticResource SepMuted}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Scan20}" Content="{loc:Tr Plugins_ScanSystem}" Command="{Binding ScanSystemPluginsCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </controls:Card>

                    <!-- scanning -->
                    <controls:Card Padding="24" Margin="0,0,0,18" Visibility="{Binding IsScanningSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Tr Plugins_ScanningSystem}" Style="{StaticResource SepSectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SepCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </controls:Card>

                    <!-- empty -->
                    <controls:Card Visibility="{Binding DiscoveredItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <controls:EmptyState Symbol="SearchInfo24" Tone="Neutral" Title="{loc:Tr Plugins_DiscoveryNotStarted}" Description="{loc:Tr Plugins_DiscoveredEmpty}">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Scan20}" Content="{loc:Tr Plugins_ScanSystem}" Command="{Binding ScanSystemPluginsCommand}" />
                        </controls:EmptyState>
                    </controls:Card>

                    <!-- discovered plug-ins: one inset grouped list -->
                    <Border Style="{StaticResource SepGroup}" Visibility="{Binding DiscoveredItems.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding DiscoveredItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="62" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DiscoveredPluginInfo}">
                                    <Border Style="{StaticResource SepGroupRow}" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconTile Symbol="FolderZip20" Tone="Purple" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SepBodyStrong}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <controls:Badge Margin="0,1,6,1" Content="{Binding LocationType}" Tone="Info" />
                                                    <controls:Badge Margin="0,1,10,1" Content="{Binding StructureType}" />
                                                    <controls:Badge Margin="0,1,6,1" IsPlain="True" Content="{loc:Tr Plugins_AlreadyManaged}" Tone="Success" Visibility="{Binding IsAlreadyManaged, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding KeyFeatureDescription}" Style="{StaticResource SepMuted}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource SepMono}" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload20}" Content="{loc:Tr Plugins_HostIntoSep}" Margin="0,0,6,0"
                                                           Visibility="{Binding IsAlreadyManaged, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                           Command="{Binding DataContext.HostDiscoveredCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Play20}" Content="{loc:Tr Plugins_HostAndEnable}" Margin="0,0,6,0"
                                                           Visibility="{Binding IsAlreadyManaged, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                           Command="{Binding DataContext.HostAndEnableCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                <ui:Button Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=FolderOpen20}" ToolTip="{loc:Tr Projects_OpenFolderTooltip}" AutomationProperties.Name="{loc:Tr Projects_OpenFolderTooltip}"
                                                           Command="{Binding DataContext.OpenDiscoveredFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- status -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="{StaticResource SepPageStatusMargin}" ToolTip="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SepStatusText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
