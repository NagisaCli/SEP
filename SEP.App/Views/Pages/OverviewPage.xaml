<Page x:Class="SEP.App.Views.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Overview}"
      Foreground="{DynamicResource SepTextBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ProjectCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- KPI tile -->
            <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource SepCard}">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SepAccentBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
            </Style>

            <!-- distribution bar -->
            <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:DistributionBar}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource SepMuted}" VerticalAlignment="Center" ToolTip="{Binding Label}" />
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource SepInputBrush}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStarConverter}}" />
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStarConverter}, ConverterParameter=rest}" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" MinWidth="3" Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource SepMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource SepMonoFont}" />
                </Grid>
            </DataTemplate>

            <!-- compact project row (recent / online) -->
            <DataTemplate x:Key="CompactProjectRow" DataType="{x:Type models:ProjectItem}">
                <Border Style="{StaticResource SepRow}" Padding="10,8" Margin="0,0,0,6" ContextMenu="{StaticResource ProjectCardMenu}"
                        Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SepAvatar}" Width="30" Height="30" CornerRadius="8" Background="{Binding Badge, Converter={StaticResource PaletteConverter}}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource SepAvatarText}" Foreground="#FFFFFF" FontSize="10" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SepBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <controls:Badge Tone="Purple" Margin="6,0,0,0" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding OnlineSummary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="People12" Margin="0,0,3,0" FontSize="11" />
                                        <TextBlock Text="{Binding OnlineSummary}" />
                                    </StackPanel>
                                </controls:Badge>
                            </StackPanel>
                            <TextBlock Text="{Binding LibraryName}" Style="{StaticResource SepCaption}" Margin="0,1,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Rocket20}" ToolTip="{loc:Tr Projects_SwitchAndLaunch}" AutomationProperties.Name="{loc:Tr Projects_SwitchAndLaunch}"
                                   Foreground="{DynamicResource SepAccentBrush}" Command="{Binding DataContext.Actions.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Overview_Title}" Style="{StaticResource SepPageTitle}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Overview_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=People24}" Content="{loc:Tr My_ProbeSessions}" Command="{Binding ProbeCommand}" ToolTip="{loc:Tr My_ProbeSessionsTooltip}" Margin="0,0,8,0" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="{loc:Tr Projects_CreateButton}" Command="{Binding Actions.CreateProjectCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="0,0,10,0">
                <!-- notifications -->
                <Border Style="{StaticResource SepCard}" Padding="14,10" Margin="0,0,0,12" Background="{DynamicResource SepWarningSoftBrush}" BorderBrush="{DynamicResource SepWarningBrush}"
                        Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Alert24" Foreground="{DynamicResource SepWarningBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Overview_Notifications}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                            </StackPanel>
                            <ui:Button Appearance="Transparent" Content="{loc:Tr Overview_DismissAll}" Command="{Binding DismissAllCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:NotificationRecord}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SepBody}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Dismiss20}" ToolTip="{loc:Tr Overview_Dismiss}" AutomationProperties.Name="{loc:Tr Overview_Dismiss}"
                                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- KPI tiles -->
                <WrapPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnProjectsTile" AutomationProperties.Name="{loc:Tr Overview_Projects}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource SepAccentBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Overview_Projects}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectCount}" Style="{StaticResource StatValue}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource SepCaption}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Overview_LibrariesFormat]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="LibraryCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnMineTile" AutomationProperties.Name="{loc:Tr Nav_MyProjects}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" Foreground="{DynamicResource SepWarningBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Nav_MyProjects}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding MyCount}" Style="{StaticResource StatValue}" Margin="0,4,0,0" />
                            <TextBlock Text="{loc:Tr Overview_MyHint}" Style="{StaticResource SepCaption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnProjectsTile" AutomationProperties.Name="{loc:Tr Overview_Online}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" Foreground="{DynamicResource SepPurpleBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Overview_Online}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource StatValue}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource SepCaption}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Overview_LockedFormat]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="LockedCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnMineTile" AutomationProperties.Name="{loc:Tr Main_ActiveProjectLabel}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Rocket24" Foreground="{DynamicResource SepSuccessBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Overview_Active}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource StatValue}" FontSize="18" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding ActiveLabel}" FontFamily="{StaticResource SepMonoFont}" />
                            <TextBlock Text="{Binding ActiveMode}" Style="{StaticResource SepCaption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnSettingsTile" AutomationProperties.Name="{loc:Tr Overview_Install}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Warning24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding E3dInstallOk}" Value="True">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="{loc:Tr Overview_Install}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StatValue}" FontSize="18" Margin="0,8,0,2">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SwitchConverter}">
                                        <Binding Path="E3dInstallOk" />
                                        <Binding Path="[Overview_InstallOk]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="[Overview_InstallMissing]" Source="{x:Static loc:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding E3dInstallText}" Style="{StaticResource SepMono}" MaxWidth="220" ToolTip="{Binding E3dInstallText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" MouseLeftButtonUp="OnToolsTile" AutomationProperties.Name="{loc:Tr Nav_Tools}"
                            Visibility="{Binding UnreachableLibraries, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugDisconnected24" Foreground="{DynamicResource SepDangerBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Overview_Unreachable}" Style="{StaticResource SepLabel}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding UnreachableLibraries}" Style="{StaticResource StatValue}" Margin="0,4,0,0" Foreground="{DynamicResource SepDangerBrush}" />
                            <TextBlock Text="{loc:Tr Overview_UnreachableHint}" Style="{StaticResource SepCaption}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- two columns -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <!-- quick launch -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Rocket24" Foreground="{DynamicResource SepAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Overview_QuickLaunch}" Style="{StaticResource SepSectionTitle}" />
                            </StackPanel>
                            <ui:Button Appearance="Transparent" Content="{loc:Tr Overview_SeeAll}" Command="{Binding GoMyProjectsCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding QuickLaunch}" ItemTemplate="{StaticResource ProjectCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Padding="20" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SepCard}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MyCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr My_EmptyTitle}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                <TextBlock Text="{loc:Tr My_EmptyBody}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,10" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Folder24}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- recently discovered -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <ui:SymbolIcon Symbol="Clock24" Foreground="{DynamicResource SepInfoBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr Overview_Recent}" Style="{StaticResource SepSectionTitle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CompactProjectRow}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- online now -->
                        <Border Style="{StaticResource SepCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="People24" Foreground="{DynamicResource SepPurpleBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Tr Overview_OnlineNow}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Online}" ItemTemplate="{StaticResource CompactProjectRow}" />
                                <TextBlock Text="{loc:Tr Overview_NobodyOnline}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SepMuted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Online.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- categories -->
                        <Border Style="{StaticResource SepCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Tag24" Foreground="{DynamicResource SepAccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Tr Overview_ByCategory}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                    </StackPanel>
                                    <ui:Button Appearance="Transparent" Content="{loc:Tr Category_Manage}" Command="{Binding Actions.ManageCategoriesCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource BarTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- status -->
                        <Border Style="{StaticResource SepCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="DataPie24" Foreground="{DynamicResource SepSuccessBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Tr Overview_ByStatus}" Style="{StaticResource SepSectionTitle}" FontSize="14" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Statuses}" ItemTemplate="{StaticResource BarTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- shortcuts -->
                        <Border Style="{StaticResource SepCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Overview_Shortcuts}" Style="{StaticResource SepSectionTitle}" FontSize="14" Margin="0,0,0,8" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=PuzzlePiece24}" Content="{loc:Tr Nav_Plugins}" Command="{Binding GoPluginsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Toolbox24}" Content="{loc:Tr Nav_Tools}" Command="{Binding GoToolsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Settings24}" Content="{loc:Tr Nav_Settings}" Command="{Binding GoSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <TextBlock Text="{Binding DataDir}" Style="{StaticResource SepMono}" Margin="0,10,0,0" ToolTip="{Binding DataDir}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
