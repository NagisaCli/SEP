<Page x:Class="SEP.App.Views.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      xmlns:beh="clr-namespace:SEP.App.Behaviors"
      xmlns:controls="clr-namespace:SEP.App.Controls"
      xmlns:models="clr-namespace:SEP.App.Models"
      xmlns:vm="clr-namespace:SEP.App.ViewModels"
      Title="{loc:Tr Nav_Overview}"
      Style="{StaticResource SepPage}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ProjectCard.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- widget tile: a SepTileButton in an even UniformGrid row (equal heights); its margin is the gap -->
            <Style x:Key="KpiTile" TargetType="Button" BasedOn="{StaticResource SepTileButton}">
                <Setter Property="Margin" Value="0,0,16,16" />
                <Setter Property="MinWidth" Value="150" />
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
                <Setter Property="Margin" Value="9,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- header above a group or card in the side column, with room for a trailing link -->
            <Style x:Key="SideHeader" TargetType="TextBlock" BasedOn="{StaticResource SepGroupHeader}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="14,0,0,0" />
            </Style>

            <!-- distribution bar (Screen Time style): label and count above a thin rounded bar -->
            <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:DistributionBar}">
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Label}">
                        <Ellipse Style="{StaticResource SepStatusDot}" Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource SepBody}" FontSize="12.5" MaxWidth="190" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource SepNumber}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SepTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="6" CornerRadius="3" Margin="0,7,0,0" Background="{DynamicResource SepTrackBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStarConverter}}" />
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStarConverter}, ConverterParameter=rest}" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" MinWidth="6" Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- compact project row of an inset grouped list (recent / online): glossy monogram, title, library, launch -->
            <DataTemplate x:Key="CompactProjectRow" DataType="{x:Type models:ProjectItem}">
                <Border Style="{StaticResource SepGroupRow}" Padding="16,9,10,9" ContextMenu="{StaticResource ProjectCardMenu}"
                        Tag="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Page}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProjectMonogram}" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SepBodyStrong}" VerticalAlignment="Center" MaxWidth="200" ToolTip="{Binding Title}" />
                                <controls:Badge Tone="Purple" Margin="6,0,0,0" Padding="6,0" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding OnlineSummary}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="People12" Filled="True" Margin="0,0,3,0" FontSize="11" />
                                        <TextBlock Text="{Binding OnlineBadgeText}" />
                                    </StackPanel>
                                </controls:Badge>
                            </StackPanel>
                            <TextBlock Text="{Binding LibraryName}" Style="{StaticResource SepCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Play20, Filled=True}" ToolTip="{loc:Tr Projects_SwitchAndLaunch}"
                                   AutomationProperties.Name="{loc:Tr Projects_SwitchAndLaunch}" Foreground="{DynamicResource SepAccentBrush}"
                                   Command="{Binding DataContext.Actions.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- the panel of a grouped list of compact rows: hairlines start at the row text (16 + 32 + 12) -->
            <ItemsPanelTemplate x:Key="CompactRowsPanel">
                <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="60" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: large title, subtitle, actions -->
        <Grid Grid.Row="0" Margin="{StaticResource SepPageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Overview_Title}" Style="{StaticResource SepLargeTitle}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="14,4,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Overview_Subtitle}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}" Content="{loc:Tr My_ProbeSessions}" Command="{Binding ProbeCommand}" ToolTip="{loc:Tr My_ProbeSessionsTooltip}" Margin="0,0,8,0" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Content="{loc:Tr Projects_CreateButton}" Command="{Binding Actions.CreateProjectCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" beh:SmoothScroll.IsEnabled="True" Focusable="True">
            <StackPanel Margin="{StaticResource SepPageContentMargin}">
                <!-- notifications: an inset grouped list, each with an orange tile and its own dismiss -->
                <StackPanel Margin="0,0,0,28" Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr Overview_Notifications}" Style="{StaticResource SideHeader}" />
                        <ui:Button Style="{StaticResource SepLinkButton}" Content="{loc:Tr Overview_DismissAll}" Command="{Binding DismissAllCommand}" HorizontalAlignment="Right" Margin="0,-6,0,-6" />
                    </Grid>
                    <Border Style="{StaticResource SepGroup}">
                        <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="54" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:NotificationRecord}">
                                    <Border Style="{StaticResource SepGroupRowStatic}" Padding="16,11,10,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconTile Size="Small" Symbol="Alert20" Tone="Warning" VerticalAlignment="Top" Margin="0,1,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SepBodyStrong}" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource SepMuted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="2" Style="{StaticResource SepIconButton}" Icon="{ui:SymbolIcon Symbol=Dismiss16}" ToolTip="{loc:Tr Overview_Dismiss}" AutomationProperties.Name="{loc:Tr Overview_Dismiss}"
                                                       VerticalAlignment="Top" Margin="8,-2,0,0"
                                                       Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Hero, like an App Store app header: the mode's large tile, what E3D will load as a large title, its state as
                     quiet chips, and the one capsule launch button. The card draws its own soft shadow (no effect). -->
                <controls:Card Style="{StaticResource SepHeroCard}" Margin="0,0,0,28">
                    <Grid>
                        <!-- set up -->
                        <Grid Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile Size="Large" Width="64" Height="64" FontSize="30" VerticalAlignment="Center">
                                <controls:IconTile.Style>
                                    <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                        <Setter Property="Symbol" Value="Cube24" />
                                        <Setter Property="Tone" Value="Accent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shell.ActiveMode}" Value="all">
                                                <Setter Property="Symbol" Value="Star24" />
                                                <Setter Property="Tone" Value="Warning" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shell.ActiveMode}" Value="library">
                                                <Setter Property="Symbol" Value="Library24" />
                                                <Setter Property="Tone" Value="Info" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:IconTile.Style>
                            </controls:IconTile>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,28,0">
                                <TextBlock Text="{loc:Tr Overview_HeroEyebrow}" Style="{StaticResource SepEyebrow}" />
                                <TextBlock Text="{Binding ActiveLabel}" Margin="0,4,0,0" ToolTip="{Binding ActiveLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SepDisplay}">
                                            <Setter Property="FontFamily" Value="{StaticResource SepMonoFont}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <!-- "All my projects" is a phrase, not a code -->
                                                <DataTrigger Binding="{Binding Shell.ActiveMode}" Value="all">
                                                    <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- state: the mode as a soft capsule, the library and E3D's state as dot + words -->
                                <WrapPanel Margin="0,12,0,0">
                                    <controls:Badge Tone="Accent" Margin="0,2,12,2" Padding="9,2">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="12" Margin="0,0,5,0" Filled="True">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Cube20" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Shell.ActiveMode}" Value="all">
                                                                <Setter Property="Symbol" Value="Star20" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Shell.ActiveMode}" Value="library">
                                                                <Setter Property="Symbol" Value="Library20" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding ActiveMode}" />
                                        </StackPanel>
                                    </controls:Badge>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,12,2" VerticalAlignment="Center"
                                                Visibility="{Binding ActiveLibrary, Converter={StaticResource StringToVisibilityConverter}}">
                                        <ui:SymbolIcon Symbol="Library16" FontSize="13" Foreground="{DynamicResource SepText3Brush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveLibrary}" Style="{StaticResource SepMuted}" MaxWidth="260" VerticalAlignment="Center" ToolTip="{Binding ActiveLibrary}" />
                                    </StackPanel>
                                    <controls:Badge IsPlain="True" Tone="Success" Margin="0,2,12,2" Content="{loc:Tr Main_E3dRunning}"
                                                    Visibility="{Binding Shell.IsE3dRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="200">
                                <ui:Button Style="{StaticResource SepCapsuleButton}" Icon="{ui:SymbolIcon Symbol=Play24, Filled=True}" Content="{loc:Tr Main_LaunchShort}"
                                           HorizontalAlignment="Stretch" Padding="24,10" MinHeight="42" FontSize="14"
                                           Command="{Binding Shell.LaunchActiveProjectCommand}" ToolTip="{loc:Tr Main_LaunchTooltip}" />
                                <ui:Button Style="{StaticResource SepCapsuleSecondaryButton}" Icon="{ui:SymbolIcon Symbol=Star20}" Content="{loc:Tr Overview_HeroLaunchAll}" Margin="0,10,0,0"
                                           HorizontalAlignment="Stretch" Padding="16,7" MinHeight="34" FontWeight="Medium"
                                           Command="{Binding Actions.LaunchAllMineCommand}" ToolTip="{loc:Tr Main_MenuLaunchAllMine}" />
                            </StackPanel>
                        </Grid>

                        <!-- nothing set up yet -->
                        <Grid Visibility="{Binding HasActiveProject, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile Size="Large" Width="64" Height="64" FontSize="30" Symbol="Rocket24" Tone="Accent" />
                            <StackPanel Grid.Column="1" Margin="20,0,28,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Overview_HeroEmptyTitle}" Style="{StaticResource SepTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Tr Overview_HeroEmptyBody}" Style="{StaticResource SepPageSubtitle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Style="{StaticResource SepCapsuleButton}" Icon="{ui:SymbolIcon Symbol=Folder20, Filled=True}" Content="{loc:Tr Overview_HeroOpenWorkbench}"
                                       Padding="20,9" VerticalAlignment="Center" Command="{Binding GoProjectsCommand}" />
                        </Grid>
                    </Grid>
                </controls:Card>

                <!-- widgets: one even row on a wide window, two rows on a narrow one (see OverviewPage.xaml.cs) -->
                <UniformGrid x:Name="KpiGrid" Rows="1" Margin="0,0,-16,12">
                    <Button Style="{StaticResource KpiTile}" Click="OnProjectsTile" AutomationProperties.Name="{loc:Tr Overview_Projects}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconTile Size="Small" Symbol="Folder20" Tone="Accent" />
                                <TextBlock Text="{loc:Tr Overview_Projects}" Style="{StaticResource KpiLabel}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectCount}" Style="{StaticResource SepKpiValue}" Margin="0,14,0,2" />
                            <TextBlock Style="{StaticResource SepCaption}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Overview_LibrariesFormat]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="LibraryCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource KpiTile}" Click="OnMineTile" AutomationProperties.Name="{loc:Tr Nav_MyProjects}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconTile Size="Small" Symbol="Star20" Tone="Warning" />
                                <TextBlock Text="{loc:Tr Nav_MyProjects}" Style="{StaticResource KpiLabel}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MyCount}" Style="{StaticResource SepKpiValue}" Margin="0,14,0,2" />
                            <TextBlock Text="{loc:Tr Overview_MyHint}" Style="{StaticResource SepCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource KpiTile}" Click="OnProjectsTile" AutomationProperties.Name="{loc:Tr Overview_Online}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconTile Size="Small" Symbol="People20" Tone="Purple" />
                                <TextBlock Text="{loc:Tr Overview_Online}" Style="{StaticResource KpiLabel}" />
                            </StackPanel>
                            <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource SepKpiValue}" Margin="0,14,0,2" />
                            <TextBlock Style="{StaticResource SepCaption}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatConverter}">
                                        <Binding Path="[Overview_LockedFormat]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="LockedCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource KpiTile}" Click="OnSettingsTile" AutomationProperties.Name="{loc:Tr Overview_Install}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconTile Size="Small">
                                    <controls:IconTile.Style>
                                        <Style TargetType="controls:IconTile" BasedOn="{StaticResource {x:Type controls:IconTile}}">
                                            <Setter Property="Symbol" Value="Warning20" />
                                            <Setter Property="Tone" Value="Danger" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding E3dInstallOk}" Value="True">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle20" />
                                                    <Setter Property="Tone" Value="Success" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:IconTile.Style>
                                </controls:IconTile>
                                <TextBlock Text="{loc:Tr Overview_Install}" Style="{StaticResource KpiLabel}" />
                            </StackPanel>
                            <!-- a word, not a number: one step smaller; the shared 40 px line box keeps it on the numbers' baseline -->
                            <TextBlock Style="{StaticResource SepKpiValue}" FontSize="24" Margin="0,14,0,2">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SwitchConverter}">
                                        <Binding Path="E3dInstallOk" />
                                        <Binding Path="[Overview_InstallOk]" Source="{x:Static loc:Loc.Instance}" />
                                        <Binding Path="[Overview_InstallMissing]" Source="{x:Static loc:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding E3dInstallText}" Style="{StaticResource SepMono}" ToolTip="{Binding E3dInstallText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource KpiTile}" Click="OnToolsTile" AutomationProperties.Name="{loc:Tr Nav_Tools}"
                            Visibility="{Binding UnreachableLibraries, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconTile Size="Small" Symbol="PlugDisconnected20" Tone="Danger" />
                                <TextBlock Text="{loc:Tr Overview_Unreachable}" Style="{StaticResource KpiLabel}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UnreachableLibraries}" Style="{StaticResource SepKpiValue}" Margin="0,14,0,2" Foreground="{DynamicResource SepDangerBrush}" />
                            <TextBlock Text="{loc:Tr Overview_UnreachableHint}" Style="{StaticResource SepCaption}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- two columns: what to open on the left, who and what on the right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,28,0">
                        <!-- quick launch: the starred projects as widget cards in a responsive grid -->
                        <controls:SectionHeader Title="{loc:Tr Overview_QuickLaunch}">
                            <ui:Button Style="{StaticResource SepLinkButton}" Content="{loc:Tr Overview_SeeAll}" Command="{Binding GoMyProjectsCommand}" />
                        </controls:SectionHeader>
                        <ItemsControl ItemsSource="{Binding QuickLaunch}" ItemTemplate="{StaticResource ProjectCardTemplate}" Margin="0,0,-16,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:CardGridPanel MinItemWidth="300" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <controls:Card Margin="0,0,0,16" Padding="0">
                            <controls:Card.Style>
                                <Style TargetType="controls:Card">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MyCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:Card.Style>
                            <controls:EmptyState Symbol="Star24" Tone="Warning" Title="{loc:Tr My_EmptyTitle}" Description="{loc:Tr My_EmptyBody}" Padding="24,28">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Folder20}" Content="{loc:Tr Nav_Projects}" Command="{Binding GoProjectsCommand}" />
                            </controls:EmptyState>
                        </controls:Card>

                        <!-- recently discovered -->
                        <controls:SectionHeader Title="{loc:Tr Overview_Recent}" Margin="0,16,0,14" />
                        <Border Style="{StaticResource SepGroup}">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CompactProjectRow}" ItemsPanel="{StaticResource CompactRowsPanel}" Focusable="False" />
                                <controls:EmptyState IsCompact="True" Symbol="Clock20" Tone="Neutral" Title="{loc:Tr Overview_RecentEmptyTitle}" Description="{loc:Tr Overview_RecentEmptyHint}"
                                                     Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- online now -->
                        <TextBlock Text="{loc:Tr Overview_OnlineNow}" Style="{StaticResource SepGroupHeader}" />
                        <Border Style="{StaticResource SepGroup}" Margin="0,0,0,24">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Online}" ItemTemplate="{StaticResource CompactProjectRow}" ItemsPanel="{StaticResource CompactRowsPanel}" Focusable="False" />
                                <controls:EmptyState IsCompact="True" Symbol="People20" Tone="Neutral" Title="{loc:Tr Overview_NobodyOnlineTitle}" Description="{loc:Tr Overview_NobodyOnline}"
                                                     Visibility="{Binding Online.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=PeopleSearch20}" Content="{loc:Tr My_ProbeSessions}" Command="{Binding ProbeCommand}" Padding="10,5" />
                                </controls:EmptyState>
                            </StackPanel>
                        </Border>

                        <!-- categories -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr Overview_ByCategory}" Style="{StaticResource SideHeader}" />
                            <ui:Button Style="{StaticResource SepLinkButton}" Content="{loc:Tr Category_Manage}" Command="{Binding Actions.ManageCategoriesCommand}" HorizontalAlignment="Right" Margin="0,-6,0,-6" />
                        </Grid>
                        <controls:Card Margin="0,0,0,24" Padding="18,16,18,4">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource BarTemplate}" Focusable="False" />
                                <TextBlock Text="{loc:Tr Overview_NoProjectsYet}" Style="{StaticResource SepMuted}" Margin="0,0,0,12"
                                           Visibility="{Binding Categories.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                            </StackPanel>
                        </controls:Card>

                        <!-- status -->
                        <TextBlock Text="{loc:Tr Overview_ByStatus}" Style="{StaticResource SepGroupHeader}" />
                        <controls:Card Margin="0,0,0,24" Padding="18,16,18,4">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Statuses}" ItemTemplate="{StaticResource BarTemplate}" Focusable="False" />
                                <TextBlock Text="{loc:Tr Overview_NoProjectsYet}" Style="{StaticResource SepMuted}" Margin="0,0,0,12"
                                           Visibility="{Binding Statuses.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                            </StackPanel>
                        </controls:Card>

                        <!-- shortcuts: Settings-app rows with the sidebar's tile colours and a trailing chevron -->
                        <TextBlock Text="{loc:Tr Overview_Shortcuts}" Style="{StaticResource SepGroupHeader}" />
                        <Border Style="{StaticResource SepGroup}">
                            <controls:SeparatedStackPanel Style="{StaticResource SepGroupStack}" SeparatorInset="54">
                                <Button Style="{StaticResource SepGroupRowButton}" Command="{Binding GoPluginsCommand}" AutomationProperties.Name="{loc:Tr Nav_Plugins}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <controls:IconTile Size="Small" Symbol="PuzzlePiece20" Tone="Purple" />
                                        <TextBlock Grid.Column="1" Text="{loc:Tr Nav_Plugins}" Style="{StaticResource SepBody}" Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="13" Foreground="{DynamicResource SepText3Brush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SepGroupRowButton}" Command="{Binding GoToolsCommand}" AutomationProperties.Name="{loc:Tr Nav_Tools}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <controls:IconTile Size="Small" Symbol="Toolbox20" Tone="Info" />
                                        <TextBlock Grid.Column="1" Text="{loc:Tr Nav_Tools}" Style="{StaticResource SepBody}" Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="13" Foreground="{DynamicResource SepText3Brush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SepGroupRowButton}" Command="{Binding GoSettingsCommand}" AutomationProperties.Name="{loc:Tr Nav_Settings}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <controls:IconTile Size="Small" Symbol="Settings20" Tone="Neutral" />
                                        <TextBlock Grid.Column="1" Text="{loc:Tr Nav_Settings}" Style="{StaticResource SepBody}" Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="13" Foreground="{DynamicResource SepText3Brush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </controls:SeparatedStackPanel>
                        </Border>
                        <!-- where SEP keeps its data: a footer under the group -->
                        <StackPanel Margin="14,10,14,0">
                            <TextBlock Text="{loc:Tr Overview_DataFolder}" Style="{StaticResource SepCaption}" />
                            <TextBlock Text="{Binding DataDir}" Style="{StaticResource SepMono}" Margin="0,2,0,0" ToolTip="{Binding DataDir}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
