<Page x:Class="SEP.App.Views.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:SEP.App.Localization"
      Title="{loc:Tr Diag_PageTitle}"
      Background="#0D1117" Foreground="#FFFFFF">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{loc:Tr Diag_PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#00E5FF" VerticalAlignment="Center" FontSize="13"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding StatusMessage}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Content="{loc:Tr Diag_Rerun}" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,10,0" />
                <ui:Button Appearance="Danger" Content="{loc:Tr Diag_UnlockAll}" Command="{Binding UnlockAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- System Health Cards -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="{loc:Tr Diag_CoreMetrics}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding DiagItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="12,8" Background="#0D1117" BorderBrush="#253040" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="●" Foreground="#10B981" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Active Locks DataGrid / ListView -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#253040" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Tr Diag_LocksHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FormatConverter}">
                                <Binding Path="[Diag_LocksCountFormat]" Source="{x:Static loc:Loc.Instance}" />
                                <Binding Path="LockItems.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding LockItems}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="12,8" Background="#0D1117" BorderBrush="#253040" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Project Code -->
                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectCode}" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#00E5FF" FontSize="12" />
                                    </Border>

                                    <!-- Lock File Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontFamily="Cascadia Code" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" />

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2" Text="{Binding LockTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" />

                                    <!-- Path snippet -->
                                    <TextBlock Grid.Column="3" Text="{Binding FilePath}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Action Button -->
                                    <ui:Button Grid.Column="4" Appearance="Danger" Content="{loc:Tr Diag_UnlockButton}" Padding="12,4"
                                               Command="{Binding DataContext.UnlockSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
