<ui:FluentWindow x:Class="SEP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:pages="clr-namespace:SEP.App.Views.Pages"
        Title="{loc:Tr Main_Title}"
        Width="1260" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="/SEP.ico"
        Background="#0D1117" Foreground="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Main_Title}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cube24" Foreground="#00E5FF" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Project Pill -->
                    <Border Background="#161B22" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="#10B981" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr Main_ActiveProjectLabel}" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProjectCode}" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" Foreground="#00E5FF" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProjectStatus}" Foreground="#34D399" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- One-Click Launch Button in TitleBar -->
                    <ui:Button Grid.Column="1" Appearance="Primary" Content="{loc:Tr Main_LaunchButton}" Margin="12,0,0,0"
                               Command="{Binding LaunchActiveProjectCommand}" ToolTip="{loc:Tr Main_LaunchTooltip}" />
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Navigation View -->
        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneOpen="True" Background="#0D1117"
                           Transition="FadeInWithSlide" TransitionDuration="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Projects}" Icon="{ui:SymbolIcon Symbol=Folder24}" TargetPageType="{x:Type pages:ProjectsPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_UserAdmin}" Icon="{ui:SymbolIcon Symbol=People24}" TargetPageType="{x:Type pages:UserAdminPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Diagnostics}" Icon="{ui:SymbolIcon Symbol=HeartPulse24}" TargetPageType="{x:Type pages:DiagnosticsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Settings}" Icon="{ui:SymbolIcon Symbol=Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
