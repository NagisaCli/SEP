<ui:FluentWindow x:Class="SEP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sepsvc="clr-namespace:SEP.App.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:pages="clr-namespace:SEP.App.Views.Pages"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        Title="{loc:Tr Main_Title}"
        Width="1280" Height="840"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="{x:Static sepsvc:ThemeService.Backdrop}"
        ExtendsContentIntoTitleBar="True"
        Icon="/SEP.ico"
        FontFamily="{StaticResource SepTextFont}"
        Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Main_Title}" Height="48">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/SEP.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!-- what E3D is set up to load: presence dot (pulses while E3D runs), mode glyph, mono code, state -->
                    <Border Background="{DynamicResource SepSurfaceBrush}" BorderBrush="{DynamicResource SepCardBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SepRadiusPill}" Padding="10,4,14,4" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Margin="0,0,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource SepStatusDot}">
                                        <Setter Property="ToolTip" Value="{loc:Tr Main_E3dNotRunning}" />
                                        <Style.Triggers>
                                            <!-- one cheap opacity loop, only while E3D runs -->
                                            <DataTrigger Binding="{Binding IsE3dRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SepSuccessBrush}" />
                                                <Setter Property="ToolTip" Value="{loc:Tr Main_E3dRunning}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RunningPulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.8"
                                                                             AutoReverse="True" RepeatBehavior="Forever">
                                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RunningPulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Cube20" />
                                        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveMode}" Value="single">
                                                <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveMode}" Value="all">
                                                <Setter Property="Symbol" Value="Star20" />
                                                <Setter Property="Foreground" Value="{DynamicResource SepWarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveMode}" Value="library">
                                                <Setter Property="Symbol" Value="Library20" />
                                                <Setter Property="Foreground" Value="{DynamicResource SepInfoBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{loc:Tr Main_ActiveProjectLabel}" Foreground="{DynamicResource SepText3Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock Text="{Binding ActiveProjectCode}" FontFamily="{StaticResource SepMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource SepTextBrush}"
                                       FontSize="12" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveProjectCode}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource SepText3Brush}" Margin="8,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProjectStatus}" Foreground="{DynamicResource SepText2Brush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- launch: the hero action (accent gradient) + menu -->
                    <ui:Button Style="{StaticResource SepAccentGradientButton}" Icon="{ui:SymbolIcon Symbol=Rocket20}" Content="{loc:Tr Main_LaunchButton}" Margin="12,0,0,0" Padding="12,5"
                               Command="{Binding LaunchActiveProjectCommand}" ToolTip="{loc:Tr Main_LaunchTooltip}" />
                    <ui:DropDownButton Appearance="Secondary" Margin="4,0,0,0" Padding="6,5" ToolTip="{loc:Tr Main_LaunchMenuTooltip}" AutomationProperties.Name="{loc:Tr Main_LaunchMenuTooltip}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr Main_MenuLaunchAllMine}" Command="{Binding LaunchAllMineCommand}" Icon="{ui:SymbolIcon Symbol=Star24}" />
                                <MenuItem Header="{loc:Tr Main_MenuLaunchOnly}" Command="{Binding LaunchE3dOnlyCommand}" Icon="{ui:SymbolIcon Symbol=Play24}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneOpen="True"
                           OpenPaneLength="240" Transition="FadeInWithSlide" TransitionDuration="160">
            <!-- product block: gradient monogram, name, the E3D version SEP is set up for -->
            <ui:NavigationView.PaneHeader>
                <Grid Margin="12,6,12,18" ToolTip="{Binding E3dVersionLabel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SepIconTile}" Background="{DynamicResource SepAccentGradientBrush}">
                        <TextBlock Text="{loc:Tr Main_ProductName}" FontFamily="{StaticResource SepDisplayFont}" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource SepOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Main_ProductName}" FontFamily="{StaticResource SepDisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SepTextBrush}" />
                        <TextBlock Text="{Binding E3dVersionLabel}" Style="{StaticResource SepCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Overview}" Icon="{ui:SymbolIcon Symbol=Home24}" TargetPageType="{x:Type pages:OverviewPage}" NavigationCacheMode="Required" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Projects}" Icon="{ui:SymbolIcon Symbol=Folder24}" TargetPageType="{x:Type pages:ProjectsPage}" NavigationCacheMode="Required" />
                <ui:NavigationViewItem x:Name="NavMyProjectsItem" Content="{loc:Tr Nav_MyProjects}" Icon="{ui:SymbolIcon Symbol=Star24}" TargetPageType="{x:Type pages:MyProjectsPage}" NavigationCacheMode="Required" AllowDrop="True" Drop="NavMyProjects_Drop" DragOver="NavMyProjects_DragOver" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Plugins}" Icon="{ui:SymbolIcon Symbol=PuzzlePiece24}" TargetPageType="{x:Type pages:PluginsPage}" NavigationCacheMode="Required" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_UserAdmin}" Icon="{ui:SymbolIcon Symbol=People24}" TargetPageType="{x:Type pages:UserAdminPage}" NavigationCacheMode="Required" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Tools}" Icon="{ui:SymbolIcon Symbol=Toolbox24}" TargetPageType="{x:Type pages:ToolsPage}" NavigationCacheMode="Required" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Settings}" Icon="{ui:SymbolIcon Symbol=Settings24}" TargetPageType="{x:Type pages:SettingsPage}" NavigationCacheMode="Required" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,20" MaxWidth="520" />
    </Grid>
</ui:FluentWindow>
