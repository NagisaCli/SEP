<ui:FluentWindow x:Class="SEP.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SEP.App.Localization"
        xmlns:pages="clr-namespace:SEP.App.Views.Pages"
        xmlns:controls="clr-namespace:SEP.App.Controls"
        Title="{loc:Tr Main_Title}"
        Width="1280" Height="840"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="/SEP.ico"
        Foreground="{DynamicResource SepTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Main_Title}" Height="48">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/SEP.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <!-- what E3D is set up to load -->
                    <Border Background="{DynamicResource SepSurfaceBrush}" BorderBrush="{DynamicResource SepBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="12,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SepText3Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsE3dRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SepSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{loc:Tr Main_ActiveProjectLabel}" Foreground="{DynamicResource SepText2Brush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProjectCode}" FontFamily="{StaticResource SepMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource SepAccentBrush}" FontSize="12" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" · " Foreground="{DynamicResource SepText3Brush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProjectStatus}" Foreground="{DynamicResource SepText2Brush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- launch: primary action + menu -->
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Rocket24}" Content="{loc:Tr Main_LaunchButton}" Margin="12,0,0,0" Padding="12,5"
                               Command="{Binding LaunchActiveProjectCommand}" ToolTip="{loc:Tr Main_LaunchTooltip}" />
                    <ui:DropDownButton Appearance="Secondary" Margin="4,0,0,0" Padding="6,5" ToolTip="{loc:Tr Main_LaunchMenuTooltip}" AutomationProperties.Name="{loc:Tr Main_LaunchMenuTooltip}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr Main_MenuLaunchAllMine}" Command="{Binding LaunchAllMineCommand}" Icon="{ui:SymbolIcon Symbol=Star24}" />
                                <MenuItem Header="{loc:Tr Main_MenuLaunchOnly}" Command="{Binding LaunchE3dOnlyCommand}" Icon="{ui:SymbolIcon Symbol=Play24}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneOpen="True"
                           OpenPaneLength="220" Transition="FadeInWithSlide" TransitionDuration="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Overview}" Icon="{ui:SymbolIcon Symbol=Home24}" TargetPageType="{x:Type pages:OverviewPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Projects}" Icon="{ui:SymbolIcon Symbol=Folder24}" TargetPageType="{x:Type pages:ProjectsPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_MyProjects}" Icon="{ui:SymbolIcon Symbol=Star24}" TargetPageType="{x:Type pages:MyProjectsPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Live}" Icon="{ui:SymbolIcon Symbol=Rocket24}" TargetPageType="{x:Type pages:LivePage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Plugins}" Icon="{ui:SymbolIcon Symbol=PuzzlePiece24}" TargetPageType="{x:Type pages:PluginsPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_UserAdmin}" Icon="{ui:SymbolIcon Symbol=People24}" TargetPageType="{x:Type pages:UserAdminPage}" />
                <ui:NavigationViewItem Content="{loc:Tr Nav_Tools}" Icon="{ui:SymbolIcon Symbol=Toolbox24}" TargetPageType="{x:Type pages:ToolsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Settings}" Icon="{ui:SymbolIcon Symbol=Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,20" MaxWidth="520" />
    </Grid>
</ui:FluentWindow>
