<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SEP</AssemblyName>
    <RootNamespace>SEP.App</RootNamespace>
    <ApplicationIcon>SEP.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <Product>SEP - AVEVA E3D Project Manager</Product>
    <Company>SEP</Company>
    <Copyright>SEP</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UI strings: English lives in the main assembly (Resources/Strings.resx), Chinese in the zh-CN satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="SEP.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Visual Studio regenerates Strings.Designer.cs from Strings.resx through this custom tool. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADMIN\E3dAdmin\E3dAdmin.csproj" />
  </ItemGroup>

  <!--
    The E3D plug-in panel add-in (..\SEP.PluginPanel, net48/x86) travels inside SEP.exe; SEP deploys it into the E3D
    folder. It is built here in its own process (other target framework and platform). Where E3D is not installed
    it builds without its CAF entry point and SEP falls back to the classic ribbon.
  -->
  <PropertyGroup>
    <PluginPanelProject>$(MSBuildThisFileDirectory)..\SEP.PluginPanel\SEP.PluginPanel.csproj</PluginPanelProject>
    <PluginPanelDll>$(MSBuildThisFileDirectory)..\SEP.PluginPanel\bin\Release\net48\SEP.PluginPanel.dll</PluginPanelDll>
  </PropertyGroup>
  <Target Name="BuildPluginPanel" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(PluginPanelProject)')">
    <Exec Command="dotnet build &quot;$(PluginPanelProject)&quot; -c Release -nologo -v q" />
    <ItemGroup>
      <EmbeddedResource Include="$(PluginPanelDll)" LogicalName="SEP.PluginPanel.dll" Condition="Exists('$(PluginPanelDll)')" />
      <!-- the ribbon's own icons (scripts\Build-RibbonIcons.ps1), deployed next to the add-in -->
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\SEP.PluginPanel\Assets\SEPIcons.resources" LogicalName="SEPIcons.resources" Condition="Exists('$(MSBuildThisFileDirectory)..\SEP.PluginPanel\Assets\SEPIcons.resources')" />
    </ItemGroup>
  </Target>

</Project>
