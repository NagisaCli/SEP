<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Reusable looks built on the semantic theme brushes (SepTheme.*.xaml). -->

    <FontFamily x:Key="SepMonoFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <!-- Text -->
    <Style x:Key="SepPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SepPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SepSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SepBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SepMono" TargetType="TextBlock" BasedOn="{StaticResource SepCaption}">
        <Setter Property="FontFamily" Value="{StaticResource SepMonoFont}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="SepCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SepCardInner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- A list row that lights up on hover. -->
    <Style x:Key="SepRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SepBorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SepWell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- Avatar tile with initials -->
    <Style x:Key="SepAvatar" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SepAvatarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SepMonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="SepIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SepDangerIconButton" TargetType="ui:Button" BasedOn="{StaticResource SepIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
    </Style>
    <!-- Segmented filter buttons: the selected one gets the accent tint. -->
    <Style x:Key="SepSegment" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
    </Style>

    <!-- Tab strip used inside pages (Users | Teams) -->
    <Style x:Key="SepTabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Border x:Name="Indicator" Grid.Row="1" Background="{DynamicResource SepAccentBrush}" CornerRadius="1" Opacity="0" Margin="10,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status line at the bottom of a page -->
    <Style x:Key="SepStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
