<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:beh="clr-namespace:SEP.App.Behaviors"
                    xmlns:controls="clr-namespace:SEP.App.Controls">
    <!-- Reusable looks built on the semantic theme brushes (SepTheme.*.xaml), in the manner of a macOS Tahoe / iOS 26
         app. The rules behind them are written down in docs/DESIGN.md: brushes are DynamicResource (the theme swaps at
         run time); everything defined here is theme-independent and may be used with StaticResource. -->

    <!-- ── Fonts ─────────────────────────────────────────────────────────────────────────────────────── -->
    <!-- Segoe UI Variable on Windows 11 (Display cut for titles), plain Segoe UI wherever the variable font is missing.
         SF Pro is not bundled: its licence only allows Apple platforms. -->
    <FontFamily x:Key="SepDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SepTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SepMonoFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <!-- ── WPF-UI geometry, Apple proportions (its controls read these with DynamicResource) ─────────── -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">12</CornerRadius>
    <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>

    <!-- ── Radius & spacing tokens ───────────────────────────────────────────────────────────────────── -->
    <!-- Concentric corners: a shape inset by p inside a parent of radius R gets radius R - p. -->
    <CornerRadius x:Key="SepRadiusXL">22</CornerRadius>       <!-- the hero of a page -->
    <CornerRadius x:Key="SepRadiusL">18</CornerRadius>        <!-- cards, widgets, the sidebar pane -->
    <CornerRadius x:Key="SepRadiusGroup">14</CornerRadius>    <!-- inset grouped lists -->
    <CornerRadius x:Key="SepRadiusM">12</CornerRadius>        <!-- inner surfaces, monograms -->
    <CornerRadius x:Key="SepRadiusS">8</CornerRadius>         <!-- buttons, fields, segments -->
    <CornerRadius x:Key="SepRadiusXS">6</CornerRadius>        <!-- small tiles -->
    <CornerRadius x:Key="SepRadiusPill">999</CornerRadius>    <!-- capsules: badges, chips, capsule buttons -->
    <sys:Double x:Key="SepRadiusGroupValue">14</sys:Double>
    <sys:Double x:Key="SepSpace1">4</sys:Double>
    <sys:Double x:Key="SepSpace2">8</sys:Double>
    <sys:Double x:Key="SepSpace3">12</sys:Double>
    <sys:Double x:Key="SepSpace4">16</sys:Double>
    <sys:Double x:Key="SepSpace5">24</sys:Double>
    <sys:Double x:Key="SepSpace6">32</sys:Double>
    <sys:Double x:Key="SepSpace7">40</sys:Double>
    <!-- page frame: the header and the scrolling content share the side gutters; the scroll bar sits outside them -->
    <Thickness x:Key="SepPageHeaderMargin">40,24,40,24</Thickness>
    <Thickness x:Key="SepPageContentMargin">40,0,40,40</Thickness>
    <Thickness x:Key="SepPageStatusMargin">40,0,40,12</Thickness>
    <Thickness x:Key="SepCardPadding">18</Thickness>
    <Thickness x:Key="SepSectionGap">0,0,0,32</Thickness>
    <!-- reading width of form-like pages (Settings) -->
    <sys:Double x:Key="SepFormMaxWidth">880</sys:Double>

    <!-- the glossy top light on monograms and app tiles -->
    <LinearGradientBrush x:Key="SepGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="0.51" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Page ──────────────────────────────────────────────────────────────────────────────────────── -->
    <!-- Pages are hosted in a Frame, which stops inherited text properties: every page sets them through this. -->
    <Style x:Key="SepPage" TargetType="Page">
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SepTextFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ── Type ramp ─────────────────────────────────────────────────────────────────────────────────── -->
    <Style x:Key="SepTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SepTextFont}" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
    </Style>
    <!-- 34 Bold: the one big name or value of a screen (the overview hero) -->
    <Style x:Key="SepDisplay" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 30 Bold: large page titles -->
    <Style x:Key="SepLargeTitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepPageTitle" TargetType="TextBlock" BasedOn="{StaticResource SepLargeTitle}" />
    <!-- 20 SemiBold: hero titles, empty-state titles -->
    <Style x:Key="SepTitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 17 SemiBold, centred: the title of a sheet (dialog) -->
    <Style x:Key="SepSheetTitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 13, secondary, centred: the line under a sheet title -->
    <Style x:Key="SepSheetSubtitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
    <!-- 19 Bold: section titles between groups on a page ("Quick launch", a library's name) -->
    <Style x:Key="SepSubtitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 15 SemiBold: titles inside a card -->
    <Style x:Key="SepSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepBody" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 13, secondary label, wraps: page subtitles and explanations -->
    <Style x:Key="SepPageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SepMuted" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepCaption" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- field labels above inputs -->
    <Style x:Key="SepLabel" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- header above an inset grouped list (small, semibold, grey), and the explanation under one -->
    <Style x:Key="SepGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="Margin" Value="14,0,0,8" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepGroupFooter" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="Margin" Value="14,8,14,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- small accent line above a hero value ("E3D will load") -->
    <Style x:Key="SepEyebrow" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
    </Style>
    <!-- sidebar section header ("Workspace"): small, semibold, grey, title case -->
    <Style x:Key="SepNavSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="Margin" Value="10,16,0,5" />
    </Style>
    <Style x:Key="SepMono" TargetType="TextBlock" BasedOn="{StaticResource SepCaption}">
        <Setter Property="FontFamily" Value="{StaticResource SepMonoFont}" />
    </Style>
    <!-- widget numbers: big, bold, tabular figures so a row of counts lines up -->
    <Style x:Key="SepKpiValue" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SepNumber" TargetType="TextBlock" BasedOn="{StaticResource SepMuted}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <!-- status line at the bottom of a page -->
    <Style x:Key="SepStatusText" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Surfaces ──────────────────────────────────────────────────────────────────────────────────── -->
    <!-- page (#F2F2F7 / black) → card (white / #1C1C1E) → inner (#F2F2F7 / #2C2C2E). controls:Card adds the soft
         light-theme shadow (Generic.xaml); SepCard is the same surface as a plain Border, without it. -->
    <Style x:Key="SepCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusL}" />
        <Setter Property="Padding" Value="{StaticResource SepCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SepCardInner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusM}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- the one hero of a page: larger radius, roomier, a deeper shadow (still gradients, no effect) -->
    <Style x:Key="SepHeroCard" TargetType="controls:Card">
        <Setter Property="Background" Value="{DynamicResource SepHeroBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepHeroBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusXL}" />
        <Setter Property="Padding" Value="30,28" />
        <Setter Property="ShadowBlur" Value="34" />
        <Setter Property="ShadowOffset" Value="10" />
        <Setter Property="ShadowColor" Value="{DynamicResource SepShadowColor}" />
    </Style>

    <!-- Inset grouped list (the Settings app): a rounded container holding borderless rows; put the rows in a
         controls:SeparatedStackPanel for the inset hairlines. The clip keeps hover washes inside the corners. -->
    <Style x:Key="SepGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusGroup}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="beh:RoundedClip.Radius" Value="{StaticResource SepRadiusGroupValue}" />
    </Style>
    <!-- the separators panel inside a group: hairlines start where the row text starts (past a 26 px tile) -->
    <Style x:Key="SepGroupStack" TargetType="controls:SeparatedStackPanel">
        <Setter Property="SeparatorBrush" Value="{DynamicResource SepSeparatorBrush}" />
        <Setter Property="SeparatorInset" Value="56" />
    </Style>
    <Style x:Key="SepGroupStackPlain" TargetType="controls:SeparatedStackPanel">
        <Setter Property="SeparatorBrush" Value="{DynamicResource SepSeparatorBrush}" />
        <Setter Property="SeparatorInset" Value="16" />
    </Style>
    <!-- a row of a group: 44 px minimum, no stroke of its own -->
    <Style x:Key="SepGroupRowStatic" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- the same row, lit on hover (lists of things you act on) -->
    <Style x:Key="SepGroupRow" TargetType="Border" BasedOn="{StaticResource SepGroupRowStatic}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A free-standing list row on the page (not inside a group): a small card that lights up on hover. -->
    <Style x:Key="SepRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusGroup}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- a row nested inside a card: one step up (Surface2) so it still reads as a row -->
    <Style x:Key="SepNestedRow" TargetType="Border" BasedOn="{StaticResource SepRow}">
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusM}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SepFillHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- a row inside a card without a stroke: a grey wash on hover -->
    <Style x:Key="SepInsetRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SepFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- read-only value well (paths, commands, logs) -->
    <Style x:Key="SepWell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusS}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- a quiet row of filters / tools: no box of its own -->
    <Style x:Key="SepToolbar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- a capsule that groups rare icon actions (a toolbar group) -->
    <Style x:Key="SepTrack" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepFillBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- 1 px vertical rule between groups of tool buttons -->
    <Style x:Key="SepToolSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,7" />
        <Setter Property="Background" Value="{DynamicResource SepSeparatorBrush}" />
    </Style>
    <!-- horizontal hairline (in a card, between blocks) -->
    <Style x:Key="SepHairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SepSeparatorBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Icon tile for arbitrary content (an image, the app mark); controls:IconTile is the symbol + tone version. -->
    <Style x:Key="SepIconTile" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SepTileBlueBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- Monogram: project code / initials, white on the item's colour. Give it the glossy gradient
         (PaletteGradientConverter) as Background and a SepAvatarGloss border inside for the top light. -->
    <Style x:Key="SepAvatar" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SepAvatarGloss" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SepGlossBrush}" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="BorderThickness" Value="0.75" />
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="SepAvatarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SepDisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Tag chip: a grey capsule (data); states are dot + text (controls:Badge IsPlain) -->
    <Style x:Key="SepChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepFillBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2,5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SepChipText" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Status dot (8 px). Set Fill to the tone brush; SepStatusDot alone is the neutral / unknown state. -->
    <Style x:Key="SepStatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Keyboard focus ring for the custom-templated controls: systemBlue, outside the control -->
    <Style x:Key="SepFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2.5" BorderBrush="{DynamicResource SepTintBrush}" Opacity="0.6" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────────────────────────────────────────────── -->
    <!-- Every WPF-UI button presses in to 97 % (Primary = solid accent, Secondary = borderless grey: SepTheme keys). -->
    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- borderless icon button: grey wash on hover, presses in -->
    <Style x:Key="SepIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SepDangerIconButton" TargetType="ui:Button" BasedOn="{StaticResource SepIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- small text button in the accent colour ("See all", "Manage", "Dismiss all") -->
    <Style x:Key="SepLinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Capsule buttons: the main action of a hero or a sheet. Primary = solid accent, white text. -->
    <Style x:Key="SepCapsuleButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusPill}" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SepCapsuleSecondaryButton" TargetType="ui:Button" BasedOn="{StaticResource SepCapsuleButton}">
        <Setter Property="Appearance" Value="Secondary" />
    </Style>
    <!-- Tinted capsule (iOS "tinted" button): accent text on a soft accent wash. Quiet actions repeated on cards. -->
    <Style x:Key="SepTintedButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Background" Value="{DynamicResource SepAccentSoftBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource SepAccentSoftHoverBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource SepAccentSoftHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource SepAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SepRadiusPill}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Segment of a controls:SegmentedPanel (a RadioButton): the panel draws the track and the sliding thumb; the
         segment is only its label, secondary when off, primary and semibold when checked. -->
    <Style x:Key="SepSegmentItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource SepTextFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SepFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Clickable widget (overview tiles, shortcut cards): a soft-shadowed card that rises 2 px on hover (only the inner
         card moves, so the hit area stays put) and presses in to 97 %. -->
    <Style x:Key="SepTileButton" TargetType="Button">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SepFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <controls:Card x:Name="Card" Padding="0" ShadowBlur="22" ShadowOffset="6">
                            <controls:Card.RenderTransform>
                                <TranslateTransform x:Name="Lift" Y="0" />
                            </controls:Card.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </controls:Card>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- brushes stay trigger setters; only the transform is animated -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
                            <Setter TargetName="Card" Property="ShadowColor" Value="{DynamicResource SepShadowHoverColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><beh:SpringEase /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><beh:SpringEase /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SepSurfacePressedBrush}" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row button inside a group (shortcuts, navigation rows): full-width, hover wash, trailing chevron added by the
         caller. Template-free look so the group's separators stay visible. -->
    <Style x:Key="SepGroupRowButton" TargetType="Button">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SepSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SepSurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SepAccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keycap ("Ctrl K") -->
    <Style x:Key="SepKbd" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepFillBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="5,1,5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SepKbdText" TargetType="TextBlock" BasedOn="{StaticResource SepTextBase}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
    </Style>

    <!-- Sidebar search field: looks like a search box on the glass, opens the project search (Ctrl+K) -->
    <Style x:Key="SepSearchFieldButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource SepText3Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SepFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Field" Background="{DynamicResource SepSearchFieldBrush}" CornerRadius="10" Padding="10,0,6,0" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource SepFillHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource SepFillPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The E3D session card inside the glass sidebar: a lighter glass layer, concentric with the pane (18 - 8 = 10) -->
    <Style x:Key="SepSidebarCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SepSidebarCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepSidebarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- kept for older markup: the same glass card -->
    <Style x:Key="SepGlassPanel" TargetType="Border" BasedOn="{StaticResource SepSidebarCard}" />

    <!-- ── Switch: Apple style (white knob on a grey / systemBlue capsule) ───────────────────────────── -->
    <!-- The triggers set the final state at once; beh:ToggleMotion plays the slide and the fade on a real toggle only,
         so a page full of switches never animates when it is filled. Command, IsChecked bindings and content work as
         on any ToggleButton. -->
    <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Switch" Width="40" Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border CornerRadius="12" Background="{DynamicResource SepSwitchOffBrush}" />
                            <Border x:Name="TrackOn" CornerRadius="12" Background="{DynamicResource SepTintBrush}" Opacity="0" beh:ToggleMotion.Fade="True" />
                            <Grid x:Name="Knob" Width="20" Height="20" Margin="2" HorizontalAlignment="Left" beh:ToggleMotion.Slide="16">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <!-- two soft rings under the knob instead of an effect -->
                                <Ellipse Fill="#14000000" Margin="-1,0,-1,-2" />
                                <Ellipse Fill="#24000000" Margin="0,0.5,0,-1" />
                                <Ellipse Fill="#FFFFFF" />
                            </Grid>
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource SepTextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Switch" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toasts: a rounded banner on the popover material, the symbol tinted by the outcome ─────────── -->
    <!-- Same parts and slide-in as WPF-UI's own template (TemplateButtonCommand, SlideTransform, IsShown). The shadow is
         an effect on an empty layer behind the banner (one transient surface, so allowed; the text keeps ClearType). -->
    <Style TargetType="{x:Type ui:Snackbar}">
        <Setter Property="Foreground" Value="{DynamicResource SnackBarForeground}" />
        <Setter Property="ContentForeground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="Background" Value="{DynamicResource SnackBarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SnackBarBorderBrush}" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Snackbar}">
                    <Grid x:Name="CardBorderContainer" Margin="0,0,0,-200" Opacity="0">
                        <Grid VerticalAlignment="Bottom" RenderTransform="{TemplateBinding SlideTransform}" Visibility="{TemplateBinding Visibility}">
                            <Border CornerRadius="16" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="CardBorder" MinHeight="{TemplateBinding MinHeight}" Padding="14,11" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="CardIcon" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Content="{TemplateBinding Icon}"
                                                      TextElement.FontSize="24" TextElement.Foreground="{DynamicResource SepAccentBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="TitleContentPresenter" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleTemplate}"
                                                          TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                          TextElement.FontSize="13" TextElement.Foreground="{TemplateBinding ContentForeground}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </StackPanel>
                                    <ui:Button x:Name="CloseButton" Grid.Column="2" Margin="10,0,-4,0" Padding="5" Appearance="Transparent" VerticalAlignment="Center"
                                               Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SepText3Brush}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss16" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Appearance" Value="Success">
                            <Setter TargetName="CardIcon" Property="TextElement.Foreground" Value="{DynamicResource SepSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Caution">
                            <Setter TargetName="CardIcon" Property="TextElement.Foreground" Value="{DynamicResource SepWarningBrush}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Danger">
                            <Setter TargetName="CardIcon" Property="TextElement.Foreground" Value="{DynamicResource SepDangerBrush}" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="CardIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsCloseButtonEnabled" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsShown" Value="True">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="CardBorderContainer" Storyboard.TargetProperty="Margin" From="0,0,0,-120" To="0" Duration="0:0:0.34">
                                            <ThicknessAnimation.EasingFunction><beh:SpringEase /></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardBorderContainer" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="CardBorderContainer" Storyboard.TargetProperty="Margin" From="0" To="0,0,0,-120" Duration="0:0:0.26">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardBorderContainer" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Tooltips: a small rounded popover ─────────────────────────────────────────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
        <Setter Property="Background" Value="{DynamicResource ToolTipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SepTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ui:EffectThicknessDecorator Thickness="14">
                        <Grid MaxWidth="420">
                            <!-- the shadow comes from an empty layer, so the text keeps ClearType -->
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#000000" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="9,5" SnapsToDevicePixels="True">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                    </ui:EffectThicknessDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
