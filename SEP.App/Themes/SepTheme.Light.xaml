<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme, modelled on macOS / iOS: a light grey page, white grouped cards with a hairline, a floating white
         sidebar, Apple's system colours, and one blue for actions. Same keys as SepTheme.Dark.xaml; ThemeService swaps
         them at run time. Text tones are the accessible variants so small text keeps 4.5:1. -->

    <!-- surfaces -->
    <Color x:Key="SepPageColor">#F5F5F7</Color>
    <Color x:Key="SepSurfaceColor">#FFFFFF</Color>
    <Color x:Key="SepSurface2Color">#F5F5F7</Color>
    <Color x:Key="SepSurfaceHoverColor">#F7F7F9</Color>
    <Color x:Key="SepSurfacePressedColor">#EDEDF0</Color>
    <!-- segmented controls: the grey track and the raised white segment -->
    <Color x:Key="SepTrackColor">#E9E9EC</Color>
    <Color x:Key="SepSegmentColor">#FFFFFF</Color>
    <!-- tray: the area a card list sits in inside a group card -->
    <Color x:Key="SepTrayColor">#F5F5F7</Color>
    <Color x:Key="SepInputColor">#FFFFFF</Color>
    <!-- sidebar (a floating white panel on the page) -->
    <Color x:Key="SepSidebarColor">#FFFFFF</Color>
    <Color x:Key="SepSidebarBorderColor">#E3E3E8</Color>
    <Color x:Key="SepSidebarHoverColor">#F0F0F3</Color>
    <Color x:Key="SepSearchFieldColor">#EFEFF2</Color>

    <!-- strokes: hairlines only -->
    <Color x:Key="SepBorderColor">#E5E5EA</Color>
    <Color x:Key="SepBorderStrongColor">#D1D1D6</Color>
    <Color x:Key="SepDividerColor">#EBEBEF</Color>

    <!-- text: Apple label / secondary label / tertiary label -->
    <Color x:Key="SepTextColor">#1D1D1F</Color>
    <Color x:Key="SepText2Color">#5E5E63</Color>
    <Color x:Key="SepText3Color">#6E6E73</Color>

    <!-- accent: Apple blue (text and fills keep 4.5:1 against white) -->
    <Color x:Key="SepAccentColor">#0066CC</Color>
    <Color x:Key="SepAccentStrongColor">#0071E3</Color>
    <Color x:Key="SepAccentHoverColor">#0077ED</Color>
    <Color x:Key="SepAccentPressedColor">#0068D1</Color>
    <Color x:Key="SepAccentSoftColor">#E8F1FD</Color>
    <Color x:Key="SepOnAccentColor">#FFFFFF</Color>

    <!-- tones: accessible text colour + its soft tint -->
    <Color x:Key="SepSuccessColor">#1E7F3A</Color>
    <Color x:Key="SepSuccessSoftColor">#E3F5E8</Color>
    <Color x:Key="SepWarningColor">#B25000</Color>
    <Color x:Key="SepWarningSoftColor">#FFF1E0</Color>
    <Color x:Key="SepDangerColor">#D70015</Color>
    <Color x:Key="SepDangerSoftColor">#FFE7E8</Color>
    <Color x:Key="SepInfoColor">#0071A4</Color>
    <Color x:Key="SepInfoSoftColor">#E3F3FA</Color>
    <!-- presence (who is online) -->
    <Color x:Key="SepPurpleColor">#8944AB</Color>
    <Color x:Key="SepPurpleSoftColor">#F4EAFA</Color>

    <SolidColorBrush x:Key="SepPageBrush" Color="{StaticResource SepPageColor}" />
    <SolidColorBrush x:Key="SepSurfaceBrush" Color="{StaticResource SepSurfaceColor}" />
    <SolidColorBrush x:Key="SepSurface2Brush" Color="{StaticResource SepSurface2Color}" />
    <SolidColorBrush x:Key="SepSurfaceHoverBrush" Color="{StaticResource SepSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SepSurfacePressedBrush" Color="{StaticResource SepSurfacePressedColor}" />
    <SolidColorBrush x:Key="SepTrackBrush" Color="{StaticResource SepTrackColor}" />
    <SolidColorBrush x:Key="SepSegmentBrush" Color="{StaticResource SepSegmentColor}" />
    <SolidColorBrush x:Key="SepTrayBrush" Color="{StaticResource SepTrayColor}" />
    <SolidColorBrush x:Key="SepInputBrush" Color="{StaticResource SepInputColor}" />
    <SolidColorBrush x:Key="SepSidebarBrush" Color="{StaticResource SepSidebarColor}" />
    <SolidColorBrush x:Key="SepSidebarBorderBrush" Color="{StaticResource SepSidebarBorderColor}" />
    <SolidColorBrush x:Key="SepSidebarHoverBrush" Color="{StaticResource SepSidebarHoverColor}" />
    <SolidColorBrush x:Key="SepSearchFieldBrush" Color="{StaticResource SepSearchFieldColor}" />
    <SolidColorBrush x:Key="SepBorderBrush" Color="{StaticResource SepBorderColor}" />
    <SolidColorBrush x:Key="SepBorderStrongBrush" Color="{StaticResource SepBorderStrongColor}" />
    <SolidColorBrush x:Key="SepDividerBrush" Color="{StaticResource SepDividerColor}" />
    <SolidColorBrush x:Key="SepCardBorderBrush" Color="{StaticResource SepBorderColor}" />
    <SolidColorBrush x:Key="SepTextBrush" Color="{StaticResource SepTextColor}" />
    <SolidColorBrush x:Key="SepText2Brush" Color="{StaticResource SepText2Color}" />
    <SolidColorBrush x:Key="SepText3Brush" Color="{StaticResource SepText3Color}" />
    <SolidColorBrush x:Key="SepAccentBrush" Color="{StaticResource SepAccentColor}" />
    <SolidColorBrush x:Key="SepAccentStrongBrush" Color="{StaticResource SepAccentStrongColor}" />
    <SolidColorBrush x:Key="SepAccentHoverBrush" Color="{StaticResource SepAccentHoverColor}" />
    <SolidColorBrush x:Key="SepAccentPressedBrush" Color="{StaticResource SepAccentPressedColor}" />
    <SolidColorBrush x:Key="SepAccentSoftBrush" Color="{StaticResource SepAccentSoftColor}" />
    <SolidColorBrush x:Key="SepOnAccentBrush" Color="{StaticResource SepOnAccentColor}" />
    <SolidColorBrush x:Key="SepSuccessBrush" Color="{StaticResource SepSuccessColor}" />
    <SolidColorBrush x:Key="SepSuccessSoftBrush" Color="{StaticResource SepSuccessSoftColor}" />
    <SolidColorBrush x:Key="SepWarningBrush" Color="{StaticResource SepWarningColor}" />
    <SolidColorBrush x:Key="SepWarningSoftBrush" Color="{StaticResource SepWarningSoftColor}" />
    <SolidColorBrush x:Key="SepDangerBrush" Color="{StaticResource SepDangerColor}" />
    <SolidColorBrush x:Key="SepDangerSoftBrush" Color="{StaticResource SepDangerSoftColor}" />
    <SolidColorBrush x:Key="SepInfoBrush" Color="{StaticResource SepInfoColor}" />
    <SolidColorBrush x:Key="SepInfoSoftBrush" Color="{StaticResource SepInfoSoftColor}" />
    <SolidColorBrush x:Key="SepPurpleBrush" Color="{StaticResource SepPurpleColor}" />
    <SolidColorBrush x:Key="SepPurpleSoftBrush" Color="{StaticResource SepPurpleSoftColor}" />

    <!-- "Get" capsule (the App Store button): grey capsule, blue bold label. Quiet actions repeated on every card. -->
    <SolidColorBrush x:Key="SepCapsuleBrush" Color="#EEEEF1" />
    <SolidColorBrush x:Key="SepCapsuleHoverBrush" Color="#E4E4E8" />
    <SolidColorBrush x:Key="SepCapsulePressedBrush" Color="#DADADF" />

    <!-- The one main action of a screen: Apple blue with the faint top-light of a macOS default button. -->
    <LinearGradientBrush x:Key="SepAccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A80EC" Offset="0" />
        <GradientStop Color="#0071E3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SepAccentGradientHoverBrush" Color="#0077ED" />
    <SolidColorBrush x:Key="SepAccentGradientPressedBrush" Color="#0068D1" />

    <!-- Hero (the overview's "E3D will load" card): a plain white card, like an App Store feature tile -->
    <SolidColorBrush x:Key="SepHeroBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SepHeroBorderBrush" Color="#E5E5EA" />

    <!-- Icon tiles: Apple system colours with the slight top-light of an app icon, white glyph on top -->
    <LinearGradientBrush x:Key="SepTileAccentBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2B8CFF" Offset="0" /><GradientStop Color="#0A74F0" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileSuccessBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#45CF68" Offset="0" /><GradientStop Color="#2BB552" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileWarningBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFA51F" Offset="0" /><GradientStop Color="#F98A00" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileDangerBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5147" Offset="0" /><GradientStop Color="#EE3026" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileInfoBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3EBCF0" Offset="0" /><GradientStop Color="#1FA2DC" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTilePurpleBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#BE6BE8" Offset="0" /><GradientStop Color="#A447D4" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileNeutralBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#9C9CA2" Offset="0" /><GradientStop Color="#85858B" Offset="1" /></LinearGradientBrush>

    <!-- ── WPF-UI controls take the same look (keys resolved after WPF-UI's own dictionaries) ───────────── -->
    <!-- Primary: solid Apple blue -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0071E3" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0077ED" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0068D1" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
    <!-- Secondary: grey fill, no visible border -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#EBEBEF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E2E7" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8D8DD" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#1D1D1F" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1D1D1F" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#14000000" />
    <!-- inputs: white field, hairline -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#D9D9DE" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#EBEBEF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E2E2E7" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#EBEBEF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
</ResourceDictionary>
