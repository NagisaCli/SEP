<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Aurora" dark theme. Pages reference the *Brush keys with DynamicResource so the light theme
         (SepTheme.Light.xaml) can be swapped in at run time; every key here exists there too.
         Layers, darkest first: chrome (window + sidebar) < page canvas < card < inner < hover. Cards carry a
         glass edge (lighter along the top), the accent is a violet-to-indigo gradient, glows are violet + cyan. -->

    <!-- surfaces -->
    <Color x:Key="SepChromeColor">#07080C</Color>
    <Color x:Key="SepPageColor">#0D0F15</Color>
    <Color x:Key="SepSurfaceColor">#13161F</Color>
    <Color x:Key="SepSurface2Color">#191D28</Color>
    <Color x:Key="SepSurfaceHoverColor">#1B1F2B</Color>
    <Color x:Key="SepSurfacePressedColor">#161922</Color>
    <!-- segmented controls: the track and the raised selected segment -->
    <Color x:Key="SepTrackColor">#0A0C11</Color>
    <Color x:Key="SepSegmentColor">#242938</Color>
    <!-- tray: the recessed area a card list sits in inside a group card -->
    <Color x:Key="SepTrayColor">#0F1219</Color>
    <Color x:Key="SepInputColor">#0B0D12</Color>
    <!-- navigation (sidebar on the chrome) -->
    <Color x:Key="SepNavHoverColor">#131620</Color>
    <Color x:Key="SepNavActiveColor">#1A1838</Color>

    <!-- strokes -->
    <Color x:Key="SepBorderColor">#222736</Color>
    <Color x:Key="SepBorderStrongColor">#353C50</Color>
    <Color x:Key="SepDividerColor">#1B1F2B</Color>
    <!-- dark: the card edge is the lit TOP of the glass edge -->
    <Color x:Key="SepCardEdgeColor">#30374A</Color>

    <!-- text: Text3 keeps 4.5:1 on Surface2 -->
    <Color x:Key="SepTextColor">#EEF0F6</Color>
    <Color x:Key="SepText2Color">#A3AABA</Color>
    <Color x:Key="SepText3Color">#7D8597</Color>

    <!-- accent: violet text/icons on dark, a deeper violet fill that keeps white text at 4.5:1 -->
    <Color x:Key="SepAccentColor">#A99BFF</Color>
    <Color x:Key="SepAccentStrongColor">#6D5DFC</Color>
    <Color x:Key="SepAccentSoftColor">#1D1A3B</Color>
    <Color x:Key="SepAccentEdgeColor">#3A3378</Color>
    <Color x:Key="SepOnAccentColor">#FFFFFF</Color>
    <!-- second hue of the aurora (gradients, glows, the blueprint grid) -->
    <Color x:Key="SepAccent2Color">#22D3EE</Color>

    <!-- tones (strong / soft / edge) -->
    <Color x:Key="SepSuccessColor">#34D399</Color>
    <Color x:Key="SepSuccessSoftColor">#0D2A22</Color>
    <Color x:Key="SepSuccessEdgeColor">#165A44</Color>
    <Color x:Key="SepWarningColor">#FBBF24</Color>
    <Color x:Key="SepWarningSoftColor">#2D2410</Color>
    <Color x:Key="SepWarningEdgeColor">#5E4914</Color>
    <Color x:Key="SepDangerColor">#FB7185</Color>
    <Color x:Key="SepDangerSoftColor">#34151E</Color>
    <Color x:Key="SepDangerEdgeColor">#6B2434</Color>
    <Color x:Key="SepInfoColor">#60A5FA</Color>
    <Color x:Key="SepInfoSoftColor">#12223B</Color>
    <Color x:Key="SepInfoEdgeColor">#1F427A</Color>
    <!-- "Purple" is the presence tone (who is online); pink, so it never reads as the violet accent -->
    <Color x:Key="SepPurpleColor">#F472B6</Color>
    <Color x:Key="SepPurpleSoftColor">#34142B</Color>
    <Color x:Key="SepPurpleEdgeColor">#6A2453</Color>
    <Color x:Key="SepNeutralEdgeColor">#2A3040</Color>

    <SolidColorBrush x:Key="SepChromeBrush" Color="{StaticResource SepChromeColor}" />
    <SolidColorBrush x:Key="SepPageBrush" Color="{StaticResource SepPageColor}" />
    <SolidColorBrush x:Key="SepSurfaceBrush" Color="{StaticResource SepSurfaceColor}" />
    <SolidColorBrush x:Key="SepSurface2Brush" Color="{StaticResource SepSurface2Color}" />
    <SolidColorBrush x:Key="SepSurfaceHoverBrush" Color="{StaticResource SepSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SepSurfacePressedBrush" Color="{StaticResource SepSurfacePressedColor}" />
    <SolidColorBrush x:Key="SepTrackBrush" Color="{StaticResource SepTrackColor}" />
    <SolidColorBrush x:Key="SepSegmentBrush" Color="{StaticResource SepSegmentColor}" />
    <SolidColorBrush x:Key="SepTrayBrush" Color="{StaticResource SepTrayColor}" />
    <SolidColorBrush x:Key="SepInputBrush" Color="{StaticResource SepInputColor}" />
    <SolidColorBrush x:Key="SepNavHoverBrush" Color="{StaticResource SepNavHoverColor}" />
    <SolidColorBrush x:Key="SepBorderBrush" Color="{StaticResource SepBorderColor}" />
    <SolidColorBrush x:Key="SepBorderStrongBrush" Color="{StaticResource SepBorderStrongColor}" />
    <SolidColorBrush x:Key="SepDividerBrush" Color="{StaticResource SepDividerColor}" />
    <SolidColorBrush x:Key="SepCardEdgeBrush" Color="{StaticResource SepCardEdgeColor}" />
    <SolidColorBrush x:Key="SepTextBrush" Color="{StaticResource SepTextColor}" />
    <SolidColorBrush x:Key="SepText2Brush" Color="{StaticResource SepText2Color}" />
    <SolidColorBrush x:Key="SepText3Brush" Color="{StaticResource SepText3Color}" />
    <SolidColorBrush x:Key="SepAccentBrush" Color="{StaticResource SepAccentColor}" />
    <SolidColorBrush x:Key="SepAccentStrongBrush" Color="{StaticResource SepAccentStrongColor}" />
    <SolidColorBrush x:Key="SepAccentSoftBrush" Color="{StaticResource SepAccentSoftColor}" />
    <SolidColorBrush x:Key="SepAccentEdgeBrush" Color="{StaticResource SepAccentEdgeColor}" />
    <SolidColorBrush x:Key="SepAccent2Brush" Color="{StaticResource SepAccent2Color}" />
    <SolidColorBrush x:Key="SepOnAccentBrush" Color="{StaticResource SepOnAccentColor}" />
    <SolidColorBrush x:Key="SepSuccessBrush" Color="{StaticResource SepSuccessColor}" />
    <SolidColorBrush x:Key="SepSuccessSoftBrush" Color="{StaticResource SepSuccessSoftColor}" />
    <SolidColorBrush x:Key="SepSuccessEdgeBrush" Color="{StaticResource SepSuccessEdgeColor}" />
    <SolidColorBrush x:Key="SepWarningBrush" Color="{StaticResource SepWarningColor}" />
    <SolidColorBrush x:Key="SepWarningSoftBrush" Color="{StaticResource SepWarningSoftColor}" />
    <SolidColorBrush x:Key="SepWarningEdgeBrush" Color="{StaticResource SepWarningEdgeColor}" />
    <SolidColorBrush x:Key="SepDangerBrush" Color="{StaticResource SepDangerColor}" />
    <SolidColorBrush x:Key="SepDangerSoftBrush" Color="{StaticResource SepDangerSoftColor}" />
    <SolidColorBrush x:Key="SepDangerEdgeBrush" Color="{StaticResource SepDangerEdgeColor}" />
    <SolidColorBrush x:Key="SepInfoBrush" Color="{StaticResource SepInfoColor}" />
    <SolidColorBrush x:Key="SepInfoSoftBrush" Color="{StaticResource SepInfoSoftColor}" />
    <SolidColorBrush x:Key="SepInfoEdgeBrush" Color="{StaticResource SepInfoEdgeColor}" />
    <SolidColorBrush x:Key="SepPurpleBrush" Color="{StaticResource SepPurpleColor}" />
    <SolidColorBrush x:Key="SepPurpleSoftBrush" Color="{StaticResource SepPurpleSoftColor}" />
    <SolidColorBrush x:Key="SepPurpleEdgeBrush" Color="{StaticResource SepPurpleEdgeColor}" />
    <SolidColorBrush x:Key="SepNeutralEdgeBrush" Color="{StaticResource SepNeutralEdgeColor}" />

    <!-- Glass edge: lit along the top, settling into the border colour. Every card-like surface uses it; no effect needed. -->
    <LinearGradientBrush x:Key="SepCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SepCardEdgeColor}" Offset="0" />
        <GradientStop Color="{StaticResource SepBorderColor}" Offset="0.35" />
        <GradientStop Color="#1D2130" Offset="1" />
    </LinearGradientBrush>
    <!-- the inset content canvas next to the sidebar -->
    <LinearGradientBrush x:Key="SepCanvasBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#232838" Offset="0" />
        <GradientStop Color="#161924" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent gradient: hero actions, Primary buttons, the logo, the active nav indicator. White text stays >= 4.5:1. -->
    <LinearGradientBrush x:Key="SepAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7457FF" Offset="0" />
        <GradientStop Color="#3E63F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SepAccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8268FF" Offset="0" />
        <GradientStop Color="#5274F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SepAccentGradientPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6046EE" Offset="0" />
        <GradientStop Color="#3455DB" Offset="1" />
    </LinearGradientBrush>
    <!-- vertical violet -> cyan bar (active nav item, hero stripe) -->
    <LinearGradientBrush x:Key="SepAuroraBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <!-- horizontal aurora line (top edge of hero and KPI tiles) -->
    <LinearGradientBrush x:Key="SepAuroraLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A78BFA" Offset="0" />
        <GradientStop Color="#C0A78BFA" Offset="0.3" />
        <GradientStop Color="#A022D3EE" Offset="0.7" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </LinearGradientBrush>
    <!-- active navigation pill: violet wash fading to the right -->
    <LinearGradientBrush x:Key="SepNavActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2A2360" Offset="0" />
        <GradientStop Color="#171630" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SepNavActiveBorderBrush" Color="#2F2A66" />

    <!-- Aurora glows behind the top of the canvas and inside the hero (radial, alpha baked in) -->
    <RadialGradientBrush x:Key="SepGlowPrimaryBrush">
        <GradientStop Color="#476D5DFC" Offset="0" />
        <GradientStop Color="#186D5DFC" Offset="0.5" />
        <GradientStop Color="#006D5DFC" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SepGlowSecondaryBrush">
        <GradientStop Color="#3022D3EE" Offset="0" />
        <GradientStop Color="#0E22D3EE" Offset="0.5" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>
    <!-- blueprint grid line colour (an E3D-ish drafting grid; drawn by SepGridBrush in SepStyles) -->
    <Color x:Key="SepGridLineColor">#0CFFFFFF</Color>
    <SolidColorBrush x:Key="SepGridLineBrush" Color="{StaticResource SepGridLineColor}" />
    <!-- 28 px drafting grid, tiled behind the top of the canvas and inside the hero -->
    <DrawingBrush x:Key="SepGridBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0.5,0 L0.5,28 M0,0.5 L28,0.5">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource SepGridLineBrush}" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Hero surface: deep indigo night with the accent bleeding in from the top left -->
    <LinearGradientBrush x:Key="SepHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C1846" Offset="0" />
        <GradientStop Color="#13152A" Offset="0.5" />
        <GradientStop Color="#0F1420" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SepHeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5A4FC8" Offset="0" />
        <GradientStop Color="#2A2E58" Offset="0.45" />
        <GradientStop Color="#1C4D5C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SepHeroLineBrush" Color="#33A99BFF" />

    <!-- ── WPF-UI controls take the same look (keys resolved after WPF-UI's own dictionaries) ───────────── -->
    <!-- Primary buttons: the accent gradient with white text -->
    <LinearGradientBrush x:Key="AccentButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7457FF" Offset="0" />
        <GradientStop Color="#3E63F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8268FF" Offset="0" />
        <GradientStop Color="#5274F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6046EE" Offset="0" />
        <GradientStop Color="#3455DB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6E8FF" />
    <!-- Secondary buttons: a raised glass chip -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#1A1E29" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#222736" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#171A24" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#E4E7F0" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343B50" Offset="0" />
        <GradientStop Color="#262B3B" Offset="0.4" />
        <GradientStop Color="#222736" Offset="1" />
    </LinearGradientBrush>
    <!-- inputs -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#0B0D12" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#10131A" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#090A0F" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1A1E29" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#222736" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#1A1E29" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#151822" />
</ResourceDictionary>
