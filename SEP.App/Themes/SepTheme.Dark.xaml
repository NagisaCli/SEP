<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme, modelled on macOS Tahoe / iOS 26 dark mode: a black grouped background, #1C1C1E cards, #2C2C2E
         inner surfaces, white labels with grey secondary labels, Apple's system colours, and one blue for actions.
         Depth comes from lighter surfaces, never from shadows (SepShadow* are transparent here).
         Every key here exists in SepTheme.Light.xaml; pages reference the *Brush keys with DynamicResource so
         ThemeService can swap the dictionary at run time. Small coloured text uses the increased-contrast variants
         (checked to >= 4.5:1 on #000000, #1C1C1E and #2C2C2E). -->

    <!-- ── Surfaces ────────────────────────────────────────────────────────────────────────────────── -->
    <!-- behind the floating sidebar where Mica is unavailable (Windows 10, Remote Desktop, SEP_NO_MICA=1) -->
    <Color x:Key="SepWindowColor">#1A1A1C</Color>
    <!-- grouped background of the content area (systemGroupedBackground) -->
    <Color x:Key="SepPageColor">#000000</Color>
    <!-- cards and grouped rows (secondarySystemGroupedBackground) -->
    <Color x:Key="SepSurfaceColor">#1C1C1E</Color>
    <!-- inner surfaces inside a card: wells, nested panels (tertiarySystemGroupedBackground) -->
    <Color x:Key="SepSurface2Color">#2C2C2E</Color>
    <Color x:Key="SepSurfaceHoverColor">#252527</Color>
    <Color x:Key="SepSurfacePressedColor">#2C2C2E</Color>
    <!-- grey fills: secondary buttons, chips, icon-button hover (white at 10 / 14 / 18 %) -->
    <Color x:Key="SepFillColor">#1AFFFFFF</Color>
    <Color x:Key="SepFillHoverColor">#24FFFFFF</Color>
    <Color x:Key="SepFillPressedColor">#2EFFFFFF</Color>
    <!-- segmented control: track (tertiarySystemFill) and the raised thumb -->
    <Color x:Key="SepTrackColor">#3D767680</Color>
    <Color x:Key="SepSegmentColor">#636366</Color>
    <!-- recessed area inside a card (drop hints, empty group trays) -->
    <Color x:Key="SepTrayColor">#141416</Color>
    <!-- text fields: translucent so they sit on the page, a card or a sheet alike -->
    <Color x:Key="SepInputColor">#12FFFFFF</Color>
    <!-- dialogs (sheets) and the grouped form rows inside them: the elevated variants -->
    <Color x:Key="SepSheetColor">#1C1C1E</Color>
    <Color x:Key="SepSheetGroupColor">#2C2C2E</Color>
    <!-- menus, drop-downs, tooltips, toasts -->
    <Color x:Key="SepPopupColor">#2C2C2E</Color>
    <Color x:Key="SepPopupBorderColor">#24FFFFFF</Color>

    <!-- ── Sidebar glass (Mica shows through) ────────────────────────────────────────────────────────── -->
    <Color x:Key="SepSidebarColor">#14FFFFFF</Color>
    <Color x:Key="SepSidebarBorderColor">#1FFFFFFF</Color>
    <Color x:Key="SepSidebarHoverColor">#14FFFFFF</Color>
    <!-- the selected row while the window is in the background: grey instead of blue (macOS) -->
    <Color x:Key="SepSidebarSelectedInactiveColor">#26FFFFFF</Color>
    <!-- the E3D session card inside the sidebar -->
    <Color x:Key="SepSidebarCardColor">#12FFFFFF</Color>
    <Color x:Key="SepSearchFieldColor">#17FFFFFF</Color>
    <!-- hairline on the content area's left edge, against the Mica strip -->
    <Color x:Key="SepContentEdgeColor">#14FFFFFF</Color>

    <!-- ── Strokes ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- separators between grouped rows (opaqueSeparator) -->
    <Color x:Key="SepSeparatorColor">#38383A</Color>
    <Color x:Key="SepDividerColor">#38383A</Color>
    <!-- hairlines of wells, chips and fields; the strong one for hover outlines and dashed drop zones -->
    <Color x:Key="SepBorderColor">#24FFFFFF</Color>
    <Color x:Key="SepBorderStrongColor">#47FFFFFF</Color>

    <!-- ── Labels ──────────────────────────────────────────────────────────────────────────────────── -->
    <Color x:Key="SepTextColor">#FFFFFF</Color>
    <!-- secondary label: >= 5.1:1 up to #3A3A3C -->
    <Color x:Key="SepText2Color">#AEAEB2</Color>
    <!-- tertiary label (captions, counts, placeholders): >= 4.8:1 up to #2C2C2E -->
    <Color x:Key="SepText3Color">#98989F</Color>

    <!-- ── Accent: systemBlue ──────────────────────────────────────────────────────────────────────── -->
    <!-- accent text and glyphs: the increased-contrast systemBlue -->
    <Color x:Key="SepAccentColor">#409CFF</Color>
    <!-- fills that carry white text (Primary buttons, the selected sidebar row): 4.7:1 with white -->
    <Color x:Key="SepAccentStrongColor">#0071E3</Color>
    <Color x:Key="SepAccentHoverColor">#0068D6</Color>
    <Color x:Key="SepAccentPressedColor">#005BBF</Color>
    <!-- tint behind accent text (tinted buttons, accent badges, the batch-selected card) -->
    <Color x:Key="SepAccentSoftColor">#330A84FF</Color>
    <!-- systemBlue itself, for what carries no text: focus rings, switches, selection rings, progress -->
    <Color x:Key="SepAccentSoftHoverColor">#4D0A84FF</Color>
    <Color x:Key="SepTintColor">#0A84FF</Color>
    <Color x:Key="SepOnAccentColor">#FFFFFF</Color>

    <!-- switch track when off -->
    <Color x:Key="SepSwitchOffColor">#52787880</Color>

    <!-- ── Tones: text/glyph colour + soft tint ───────────────────────────────────────────────────── -->
    <Color x:Key="SepSuccessColor">#30D158</Color>
    <Color x:Key="SepSuccessSoftColor">#2930D158</Color>
    <Color x:Key="SepWarningColor">#FF9F0A</Color>
    <Color x:Key="SepWarningSoftColor">#29FF9F0A</Color>
    <Color x:Key="SepDangerColor">#FF6961</Color>
    <Color x:Key="SepDangerSoftColor">#29FF453A</Color>
    <!-- white-text fill of destructive buttons: 4.7:1 -->
    <Color x:Key="SepDangerFillColor">#E0281E</Color>
    <Color x:Key="SepInfoColor">#64D2FF</Color>
    <Color x:Key="SepInfoSoftColor">#2964D2FF</Color>
    <!-- presence (who is online) -->
    <Color x:Key="SepPurpleColor">#DA8FFF</Color>
    <Color x:Key="SepPurpleSoftColor">#29BF5AF2</Color>

    <!-- ── Shadows: none in dark mode (depth = lighter surfaces) ──────────────────────────────────── -->
    <Color x:Key="SepShadowColor">#00000000</Color>
    <Color x:Key="SepShadowHoverColor">#00000000</Color>

    <SolidColorBrush x:Key="SepWindowBrush" Color="{StaticResource SepWindowColor}" />
    <SolidColorBrush x:Key="SepPageBrush" Color="{StaticResource SepPageColor}" />
    <SolidColorBrush x:Key="SepSurfaceBrush" Color="{StaticResource SepSurfaceColor}" />
    <SolidColorBrush x:Key="SepSurface2Brush" Color="{StaticResource SepSurface2Color}" />
    <SolidColorBrush x:Key="SepSurfaceHoverBrush" Color="{StaticResource SepSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SepSurfacePressedBrush" Color="{StaticResource SepSurfacePressedColor}" />
    <SolidColorBrush x:Key="SepFillBrush" Color="{StaticResource SepFillColor}" />
    <SolidColorBrush x:Key="SepFillHoverBrush" Color="{StaticResource SepFillHoverColor}" />
    <SolidColorBrush x:Key="SepFillPressedBrush" Color="{StaticResource SepFillPressedColor}" />
    <SolidColorBrush x:Key="SepTrackBrush" Color="{StaticResource SepTrackColor}" />
    <SolidColorBrush x:Key="SepSegmentBrush" Color="{StaticResource SepSegmentColor}" />
    <SolidColorBrush x:Key="SepTrayBrush" Color="{StaticResource SepTrayColor}" />
    <SolidColorBrush x:Key="SepInputBrush" Color="{StaticResource SepInputColor}" />
    <SolidColorBrush x:Key="SepSheetBrush" Color="{StaticResource SepSheetColor}" />
    <SolidColorBrush x:Key="SepSheetGroupBrush" Color="{StaticResource SepSheetGroupColor}" />
    <SolidColorBrush x:Key="SepPopupBrush" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="SepPopupBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="SepSidebarBrush" Color="{StaticResource SepSidebarColor}" />
    <SolidColorBrush x:Key="SepSidebarBorderBrush" Color="{StaticResource SepSidebarBorderColor}" />
    <SolidColorBrush x:Key="SepSidebarHoverBrush" Color="{StaticResource SepSidebarHoverColor}" />
    <SolidColorBrush x:Key="SepSidebarSelectedInactiveBrush" Color="{StaticResource SepSidebarSelectedInactiveColor}" />
    <SolidColorBrush x:Key="SepSidebarCardBrush" Color="{StaticResource SepSidebarCardColor}" />
    <SolidColorBrush x:Key="SepSearchFieldBrush" Color="{StaticResource SepSearchFieldColor}" />
    <SolidColorBrush x:Key="SepContentEdgeBrush" Color="{StaticResource SepContentEdgeColor}" />
    <SolidColorBrush x:Key="SepSeparatorBrush" Color="{StaticResource SepSeparatorColor}" />
    <SolidColorBrush x:Key="SepDividerBrush" Color="{StaticResource SepDividerColor}" />
    <SolidColorBrush x:Key="SepBorderBrush" Color="{StaticResource SepBorderColor}" />
    <SolidColorBrush x:Key="SepBorderStrongBrush" Color="{StaticResource SepBorderStrongColor}" />
    <SolidColorBrush x:Key="SepTextBrush" Color="{StaticResource SepTextColor}" />
    <SolidColorBrush x:Key="SepText2Brush" Color="{StaticResource SepText2Color}" />
    <SolidColorBrush x:Key="SepText3Brush" Color="{StaticResource SepText3Color}" />
    <SolidColorBrush x:Key="SepAccentBrush" Color="{StaticResource SepAccentColor}" />
    <SolidColorBrush x:Key="SepAccentStrongBrush" Color="{StaticResource SepAccentStrongColor}" />
    <SolidColorBrush x:Key="SepAccentHoverBrush" Color="{StaticResource SepAccentHoverColor}" />
    <SolidColorBrush x:Key="SepAccentPressedBrush" Color="{StaticResource SepAccentPressedColor}" />
    <SolidColorBrush x:Key="SepAccentSoftBrush" Color="{StaticResource SepAccentSoftColor}" />
    <SolidColorBrush x:Key="SepAccentSoftHoverBrush" Color="{StaticResource SepAccentSoftHoverColor}" />
    <SolidColorBrush x:Key="SepTintBrush" Color="{StaticResource SepTintColor}" />
    <SolidColorBrush x:Key="SepSwitchOffBrush" Color="{StaticResource SepSwitchOffColor}" />
    <SolidColorBrush x:Key="SepOnAccentBrush" Color="{StaticResource SepOnAccentColor}" />
    <SolidColorBrush x:Key="SepSuccessBrush" Color="{StaticResource SepSuccessColor}" />
    <SolidColorBrush x:Key="SepSuccessSoftBrush" Color="{StaticResource SepSuccessSoftColor}" />
    <SolidColorBrush x:Key="SepWarningBrush" Color="{StaticResource SepWarningColor}" />
    <SolidColorBrush x:Key="SepWarningSoftBrush" Color="{StaticResource SepWarningSoftColor}" />
    <SolidColorBrush x:Key="SepDangerBrush" Color="{StaticResource SepDangerColor}" />
    <SolidColorBrush x:Key="SepDangerSoftBrush" Color="{StaticResource SepDangerSoftColor}" />
    <SolidColorBrush x:Key="SepDangerFillBrush" Color="{StaticResource SepDangerFillColor}" />
    <SolidColorBrush x:Key="SepInfoBrush" Color="{StaticResource SepInfoColor}" />
    <SolidColorBrush x:Key="SepInfoSoftBrush" Color="{StaticResource SepInfoSoftColor}" />
    <SolidColorBrush x:Key="SepPurpleBrush" Color="{StaticResource SepPurpleColor}" />
    <SolidColorBrush x:Key="SepPurpleSoftBrush" Color="{StaticResource SepPurpleSoftColor}" />

    <!-- Card edge: a faint lit rim, brighter along the top (the dark-mode stand-in for a shadow) -->
    <LinearGradientBrush x:Key="SepCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.4" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- The overview hero: the card colour with a breath of blue in the far corner -->
    <LinearGradientBrush x:Key="SepHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C1C1E" Offset="0" />
        <GradientStop Color="#1C1C1E" Offset="0.55" />
        <GradientStop Color="#16243A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SepHeroBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.5" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 1 px specular highlight along the top edge of the glass sidebar and the session card -->
    <LinearGradientBrush x:Key="SepSpecularBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#59FFFFFF" Offset="0.35" />
        <GradientStop Color="#59FFFFFF" Offset="0.65" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Icon tiles (sidebar, settings rows, widgets): Apple system colours with the faint top light of an app icon.
         The glyph on top is always white. -->
    <LinearGradientBrush x:Key="SepTileBlueBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A9BFF" Offset="0" /><GradientStop Color="#0A84FF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileIndigoBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#7E7CEC" Offset="0" /><GradientStop Color="#5E5CE6" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTilePurpleBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CC7BF5" Offset="0" /><GradientStop Color="#BF5AF2" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTilePinkBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5F7F" Offset="0" /><GradientStop Color="#FF375F" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileRedBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF6B62" Offset="0" /><GradientStop Color="#FF453A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileOrangeBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFB13D" Offset="0" /><GradientStop Color="#FF9F0A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileYellowBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFDE3D" Offset="0" /><GradientStop Color="#FFD60A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileGreenBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#56DA79" Offset="0" /><GradientStop Color="#30D158" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileTealBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#63D3E7" Offset="0" /><GradientStop Color="#40C8E0" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileCyanBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#83DBFF" Offset="0" /><GradientStop Color="#64D2FF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="SepTileGrayBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A3A3A8" Offset="0" /><GradientStop Color="#8E8E93" Offset="1" /></LinearGradientBrush>

    <!-- ── WPF-UI controls take the same look (resolved after WPF-UI's own dictionaries) ───────────────── -->
    <!-- Primary: solid accent fill, white text, no elevation stroke -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource SepAccentStrongColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource SepAccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource SepAccentPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />
    <!-- Secondary: a borderless grey fill (white at 10 %) -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource SepFillColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource SepFillHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SepFillPressedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent" />
    <!-- destructive fill (ui:Button Appearance="Danger"; also the title-bar close hover) -->
    <Color x:Key="PaletteRedColor">#E0281E</Color>
    <!-- text fields: translucent well with a hairline; systemBlue when focused -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SepInputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource SepBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource SepTintColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource SepText3Color}" />
    <!-- pop-up buttons (combo boxes) look like secondary buttons; the menu is a rounded popover -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SepFillColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SepFillHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource SepFillColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource SepTintColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource SepText2Color}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource SepTintColor}" />
    <!-- check boxes: systemBlue square, white tick -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource SepTintColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#2B94FF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0A74E0" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFF" />
    <!-- menus, flyouts, tooltips -->
    <SolidColorBrush x:Key="ContextMenuBackground" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
    <!-- toasts (the template lives in SepStyles.xaml) -->
    <SolidColorBrush x:Key="SnackBarBackground" Color="{StaticResource SepPopupColor}" />
    <SolidColorBrush x:Key="SnackBarBorderBrush" Color="{StaticResource SepPopupBorderColor}" />
    <SolidColorBrush x:Key="SnackBarForeground" Color="#FFFFFF" />
</ResourceDictionary>
