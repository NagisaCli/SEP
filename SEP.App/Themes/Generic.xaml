<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:SEP.App.Controls">
    <!-- Default looks of the SEP controls. This file is merged into App.xaml and is also the theme dictionary
         (themes/generic.xaml), so it must only use DynamicResource for anything defined elsewhere. -->

    <!-- ── Badge: soft tint + strong text per tone; IsSolid fills with the strong colour; HasDot adds the status dot. -->
    <Style TargetType="{x:Type controls:Badge}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Badge}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="999" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"
                                     Fill="{TemplateBinding DotBrush}" />
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="DotBrush" Value="{x:Null}">
                            <Setter TargetName="Dot" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource SepAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource SepSuccessSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource SepWarningSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepWarningBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource SepDangerSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Info">
                <Setter Property="Background" Value="{DynamicResource SepInfoSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepInfoBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Purple">
                <Setter Property="Background" Value="{DynamicResource SepPurpleSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepPurpleBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Tone" Value="Accent" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SepAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepOnAccentBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Tone" Value="Success" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SepSuccessBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepOnAccentBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Tone" Value="Warning" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SepWarningBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepOnAccentBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSolid" Value="True" />
                    <Condition Property="Tone" Value="Danger" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SepDangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepOnAccentBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── IconTile: soft tone tint + symbol in the tone colour. FontSize is the symbol size. -->
    <Style TargetType="{x:Type controls:IconTile}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SepAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SepAccentBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IconTile}">
                    <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ui:SymbolIcon Symbol="{TemplateBinding Symbol}" Filled="{TemplateBinding Filled}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Size" Value="Small">
                            <Setter TargetName="Tile" Property="CornerRadius" Value="8" />
                        </Trigger>
                        <Trigger Property="Size" Value="Large">
                            <Setter TargetName="Tile" Property="CornerRadius" Value="16" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Small">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontSize" Value="15" />
            </Trigger>
            <Trigger Property="Size" Value="Large">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="FontSize" Value="28" />
            </Trigger>
            <Trigger Property="Tone" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource SepSurface2Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepText2Brush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource SepSuccessSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepSuccessBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource SepWarningSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepWarningBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource SepDangerSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepDangerBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Info">
                <Setter Property="Background" Value="{DynamicResource SepInfoSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepInfoBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Purple">
                <Setter Property="Background" Value="{DynamicResource SepPurpleSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SepPurpleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── SectionHeader: [tile] Title / caption ................ [content] -->
    <Style TargetType="{x:Type controls:SectionHeader}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconTile x:Name="Tile" Size="Small" Symbol="{TemplateBinding Symbol}" Tone="{TemplateBinding Tone}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontFamily="{DynamicResource SepTextFont}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SepTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}" FontFamily="{DynamicResource SepTextFont}" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource SepText3Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Symbol" Value="Empty">
                            <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="TitleText" Property="FontSize" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── EmptyState: centred tile, title, hint, call to action -->
    <Style TargetType="{x:Type controls:EmptyState}">
        <Setter Property="Padding" Value="32,32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyState}">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                        <controls:IconTile x:Name="Tile" Size="Large" Symbol="{TemplateBinding Symbol}" Tone="{TemplateBinding Tone}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0,0,14" />
                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontFamily="{DynamicResource SepTextFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SepTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontFamily="{DynamicResource SepTextFont}" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SepText2Brush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <ContentPresenter x:Name="Action" Margin="0,18,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="Tile" Property="Size" Value="Medium" />
                            <Setter TargetName="Tile" Property="Margin" Value="0,0,0,10" />
                            <Setter TargetName="TitleText" Property="FontSize" Value="14" />
                            <Setter TargetName="DescriptionText" Property="FontSize" Value="12" />
                            <Setter TargetName="DescriptionText" Property="Margin" Value="0,3,0,0" />
                            <Setter TargetName="Action" Property="Margin" Value="0,12,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsCompact" Value="True">
                <Setter Property="Padding" Value="8,12" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── SettingCard: [tile] Header / description ................ [control] -->
    <Style TargetType="{x:Type controls:SettingCard}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Foreground" Value="{DynamicResource SepTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SepCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingCard}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconTile x:Name="Tile" Symbol="{TemplateBinding Symbol}" Tone="{TemplateBinding Tone}" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}" FontFamily="{DynamicResource SepTextFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SepTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontFamily="{DynamicResource SepTextFont}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SepText2Brush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Symbol" Value="Empty">
                            <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
